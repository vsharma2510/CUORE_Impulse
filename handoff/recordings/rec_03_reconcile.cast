[145.690373, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;77m\u001b[48;5;22m7\u001b[11G\u001b[38;5;81mdef\u001b[38;5;231m \u001b[38;5;148mjump\u001b[38;5;231m(\u001b[38;5;208mx, i\u001b[38;5;231m):         \r\u001b[7C\u001b[1B\u001b[38;5;77m8\u001b[11G\u001b[38;5;231m    \u001b[38;5;197mreturn\u001b[38;5;231m x[i + \u001b[38;5;141m1\u001b[38;5;231m] / x[i]                                                                             \r\u001b[7C\u001b[1B\u001b[38;5;77m9\u001b[11G\u001b[38;5;231m      \u001b[18G \u001b[20G   \u001b[24G \u001b[26G     \r\u001b[6C\u001b[1B\u001b[38;5;77m30\r\u001b[6C\u001b[1B31\u001b[11G\u001b[38;5;197mfor\u001b[38;5;231m fb \u001b[38;5;197min\u001b[38;5;231m (\u001b[38;5;141m5.4\u001b[38;5;231m, \u001b[38;5;141m7.4\u001b[38;5;231m):                                                                                  \r\u001b[6C\u001b[1B\u001b[38;5;77m32\u001b[11G\u001b[38;5;231m    i = \u001b[38;5;148mint\u001b[38;5;231m(np.argmin(np.\u001b[38;5;148mabs\u001b[38;5;231m(f\u001b[42G-\u001b[44Gfb)))\r\u001b[6C\u001b[1B\u001b[38;5;77m33\u001b[15G\u001b[38;5;148mprint\u001b[38;5;231m(\u001b[38;5;186mf\"\\n=== boundary \u001b[38;5;231m{f[i]:\u001b[38;5;141m.2\u001b[38;5;231mf}\u001b[38;5;186m -> \u001b[38;5;231m{f[i+\u001b[38;5;141m1\u001b[38;5;231m]:\u001b[38;5;141m.2\u001b[38;5;231mf}\u001b[38;5;186m Hz  (steps \u001b[38;5;231m{i}\u001b[38;5;186m -> \u001b[38;5;231m{i+\u001b[38;5;141m1\u001b[38;5;231m}\u001b[38;5;186m)\"\u001b[38;5;231m)\r\u001b[6C\u001b[1B\u001b[38;5;77m34\u001b[15G\u001b[38;5;148mprint\u001b[38;5;231m(\u001b[38;5;186mf\"  ch1111 force tone        \u001b[38;5;231m{force[i]:\u001b[38;5;141m9.2\u001b[38;5;231mf}\u001b[38;5;186m -> \u001b[38;5;231m{force[i+\u001b[38;5;141m1\u001b[38;5;231m]:\u001b[38;5;141m9.2\u001b[38;5;231mf}\u001b[38;5;186m mV   x\u001b[38;5;231m{jump(force,i):\u001b[38;5;141m.3\u001b[38;5;231mf}\u001b[38;5;186m\"\u001b[38;5;231m)\r\u001b[7C\u001b[1B\u001b[38;5;77m5\u001b[15G\u001b[38;5;148mprint\u001b[38;5;231m(\u001b[38;5;186mf\"  ch1112 shaker accel      \u001b[38;5;231m{a1112[i]:\u001b[38;5;141m9.2\u001b[38;5;231mf}\u001b[38;5;186m -> \u001b[38;5;231m{a1112[i+\u001b[38;5;141m1\u001b[38;5;231m]:\u001b[38;5;141m9.2\u001b[38;5;231mf}\u001b[38;5;186m mV   x\u001b[38;5;231m{jump(a1112,i):\u001b[38;5;141m.3\u001b[38;5;231mf}\u001b[38;5;186m\"\u001b[38;5;231m)\r\u001b[7C\u001b[1B\u001b[38;5;77m6\u001b[11G\u001b[38;5;231m    \u001b[38;5;148mprint\u001b[38;5;231m(\u001b[38;5;186mf\"  bolometer median tone    \u001b[38;5;231m{med[i]:\u001b[38;5;141m9.4\u001b[38;5;231mf}\u001b[38;5;186m -> \u001b[38;5;231m{med[i+\u001b[38;5;141m1\u001b[38;5;231m]:\u001b[38;5;141m9.4\u001b[38;5;231mf}\u001b[38;5;186m mV   x\u001b[38;5;231m{jump(med,i):\u001b[38;5;141m.3\u001b[38;5;231mf}\u001b[38;5;186m\"\u001b[38;5;231m)\r\u001b[7C\u001b[1B\u001b[38;5;77m7\u001b[15G\u001b[38;5;148mprint\u001b[38;5;231m(\u001b[38;5;186mf\"  |H| ref ch1111                                            x\u001b[38;5;231m{jump(H_1111,i):\u001b[38;5;141m.3\u001b[38;5;231mf}\u001b[38;5;186m\"\u001b[38;5;231m)\r\u001b[7C\u001b[1B\u001b[38;5;77m8\u001b[23G\u001b[38;5;186m  |H|\u001b[29Gref ch1112  (independent)          \u001b[65G  \u001b[69G      \u001b[76G   \u001b[80G  \u001b[83Gx\u001b[38;5;231m{jump(H_1112,i):\u001b[38;5;141m.3\u001b[38;5;231mf}\u001b[38;5;186m\"\u001b[38;5;231m)\r\u001b[7C\u001b[1B\u001b[38;5;77m9\u001b[15G\u001b[38;5;231m                                                                                                   \r\u001b[6C\u001b[1B\u001b[38;5;77m40\u001b[11G\u001b[38;5;242m# how unusual is each jump against the ordinary step-to-step scatter of the same quantity?\u001b[38;5;231m             \r\u001b[5C\u001b[1B\u001b[49m\u001b[38;5;246m\u2026 13 more lines \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Allowed by auto mode\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mBoth drive monitors jump at 7.45 Hz in opposite directions \u2014 that needs a gain-vs-physics discriminator:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m\u25cf\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\r\u001b[4C\u001b[1B\u001b[38;5;246m $ cat >\u001b[14Greconcile/r4b_gain.py <<'EOF'\r\u001b[5C\u001b[1B#!/usr/bin/env python3\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;246m\"\"\"R4b: discriminate a DAQ range change from a physical drive-point impedance change.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;246mAt 5.45 Hz the force channel jumps x1.735 while the accelerometer is flat; at 7.45 Hz force falls\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;246mx0.672 while the accelerometer rises x3.18. Either cou\u2026\r\u001b[12C\u001b[2BChecking\u001b[22Gfilesystem traversal scope\u2026 \u00b7 2m 43s \u00b7 \u2193\u001b[63G10.5k tokens)\u001b[39m\u001b[33;1H\u001b[31;3H\u001b[?25h"]
[145.801464, "o", "\u001b[?25l\u001b[H\r\u001b[12C\u001b[26B\u001b[38;5;246m2m 43s \u00b7\u001b[22G\u2193\u001b[39m \u001b[38;5;246m10.5k tokens)\u001b[39m\u001b[K\u001b[33;1H\u001b[31;3H\u001b[?25h"]
