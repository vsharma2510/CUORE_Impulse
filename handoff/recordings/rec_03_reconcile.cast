[148.382612, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;5;77m\u001b[48;5;22m18\u001b[11G\u001b[38;5;231mA = np.load(\u001b[38;5;186m\"analysis/responses.npz\"\u001b[38;5;231m,\u001b[49Gallow_pickle=\u001b[38;5;141mTrue\u001b[38;5;231m)\r\u001b[6C\u001b[1B\u001b[38;5;77m19\u001b[11G\u001b[38;5;231mf\u001b[13G=\u001b[15GA[\u001b[38;5;186m\"f_drive_hz\"\u001b[31G\u001b[38;5;231m \u001b[33G    \r\u001b[7C\u001b[1B\u001b[38;5;77m0\u001b[11G\u001b[38;5;231mt0,\u001b[15Gt1\u001b[18G=\u001b[20GA[\u001b[38;5;186m\"t_start_run_s\"\u001b[38;5;231m], A[\u001b[38;5;186m\"t_end_run_s\"\u001b[38;5;231m]                                                          \r\u001b[6C\u001b[1B\u001b[38;5;77m21\r\u001b[6C\u001b[1B22\u001b[11G\u001b[38;5;231mout = {}                                                                                               \r\u001b[6C\u001b[1B\u001b[38;5;77m23\u001b[11G\u001b[38;5;197mfor\u001b[38;5;231m ch \u001b[38;5;197min\u001b[38;5;231m (\u001b[38;5;141m1111\u001b[38;5;231m, \u001b[38;5;141m1112\u001b[38;5;231m):       \u001b[42G \u001b[44G     \r\u001b[6C\u001b[1B\u001b[38;5;77m24\u001b[15G\u001b[38;5;231mx = np.load(\u001b[38;5;186mf\"data/\u001b[36Grays/excitation/aux/ch\u001b[38;5;231m{ch:04d}\u001b[38;5;186m.npy\"\u001b[38;5;231m, mmap_mode=\u001b[38;5;186m\"r\"\u001b[38;5;231m)    \r\u001b[6C\u001b[1B\u001b[38;5;77m25\u001b[15G\u001b[38;5;231mtone = np.empty(\u001b[38;5;148mlen\u001b[38;5;231m(f)); wide = np.empty(\u001b[38;5;148mlen\u001b[38;5;231m(f))                                                   \r\u001b[6C\u001b[1B\u001b[38;5;77m26\u001b[15G\u001b[38;5;197mfor\u001b[38;5;231m k \u001b[38;5;197min\u001b[38;5;231m \u001b[38;5;148mrange\u001b[38;5;231m(\u001b[38;5;148mlen\u001b[38;5;231m(f)):                                                                            \r\u001b[6C\u001b[1B\u001b[38;5;77m27\u001b[15G\u001b[38;5;231m    a = \u001b[38;5;148mint\u001b[38;5;231m((t0[k] - OFF) * FS); b = \u001b[38;5;148mint\u001b[38;5;231m((t1[k] - OFF) * FS)                                 \r\u001b[6C\u001b[1B\u001b[38;5;77m28\u001b[15G\u001b[38;5;231m    seg = np.asarray(x[a:b], dtype=np.float64)                                                     \r\u001b[6C\u001b[1B\u001b[38;5;77m29\u001b[15G\u001b[38;5;231m    seg = seg[:\u001b[38;5;148mint\u001b[38;5;231m(\u001b[38;5;148mlen\u001b[38;5;231m(seg) // FS) * \u001b[38;5;148mint\u001b[38;5;231m(FS)]          \u001b[38;5;242m# whole seconds -> 1 Hz bin spacing\u001b[38;5;231m \r\u001b[7C\u001b[1B\u001b[38;5;77m0\u001b[19G\u001b[38;5;231mseg\u001b[23G-=\u001b[26Gseg.mean()\r\u001b[6C\u001b[1B\u001b[38;5;77m31\u001b[11G\u001b[38;5;231m        X = rfft(seg) / \u001b[38;5;148mlen\u001b[38;5;231m(seg)                                                          \r\u001b[5C\u001b[1B\u001b[38;5;77m 32 +\u001b[38;5;231m        fr = rfftfreq(\u001b[38;5;148mlen\u001b[38;5;231m(seg), \u001b[38;5;141m1\u001b[38;5;231m / FS)                                                                \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;5;77m\u001b[48;5;22m 33 +\u001b[38;5;231m        \u001b[38;5;242m# tone RMS in a +-0.05 Hz band around the drive and its 2nd/3rd harmonics\u001b[38;5;231m                      \r\u001b[5C\u001b[1B\u001b[38;5;77m 34 +\u001b[38;5;231m        m = np.zeros_like(fr, dtype=\u001b[38;5;148mbool\u001b[38;5;231m)                                                              \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;77m\u001b[48;5;22m 35 +\u001b[38;5;231m        \u001b[38;5;197mfor\u001b[38;5;231m h \u001b[38;5;197min\u001b[38;5;231m (\u001b[38;5;141m1\u001b[38;5;231m, \u001b[38;5;141m2\u001b[38;5;231m, \u001b[38;5;141m3\u001b[38;5;231m):                                                                            \r\u001b[5C\u001b[1B\u001b[38;5;77m 36 +\u001b[38;5;231m            m |= np.\u001b[38;5;148mabs\u001b[38;5;231m(fr - h * f[k]) < \u001b[38;5;141m0.05\u001b[38;5;231m                                                          \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;77m\u001b[48;5;22m 37 +\u001b[38;5;231m        p = \u001b[38;5;141m2\u001b[38;5;231m * np.\u001b[38;5;148mabs\u001b[38;5;231m(X) ** \u001b[38;5;141m2\u001b[38;5;231m                                                                         \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;5;77m\u001b[48;5;22m 38 +\u001b[38;5;231m        band = (fr > \u001b[38;5;141m0.5\u001b[38;5;231m) & (fr < \u001b[38;5;141m100.0\u001b[38;5;231m)                                                               \r\u001b[5C\u001b[1B\u001b[38;5;77m 39 +\u001b[38;5;231m        tone[k] = np.sqrt(p[m & band].\u001b[38;5;148msum\u001b[38;5;231m())                                                           \r\u001b[5C\u001b[1B\u001b[38;5;77m 40 +\u001b[38;5;231m        wide[k] = np.sqrt(p[~m & band].\u001b[38;5;148msum\u001b[38;5;231m())                                                          \r\u001b[5C\u001b[1B\u001b[49m\u001b[38;5;246m\u2026 22 more lin\u001b[20Gs \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Allowed by au\u001b[20Go mode\u001b[39m\u001b[K\u001b[33;1H\u001b[31;3H\u001b[?25h"]
[148.421918, "o", "\u001b[?25l\u001b[H\r\u001b[26B\u001b[38;5;174m\u273b\u001b[3GHerding\u2026\u001b[39m\u001b[33;1H\u001b[31;3H\u001b[?25h"]
[149.384042, "o", "\u001b[?25l\u001b[H\r\u001b[26B\u001b[38;5;174m\u2722\u001b[3G\u001b[38;5;216mH\u001b[17G\u001b[38;5;246m6\u001b[39m\u001b[33;1H\u001b[31;3H\u001b[?25h"]
