[78.686732, "o", "\u001b[?25l\u001b[H\u001b[3G   \u001b[38;5;231m\u001b[2m 49 \u001b[22m     other = na \u001b[38;5;197mif\u001b[38;5;231m who == \u001b[38;5;186m\"V\"\u001b[38;5;231m \u001b[38;5;197melse\u001b[38;5;231m nv\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;167m\u001b[48;5;52m 50 -\u001b[38;5;231m    verdict = (\"present in the other node's own |H|\" if other >= 11 else                               \r\u001b[5C\u001b[1B\u001b[38;5;167m 51 -\u001b[38;5;231m               \"weak/absent in the other node's own |H|\")                                              \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;5;167m\u001b[48;5;52m 52 -\u001b[38;5;231m    print(f\"{f0:8.4f} {who:>3s} {g:7.3f}  {na:9d} {nv:9d}   {verdict}\")                                \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;77m\u001b[48;5;22m 50 +\u001b[38;5;231m    \u001b[38;5;197mif\u001b[38;5;231m other \u001b[38;5;197mis\u001b[38;5;231m \u001b[38;5;141mNone\u001b[38;5;231m:                                                                                  \r\u001b[5C\u001b[1B\u001b[38;5;77m 51 +\u001b[38;5;231m        verdict = \u001b[38;5;186m\"AT THE BAND EDGE: no local maximum is definable at 2.50 Hz\"\u001b[38;5;231m                         \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;77m\u001b[48;5;22m 52 +\u001b[38;5;231m    \u001b[38;5;197melif\u001b[38;5;231m other >= \u001b[38;5;141m11\u001b[38;5;231m:                                                                                  \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;5;77m\u001b[48;5;22m 53 +\u001b[38;5;231m        verdict = \u001b[38;5;186m\"present in the other node's own |H|\"\u001b[38;5;231m                                                \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;5;77m\u001b[48;5;22m 54 +\u001b[38;5;231m    \u001b[38;5;197melse\u001b[38;5;231m:                                                                                              \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;5;77m\u001b[48;5;22m 55 +\u001b[38;5;231m        verdict = \u001b[38;5;186m\"weak/absent in the other node's own |H|\"\u001b[38;5;231m                                            \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;5;77m\u001b[48;5;22m 56 +\u001b[38;5;231m    sa = \u001b[38;5;186m\"edge\"\u001b[38;5;231m \u001b[38;5;197mif\u001b[38;5;231m na \u001b[38;5;197mis\u001b[38;5;231m \u001b[38;5;141mNone\u001b[38;5;231m \u001b[38;5;197melse\u001b[38;5;231m \u001b[38;5;186mf\"\u001b[38;5;231m{na:d}\u001b[38;5;186m\"\u001b[38;5;231m                                                           \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;5;77m\u001b[48;5;22m 57 +\u001b[38;5;231m    sv = \u001b[38;5;186m\"edge\"\u001b[38;5;231m \u001b[38;5;197mif\u001b[38;5;231m nv \u001b[38;5;197mis\u001b[38;5;231m \u001b[38;5;141mNone\u001b[38;5;231m \u001b[38;5;197melse\u001b[38;5;231m \u001b[38;5;186mf\"\u001b[38;5;231m{nv:d}\u001b[38;5;186m\"\u001b[38;5;231m                                                           \r\u001b[5C\u001b[1B\u001b[38;5;77m 58 +\u001b[38;5;231m    \u001b[38;5;148mprint\u001b[38;5;231m(\u001b[38;5;186mf\"\u001b[38;5;231m{f0:\u001b[38;5;141m8.4\u001b[38;5;231mf}\u001b[38;5;186m \u001b[38;5;231m{who:>3s}\u001b[38;5;186m \u001b[38;5;231m{g:\u001b[38;5;141m7.3\u001b[38;5;231mf}\u001b[38;5;186m  \u001b[38;5;231m{sa:>9s}\u001b[38;5;186m \u001b[38;5;231m{sv:>9s}\u001b[38;5;186m   \u001b[38;5;231m{verdict}\u001b[38;5;186m\"\u001b[38;5;231m)                              \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;231m\u001b[2m 59 \u001b[22m     rows.append((f0, who, g, na, nv))\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 60 \u001b[22m \r\u001b[1B\u001b[39m     \u001b[38;5;231m\u001b[2m 61 \u001b[22m \u001b[38;5;148mprint\u001b[38;5;231m(\u001b[38;5;186m\"\\nreference: the same count for the 9 modes both nodes agree on\"\u001b[38;5;231m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 62 \u001b[22m \u001b[38;5;197mfor\u001b[38;5;231m f0 \u001b[38;5;197min\u001b[38;5;231m (\u001b[38;5;141m3.021\u001b[38;5;231m, \u001b[38;5;141m3.420\u001b[38;5;231m, \u001b[38;5;141m3.962\u001b[38;5;231m, \u001b[38;5;141m4.886\u001b[38;5;231m, \u001b[38;5;141m5.349\u001b[38;5;231m, \u001b[38;5;141m7.464\u001b[38;5;231m, \u001b[38;5;141m8.099\u001b[38;5;231m, \u001b[38;5;141m8.172\u001b[38;5;231m, \u001b[38;5;141m8.794\u001b[38;5;231m):\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m 63 \u001b[22m     na, g = peak_count(Ha, Sa, f0)\r\u001b[1B\u001b[39m     \u001b[38;5;231m\u001b[2m 64 \u001b[22m     nv, _ = peak_count(Hv, Sv, f0)\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 59 -\u001b[38;5;231m    print(f\"{f0:8.4f} {'AV':>3s} {g:7.3f}  {na:9d} {nv:9d}\")                                           \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 65 +\u001b[38;5;231m    \u001b[38;5;148mprint\u001b[38;5;231m(\u001b[38;5;186mf\"\u001b[38;5;231m{f0:\u001b[38;5;141m8.4\u001b[38;5;231mf}\u001b[38;5;186m \u001b[38;5;231m{\u001b[38;5;186m'AV'\u001b[38;5;231m:>3s}\u001b[38;5;186m \u001b[38;5;231m{g:\u001b[38;5;141m7.3\u001b[38;5;231mf}\u001b[38;5;186m  \u001b[38;5;231m{na:9d}\u001b[38;5;186m \u001b[38;5;231m{nv:9d}\u001b[38;5;186m\"\u001b[38;5;231m)\u001b[48;5;28m  \u001b[38;5;242m# all nine are interior points\u001b[38;5;231m\u001b[48;5;22m           \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 66 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 67 \u001b[22m med_a, med_v = np.median(Ha, \u001b[38;5;141m0\u001b[38;5;231m), np.median(Hv, \u001b[38;5;141m0\u001b[38;5;231m)\r\u001b[5C\u001b[1B\u001b[2m 68 \u001b[22m \u001b[38;5;148mprint\u001b[38;5;231m(\u001b[38;5;186m\"\\nmedian |H| around each unmatched mode (A then V, normalised to the mode's own value)\"\u001b[38;5;231m)\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Allowed by auto mode\r\u001b[16C\u001b[2B6\u001b[39m\u001b[33;1H\u001b[31;3H\u001b[?25h"]
