[295.71599, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;77m\u001b[48;5;22m5\u001b[11G\u001b[38;5;231m \u001b[13G \u001b[15G                                                                                                   \r\u001b[7C\u001b[1B\u001b[38;5;77m6\u001b[11G\u001b[38;5;81mdef\u001b[38;5;231m \u001b[38;5;148mstack\u001b[38;5;231m(\u001b[38;5;208mlabel, a, b, times\u001b[38;5;231m):                                                                         \r\u001b[7C\u001b[1B\u001b[38;5;77m7\u001b[11G\u001b[38;5;231m   \u001b[15Gacc =\u001b[21Gnp.zeros(n); nch = \u001b[38;5;141m0\u001b[38;5;231m   \u001b[45G \u001b[47G   \u001b[51G  \u001b[54G    \u001b[59G \u001b[61G  \u001b[64G  \u001b[67G     \r\u001b[7C\u001b[1B\u001b[38;5;77m8\u001b[11G\u001b[38;5;231m \u001b[13G \u001b[15G\u001b[38;5;197mfor\u001b[38;5;231m name \u001b[38;5;197min\u001b[38;5;231m BOLO:\u001b[70G                      \r\u001b[7C\u001b[1B\u001b[38;5;77m9\u001b[19G\u001b[38;5;231mx\u001b[21G=\u001b[23Gnp.load(\u001b[38;5;186mf\"data/arrays/\u001b[38;5;231m{label}\u001b[38;5;186m/bolo/\u001b[38;5;231m{name}\u001b[38;5;186m.npy\"\u001b[38;5;231m, mmap_mode=\u001b[38;5;186m\"r\"\u001b[38;5;231m)                             \r\u001b[6C\u001b[1B\u001b[38;5;77m30\u001b[19G\u001b[38;5;231mst\u001b[22G=\u001b[24Gnp.zeros(n);\u001b[37Gm\u001b[39G=\u001b[41G\u001b[38;5;141m0\u001b[38;5;231m                                                                        \r\u001b[6C\u001b[1B\u001b[38;5;77m31\u001b[11G\u001b[38;5;231m        \u001b[38;5;197mfor\u001b[38;5;231m tt \u001b[38;5;197min\u001b[38;5;231m times:      \r\u001b[6C\u001b[1B\u001b[38;5;77m32\u001b[15G\u001b[38;5;231m   \u001b[19G \u001b[21G  i = \u001b[38;5;148mint\u001b[38;5;231m(\u001b[38;5;148mround\u001b[38;5;231m((tt -\u001b[43Ga\u001b[45G-\u001b[47GPRE)\u001b[52G*\u001b[54GFS))\r\u001b[6C\u001b[1B\u001b[38;5;77m33\u001b[15G\u001b[38;5;231m        \u001b[38;5;197mif\u001b[38;5;231m i < \u001b[38;5;141m0\u001b[38;5;231m \u001b[38;5;197mor\u001b[35G\u001b[38;5;231mi\u001b[37G+\u001b[39Gn\u001b[41G>\u001b[43G\u001b[38;5;148mlen\u001b[38;5;231m(x):\r\u001b[6C\u001b[1B\u001b[38;5;77m34\u001b[19G\u001b[38;5;231m \u001b[21G \u001b[23G    \u001b[38;5;197mcontinue\u001b[38;5;231m                                   \u001b[71G              \r\u001b[7C\u001b[1B\u001b[38;5;77m5\u001b[19G\u001b[38;5;231m  \u001b[22G s = np.a\u001b[32Garray(x[i:i + n], dtype=np.float64)                                               \r\u001b[7C\u001b[1B\u001b[38;5;77m6\u001b[19G\u001b[38;5;231m    c, *_ = np.linalg.lstsq(V[FIT], s[FIT], rcond=\u001b[38;5;141mNone\u001b[38;5;231m)\r\u001b[7C\u001b[1B\u001b[38;5;77m7\u001b[23G\u001b[38;5;231mst += s - V @ c                                                                            \r\u001b[7C\u001b[1B\u001b[38;5;77m8\u001b[23G\u001b[38;5;231mm += \u001b[38;5;141m1\u001b[30G\u001b[38;5;231m \u001b[32G  \u001b[35G \u001b[37G \u001b[39G \u001b[41G \u001b[43G       \r\u001b[7C\u001b[1B\u001b[38;5;77m9\u001b[19G\u001b[38;5;197mif\u001b[38;5;231m m:           \r\u001b[6C\u001b[1B\u001b[38;5;77m40\u001b[23G\u001b[38;5;231macc\u001b[27G+= st / m; nch += \u001b[38;5;141m1\u001b[38;5;231m                                                                    \r\u001b[5C\u001b[1B\u001b[49m\u001b[38;5;246m\u2026 24 more lines \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Allowed by auto mode\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m\u25cf\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf  $ cat > reconcile/r6_boundaries.py <<'EOF'\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;246m#!/usr/bin/e\u001b[19Gv python3\r\u001b[1B\u001b[39m     \u001b[38;5;246m\"\"\"R6: where is\u001b[22Gthe step boundary really, and is any heater pulse visible at all?\r\u001b[5C\u001b[1B(a) Boundaries. The nodes' step boundaries differ by a median 0.55 s and both sit ~6 s before\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;246mdata/steps.csv. Measured here from ch1111 itself: demodul\u2026\r\u001b[12C\u001b[2BChecking\u001b[22Gfilesystem traversal scope\u2026 \u00b7 5m 13s \u00b7 \u2193\u001b[63G21.3k tokens)\u001b[39m\u001b[33;1H\u001b[31;3H\u001b[?25h"]
