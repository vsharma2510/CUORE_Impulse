[343.229678, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;77m\u001b[48;5;22m 18 +\u001b[38;5;231mx = np.load(\u001b[38;5;186m\"data/arrays/excitation/aux/ch1111.npy\"\u001b[38;5;231m, mmap_mode=\u001b[38;5;186m\"r\"\u001b[38;5;231m)                                    \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;5;77m\u001b[48;5;22m 19 +\u001b[38;5;231m                                                                                                       \r\u001b[5C\u001b[1B\u001b[38;5;77m 20 +\u001b[38;5;231m                                                                                                       \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;77m\u001b[48;5;22m 21 +\u001b[38;5;81mdef\u001b[38;5;231m \u001b[38;5;148menv\u001b[38;5;231m(\u001b[38;5;208mfd, i0, i1\u001b[38;5;231m):                                                                                   \u001b[39m\u001b[49m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 22 +\u001b[38;5;231m    seg = np.asarray(x[i0:i1], dtype=np.float64); seg -= seg.mean()                                    \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;5;77m\u001b[48;5;22m 23 +\u001b[38;5;231m    tt = np.arange(i0, i1) / FS + OFF                                                                  \r\u001b[5C\u001b[1B\u001b[38;5;77m 24 +\u001b[38;5;231m    z = seg * np.exp(-\u001b[38;5;141m2j\u001b[38;5;231m * np.pi * fd * (tt - tt[\u001b[38;5;141m0\u001b[38;5;231m]))                                                  \r\u001b[5C\u001b[1B\u001b[38;5;77m 25 +\u001b[38;5;231m    nw = \u001b[38;5;148mint\u001b[38;5;231m(W * FS)                                                                                   \r\u001b[5C\u001b[1B\u001b[38;5;77m 26 +\u001b[38;5;231m    c = np.cumsum(np.r_[\u001b[38;5;141m0\u001b[38;5;231m, z])                                                                         \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;5;77m\u001b[48;5;22m 27 +\u001b[38;5;231m    \u001b[38;5;197mreturn\u001b[38;5;231m tt[nw // \u001b[38;5;141m2\u001b[38;5;231m: nw // \u001b[38;5;141m2\u001b[38;5;231m + \u001b[38;5;148mlen\u001b[38;5;231m(c) - nw - \u001b[38;5;141m1\u001b[38;5;231m], np.\u001b[38;5;148mabs\u001b[38;5;231m(c[nw:-\u001b[38;5;141m1\u001b[38;5;231m] - c[:-nw - \u001b[38;5;141m1\u001b[38;5;231m]) / nw                 \r\u001b[5C\u001b[1B\u001b[38;5;77m 28 +\u001b[38;5;231m                                                                                                       \r\u001b[5C\u001b[1B\u001b[38;5;77m 29 +\u001b[38;5;231m                                                                                                       \r\u001b[5C\u001b[1B\u001b[38;5;77m 30 +\u001b[38;5;231mmeas = []                                                                                              \r\u001b[5C\u001b[1B\u001b[38;5;77m 31 +\u001b[38;5;197mfor\u001b[38;5;231m k \u001b[38;5;197min\u001b[38;5;231m \u001b[38;5;148mrange\u001b[38;5;231m(\u001b[38;5;141m1\u001b[38;5;231m, \u001b[38;5;148mlen\u001b[38;5;231m(f)):                                                                             \r\u001b[5C\u001b[1B\u001b[38;5;77m 32 +\u001b[38;5;231m    i0, i1 = \u001b[38;5;148mint\u001b[38;5;231m((ts[k] - \u001b[38;5;141m20\u001b[38;5;231m - OFF) * FS), \u001b[38;5;148mint\u001b[38;5;231m((ts[k] + \u001b[38;5;141m20\u001b[38;5;231m - OFF) * FS)                                \r\u001b[5C\u001b[1B\u001b[38;5;77m 33 +\u001b[38;5;231m    \u001b[38;5;197mif\u001b[38;5;231m i0 < \u001b[38;5;141m0\u001b[38;5;231m \u001b[38;5;197mor\u001b[38;5;231m i1 > \u001b[38;5;148mlen\u001b[38;5;231m(x):                                                                          \r\u001b[5C\u001b[1B\u001b[38;5;77m 34 +\u001b[38;5;231m        meas.append(np.nan); \u001b[38;5;197mcontinue\u001b[38;5;231m                                                                  \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;5;77m\u001b[48;5;22m 35 +\u001b[38;5;231m    tc, e_old = env(f[k - \u001b[38;5;141m1\u001b[38;5;231m], i0, i1)                                                                  \r\u001b[5C\u001b[1B\u001b[38;5;77m 36 +\u001b[38;5;231m    _, e_new = env(f[k], i0, i1)                                                                       \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;77m\u001b[48;5;22m 37 +\u001b[38;5;231m    d = e_new - e_old                                                                                  \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;5;77m\u001b[48;5;22m 38 +\u001b[38;5;231m    s = np.where(np.diff(np.sign(d)) > \u001b[38;5;141m0\u001b[38;5;231m)[\u001b[38;5;141m0\u001b[38;5;231m]                                                           \r\u001b[5C\u001b[1B\u001b[38;5;77m 39 +\u001b[38;5;231m    meas.append(tc[s[np.argmin(np.\u001b[38;5;148mabs\u001b[38;5;231m(tc[s] - ts[k]))]] \u001b[38;5;197mif\u001b[38;5;231m \u001b[38;5;148mlen\u001b[38;5;231m(s) \u001b[38;5;197melse\u001b[38;5;231m np.nan)                         \r\u001b[5C\u001b[1B\u001b[38;5;77m 40 +\u001b[38;5;231mmeas = np.array(meas)"]
