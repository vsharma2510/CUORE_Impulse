[170.038629, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;5;77m\u001b[48;5;22m20\u001b[11G\u001b[38;5;231mt0,\u001b[15Gt1 = A[\u001b[38;5;186m\"t_start_run_\u001b[36G\"\u001b[38;5;231m], A[\u001b[38;5;186m\"t_end_run_s\"\u001b[38;5;231m]           \r\u001b[6C\u001b[1B\u001b[38;5;77m21\u001b[11G\u001b[38;5;231m \u001b[13G \u001b[15G                                                                                                   \r\u001b[7C\u001b[1B\u001b[38;5;77m2\u001b[11G\u001b[38;5;231mout\u001b[15G= {}\u001b[20G                                                                                              \r\u001b[7C\u001b[1B\u001b[38;5;77m3\u001b[11G\u001b[38;5;197mfor\u001b[38;5;231m ch \u001b[38;5;197min\u001b[38;5;231m (\u001b[38;5;141m1111\u001b[38;5;231m, \u001b[38;5;141m1112\u001b[38;5;231m):                                                                                \r\u001b[7C\u001b[1B\u001b[38;5;77m4\u001b[11G\u001b[38;5;231m   \u001b[15Gx\u001b[17G= np.load(\u001b[38;5;186mf\"data/arrays/excitation/aux/ch\u001b[38;5;231m{ch:04d}\u001b[38;5;186m.npy\"\u001b[38;5;231m, mmap_mode=\u001b[38;5;186m\"r\"\u001b[38;5;231m)                           \r\u001b[7C\u001b[1B\u001b[38;5;77m5\u001b[11G\u001b[38;5;231m    tone = np.empty(\u001b[38;5;148mlen\u001b[38;5;231m(f));\u001b[40Gwide\u001b[45G=\u001b[47Gnp.empty(\u001b[38;5;148mlen\u001b[38;5;231m(f))\r\u001b[7C\u001b[1B\u001b[38;5;77m6\u001b[15G\u001b[38;5;197mfor\u001b[38;5;231m k \u001b[38;5;197min\u001b[38;5;231m \u001b[38;5;148mrange\u001b[38;5;231m(\u001b[38;5;148mlen\u001b[38;5;231m(f)):                                  \u001b[73G              \r\u001b[7C\u001b[1B\u001b[38;5;77m7\u001b[15G\u001b[38;5;231m    a = \u001b[38;5;148mint\u001b[38;5;231m((t0[k] - OFF) * FS); b = \u001b[38;5;148mint\u001b[56G\u001b[38;5;231m(t1[k] -\u001b[65GOFF)\u001b[70G*\u001b[72GFS)\r\u001b[7C\u001b[1B\u001b[38;5;77m8\u001b[15G\u001b[38;5;231m    seg = np.asarray(x[a:b], dtype=np.float64)                                                     \r\u001b[7C\u001b[1B\u001b[38;5;77m9\u001b[19G\u001b[38;5;231mseg\u001b[23G= seg[:\u001b[38;5;148mint\u001b[38;5;231m(\u001b[38;5;148mlen\u001b[38;5;231m(seg)\u001b[43G// FS)\u001b[50G*\u001b[56GFS)]  \u001b[63G \u001b[65G    \u001b[70G\u001b[38;5;242m# whole seconds -> 1 Hz bin spacing\r\u001b[6C\u001b[1B\u001b[38;5;77m30\u001b[23G\u001b[38;5;231m-= seg.mean()       \u001b[44G                 \r\u001b[6C\u001b[1B\u001b[38;5;77m31\u001b[19G\u001b[38;5;231mX =\u001b[23Grfft(seg) / \u001b[38;5;148mlen\u001b[38;5;231m(seg)  \u001b[46G   \u001b[50G \u001b[52G        \u001b[70G                                   \r\u001b[7C\u001b[1B\u001b[38;5;77m2\u001b[19G\u001b[38;5;231mfr = rfftfreq(\u001b[38;5;148mlen\u001b[38;5;231m(seg), \u001b[38;5;141m1\u001b[38;5;231m / FS)                                                                \r\u001b[7C\u001b[1B\u001b[38;5;77m3\u001b[19G\u001b[38;5;242m# tone RMS in a +-0.05 Hz band around the drive and its 2nd/3rd harmonics\r\u001b[7C\u001b[1B\u001b[38;5;77m4\u001b[19G\u001b[38;5;231mm = np.zeros_like(fr, dtype=\u001b[38;5;148mbool\u001b[38;5;231m)\r\u001b[7C\u001b[1B\u001b[38;5;77m5\u001b[19G\u001b[38;5;197mfor\u001b[38;5;231m h \u001b[38;5;197min\u001b[38;5;231m (\u001b[38;5;141m1\u001b[38;5;231m, \u001b[38;5;141m2\u001b[38;5;231m, \u001b[38;5;141m3\u001b[38;5;231m):                                                      \r\u001b[7C\u001b[1B\u001b[38;5;77m6\u001b[19G\u001b[38;5;231m \u001b[21G \u001b[23Gm |= np.\u001b[38;5;148mabs\u001b[38;5;231m(fr - h * f[k]) < \u001b[38;5;141m0.05\r\u001b[7C\u001b[1B\u001b[38;5;77m7\u001b[19G\u001b[38;5;231mp = \u001b[38;5;141m2\u001b[25G\u001b[38;5;231m* np.\u001b[38;5;148mabs\u001b[38;5;231m(X) **\u001b[40G\u001b[38;5;141m2\r\u001b[7C\u001b[1B\u001b[38;5;77m8\u001b[19G\u001b[38;5;231mband = (fr > \u001b[38;5;141m0.5\u001b[38;5;231m) & (fr < \u001b[38;5;141m100.0\u001b[38;5;231m)\u001b[52G    \r\u001b[7C\u001b[1B\u001b[38;5;77m9\u001b[19G\u001b[38;5;231mtone[k] = np.sqrt(p[m & band].\u001b[38;5;148msum\u001b[38;5;231m())\r\u001b[6C\u001b[1B\u001b[38;5;77m40\u001b[19G\u001b[38;5;231mwide[k] = np.sqrt(p[~m & band].\u001b[38;5;148msum\u001b[38;5;231m())\r\u001b[5C\u001b[1B\u001b[49m\u001b[38;5;246m\u2026 22 more lines \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Allowed by auto mode\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[39m\u001b[K\u001b[33;1H\u001b[31;3H\u001b[?25h"]
