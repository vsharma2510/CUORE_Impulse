[188.867821, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;77m\u001b[48;5;22m7\u001b[11G\u001b[38;5;231m   \u001b[15G \u001b[17G  a\u001b[21G=\u001b[23G\u001b[38;5;148mint\u001b[38;5;231m((t0[k] - OFF) * FS); b = \u001b[38;5;148mint\u001b[38;5;231m((t1[k] - OFF) * FS)                                       \r\u001b[7C\u001b[1B\u001b[38;5;77m8\u001b[11G\u001b[38;5;231m        seg = np.asarray(x[a:b], dtype=np.float64)                                                     \r\u001b[7C\u001b[1B\u001b[38;5;77m9\u001b[15G\u001b[38;5;231m \u001b[17G \u001b[19Gseg = seg[:\u001b[38;5;148mint\u001b[38;5;231m(\u001b[38;5;148mlen\u001b[38;5;231m(seg) // FS) * \u001b[38;5;148mint\u001b[38;5;231m(FS)]          \u001b[38;5;242m# whole seconds -> 1 Hz bin spacing\r\u001b[6C\u001b[1B\u001b[38;5;77m30\u001b[15G\u001b[38;5;231m    seg -= seg.mean()                                                                              \r\u001b[6C\u001b[1B\u001b[38;5;77m31\u001b[15G\u001b[38;5;231m    X = rfft(seg) / \u001b[38;5;148mlen\u001b[38;5;231m(seg)\r\u001b[6C\u001b[1B\u001b[38;5;77m32\u001b[19G\u001b[38;5;231mfr = rfftfreq(\u001b[38;5;148mlen\u001b[38;5;231m(seg),\u001b[43G\u001b[38;5;141m1\u001b[38;5;231m / FS) \u001b[52G          \u001b[63G \u001b[65G    \u001b[70G \u001b[72G   \r\u001b[6C\u001b[1B\u001b[38;5;77m33\u001b[19G\u001b[38;5;242m# tone RMS in a +-0.05 Hz band around the drive and its 2nd/3rd harmonics\u001b[38;5;231m                      \r\u001b[6C\u001b[1B\u001b[38;5;77m34\u001b[19G\u001b[38;5;231mm =\u001b[23Gnp.zeros_like(fr, dtype=\u001b[38;5;148mbool\u001b[38;5;231m)        \u001b[70G                                   \r\u001b[7C\u001b[1B\u001b[38;5;77m5\u001b[19G\u001b[38;5;197mfor\u001b[38;5;231m h \u001b[38;5;197min\u001b[38;5;231m (\u001b[38;5;141m1\u001b[38;5;231m, \u001b[38;5;141m2\u001b[38;5;231m, \u001b[38;5;141m3\u001b[38;5;231m):                                                                            \r\u001b[7C\u001b[1B\u001b[38;5;77m6\u001b[19G\u001b[38;5;231m \u001b[21G \u001b[23Gm |= np.\u001b[38;5;148mabs\u001b[38;5;231m(fr - h *\u001b[44Gf[k])\u001b[50G<\u001b[52G\u001b[38;5;141m0.05\r\u001b[7C\u001b[1B\u001b[38;5;77m7\u001b[19G\u001b[38;5;231mp = \u001b[38;5;141m2\u001b[38;5;231m * np.\u001b[38;5;148mabs\u001b[38;5;231m(X) ** \u001b[38;5;141m2\u001b[38;5;231m \u001b[43G \u001b[45G \u001b[47G   \r\u001b[7C\u001b[1B\u001b[38;5;77m8\u001b[19G\u001b[38;5;231mband = (fr > \u001b[38;5;141m0.5\u001b[38;5;231m) & (fr < \u001b[38;5;141m100.0\u001b[38;5;231m)                                         \r\u001b[7C\u001b[1B\u001b[38;5;77m9\u001b[19G\u001b[38;5;231mtone[k] = np.sqrt\u001b[37Gp[m\u001b[41G& band].\u001b[38;5;148msum\u001b[38;5;231m())\r\u001b[6C\u001b[1B\u001b[38;5;77m40\u001b[19G\u001b[38;5;231mwide[k] = np.sqrt(p[~m & band].\u001b[38;5;148msum\u001b[38;5;231m())\r\u001b[5C\u001b[1B\u001b[49m\u001b[38;5;246m\u2026 22 more lines \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Allowed by auto mode\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mThe gain discriminator settles #4 and raises a new problem with a mode both nodes found. Now the pulser mask width:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m\u25cf\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\r\u001b[4C\u001b[1B\u001b[38;5;246m $ cat >\u001b[14Greconcile/r5_pulser.py <<'EOF'\r\u001b[5C\u001b[1B#!/usr/bin/env python3\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;246m\"\"\"R5: how long is the heater pulse? Settles the analyst's 1.1 s mask against the verifier's 4.4 s.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;246mNeither node measured the pulse on quiet data with the drive absent: the analyst guessed 1.1 s and saw\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;246mno pulse shape in its quiet stacks\u2026\r\u001b[12C\u001b[2BChecking\u001b[22Gfilesystem traversal scope\u2026 \u00b7 3m 26s \u00b7 \u2193\u001b[63G13.7k tokens)\u001b[39m\u001b[33;1H\u001b[31;3H\u001b[?25h"]
