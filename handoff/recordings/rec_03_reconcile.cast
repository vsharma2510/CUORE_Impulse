[225.790907, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;5;77m\u001b[48;5;22m20\u001b[11G\u001b[38;5;197mfor\u001b[38;5;231m label \u001b[38;5;197min\u001b[38;5;231m (\u001b[38;5;186m\"quiet1\"\u001b[38;5;231m, \u001b[38;5;186m\"quiet2\"\u001b[38;5;231m, \u001b[38;5;186m\"quiet3\"\u001b[38;5;231m):  \r\u001b[6C\u001b[1B\u001b[38;5;77m21\u001b[15G\u001b[38;5;231mw\u001b[17G=\u001b[19Gmeta[\u001b[38;5;186m\"windows\"\u001b[38;5;231m][label]                                                                         \r\u001b[7C\u001b[1B\u001b[38;5;77m2\u001b[11G\u001b[38;5;231m    a, b = w[\u001b[38;5;186m\"t0_s\"\u001b[38;5;231m], w[\u001b[36G\u001b[38;5;186mt1_s\"\u001b[38;5;231m]  \u001b[45G          \r\u001b[7C\u001b[1B\u001b[38;5;77m3\u001b[15G\u001b[38;5;231msel\u001b[19G= \u001b[22Gp\u001b[24G(tp > a + PRE) & (tp < b - POST)]                                                         \r\u001b[7C\u001b[1B\u001b[38;5;77m4\u001b[15G\u001b[38;5;231mn = \u001b[38;5;148mint\u001b[38;5;231m((PRE + POST) * FS) \r\u001b[7C\u001b[1B\u001b[38;5;77m5\u001b[15G\u001b[38;5;231macc\u001b[21Gn\u001b[23G.zeros(n);\u001b[34Gnch = \u001b[38;5;141m0\u001b[38;5;231m                                                                         \r\u001b[7C\u001b[1B\u001b[38;5;77m6\u001b[15G\u001b[38;5;197mfor\u001b[38;5;231m name \u001b[38;5;197min\u001b[38;5;231m BOLO:   \u001b[36G \u001b[38G   \r\u001b[7C\u001b[1B\u001b[38;5;77m7\u001b[15G\u001b[38;5;231m   \u001b[19Gx\u001b[21G= np.l\u001b[28Gad(\u001b[38;5;186mf\"data/arrays/\u001b[38;5;231m{label}\u001b[38;5;186m/bolo/\u001b[38;5;231m{name}\u001b[38;5;186m.npy\"\u001b[38;5;231m,\u001b[71Gmmap_mode=\u001b[38;5;186m\"r\"\u001b[38;5;231m)\r\u001b[7C\u001b[1B\u001b[38;5;77m8\u001b[15G\u001b[38;5;231m    st = np.zeros(n); m = \u001b[38;5;141m0\r\u001b[7C\u001b[1B\u001b[38;5;77m9\u001b[19G\u001b[38;5;197mfor\u001b[38;5;231m t \u001b[38;5;197min\u001b[38;5;231m sel:                                      \u001b[71G              \r\u001b[6C\u001b[1B\u001b[38;5;77m30\u001b[19G\u001b[38;5;231m  \u001b[22G i = \u001b[38;5;148mint\u001b[38;5;231m(\u001b[38;5;148mround\u001b[38;5;231m((t - a\u001b[44G-\u001b[46GPRE)\u001b[51G*\u001b[53GFS))\r\u001b[6C\u001b[1B\u001b[38;5;77m31\u001b[19G\u001b[38;5;231m    \u001b[38;5;197mif\u001b[38;5;231m i\u001b[28G< \u001b[38;5;141m0\u001b[38;5;231m \u001b[38;5;197mor\u001b[35G\u001b[38;5;231mi\u001b[37G+\u001b[39Gn\u001b[41G>\u001b[43G\u001b[38;5;148mlen\u001b[38;5;231m(x):\r\u001b[7C\u001b[1B\u001b[38;5;77m2\u001b[23G\u001b[38;5;231m \u001b[25G \u001b[27G\u001b[38;5;197mcontinue\u001b[38;5;231m    \u001b[40G \u001b[42G \u001b[44G \u001b[46G    \u001b[51G \u001b[53G    \r\u001b[7C\u001b[1B\u001b[38;5;77m3\u001b[23G\u001b[38;5;231ms = np.asarray(x[i:i + n], dtype=np.float64)                                               \r\u001b[7C\u001b[1B\u001b[38;5;77m4\u001b[23G\u001b[38;5;231ms\u001b[25G-= np.median(s[:\u001b[38;5;148mint\u001b[38;5;231m(PRE\u001b[49G*\u001b[51GFS)])\u001b[68G\u001b[38;5;242m# baseline from the pre-pulse samples\r\u001b[7C\u001b[1B\u001b[38;5;77m5\u001b[24G\u001b[38;5;231mt += s; m += \u001b[38;5;141m1\u001b[38;5;231m                                                                            \r\u001b[7C\u001b[1B\u001b[38;5;77m6\u001b[19G\u001b[38;5;197mif\u001b[38;5;231m m:                        \u001b[49G \u001b[51G     \u001b[68G                                     \r\u001b[7C\u001b[1B\u001b[38;5;77m7\u001b[23G\u001b[38;5;231macc += st / m; nch += \u001b[38;5;141m1\r\u001b[7C\u001b[1B\u001b[38;5;77m8\u001b[15G\u001b[38;5;231mstack = acc / nch                                                                                  \r\u001b[7C\u001b[1B\u001b[38;5;77m9\u001b[15G\u001b[38;5;231mt\u001b[17G=\u001b[19Gnp.arange(n) / FS - PRE  \u001b[45G                                                                     \r\u001b[6C\u001b[1B\u001b[38;5;77m40\u001b[15G\u001b[38;5;231mpre =\u001b[21Gst\u001b[25Gk[t\u001b[29G< -\u001b[38;5;141m0.2\u001b[38;5;231m]                                                                              \r\u001b[5C\u001b[1B\u001b[49m\u001b[38;5;246m\u2026 29 more lines \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Allowed by auto mode\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[39m\u001b[K\u001b[33;1H\u001b[31;3H\u001b[?25h"]
