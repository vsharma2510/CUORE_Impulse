[105.771107, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;77m\u001b[48;5;22m5\u001b[15G\u001b[38;5;231m    verdict = \u001b[38;5;186m\"weak/absent in the other node's own |H|\"\r\u001b[7C\u001b[1B\u001b[38;5;77m6\u001b[15G\u001b[38;5;231msa\u001b[18G= \u001b[38;5;186m\"edge\"\u001b[38;5;231m \u001b[38;5;197mif\u001b[38;5;231m na \u001b[38;5;197mis\u001b[38;5;231m \u001b[38;5;141mNone\u001b[38;5;231m \u001b[38;5;197melse\u001b[38;5;231m \u001b[38;5;186mf\"\u001b[38;5;231m{na:d}\u001b[38;5;186m\"\u001b[38;5;231m                                  \r\u001b[7C\u001b[1B\u001b[38;5;77m7\u001b[15G\u001b[38;5;231msv = \u001b[38;5;186m\"edge\"\u001b[38;5;231m \u001b[38;5;197mif\u001b[38;5;231m nv\u001b[33G\u001b[38;5;197mis\u001b[36G\u001b[38;5;141mNone\u001b[41G\u001b[38;5;197melse\u001b[46G\u001b[38;5;186mf\"\u001b[38;5;231m{nv:d}\u001b[38;5;186m\"\r\u001b[7C\u001b[1B\u001b[38;5;77m8\u001b[15G\u001b[38;5;148mprint\u001b[38;5;231m(\u001b[38;5;186mf\"\u001b[38;5;231m{f0:\u001b[38;5;141m8.4\u001b[38;5;231mf}\u001b[38;5;186m \u001b[38;5;231m{who:>3s}\u001b[38;5;186m \u001b[38;5;231m{g:\u001b[38;5;141m7.3\u001b[38;5;231mf}\u001b[38;5;186m  \u001b[38;5;231m{sa:>9s}\u001b[62G{sv:>9s}\u001b[38;5;186m   \u001b[38;5;231m{verdict}\u001b[38;5;186m\"\u001b[38;5;231m)\r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 59 \u001b[22m     rows.append((f0, who, g, na, nv))\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 60 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 61 \u001b[22m \u001b[38;5;148mprint\u001b[38;5;231m(\u001b[38;5;186m\"\\nreference: the same count for the 9 modes both nodes agree on\"\u001b[38;5;231m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 62 \u001b[22m \u001b[38;5;197mfor\u001b[38;5;231m f0 \u001b[38;5;197min\u001b[38;5;231m (\u001b[38;5;141m3.021\u001b[38;5;231m, \u001b[38;5;141m3.420\u001b[38;5;231m, \u001b[38;5;141m3.962\u001b[38;5;231m, \u001b[38;5;141m4.886\u001b[38;5;231m, \u001b[38;5;141m5.349\u001b[38;5;231m, \u001b[38;5;141m7.464\u001b[38;5;231m, \u001b[38;5;141m8.099\u001b[38;5;231m, \u001b[38;5;141m8.172\u001b[38;5;231m, \u001b[38;5;141m8.794\u001b[38;5;231m):\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 63 \u001b[22m     na, g = peak_count(Ha, Sa, f0)\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m64\u001b[15G\u001b[22mnv, _ = peak_count(Hv, Sv, f0)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 59 -\u001b[38;5;231m    print(f\"{f0:8.4f} {'AV':>3s} {g:7.3f}  {na:9d} {nv:9d}\")                                           \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 65 +\u001b[38;5;231m    \u001b[38;5;148mprint\u001b[38;5;231m(\u001b[38;5;186mf\"\u001b[38;5;231m{f0:\u001b[38;5;141m8.4\u001b[38;5;231mf}\u001b[38;5;186m \u001b[38;5;231m{\u001b[38;5;186m'AV'\u001b[38;5;231m:>3s}\u001b[38;5;186m \u001b[38;5;231m{g:\u001b[38;5;141m7.3\u001b[38;5;231mf}\u001b[38;5;186m  \u001b[38;5;231m{na:9d}\u001b[38;5;186m \u001b[38;5;231m{nv:9d}\u001b[38;5;186m\"\u001b[38;5;231m)\u001b[48;5;28m  \u001b[38;5;242m# all nine are interior points\u001b[38;5;231m\u001b[48;5;22m           \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m6\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;231m\u001b[2m7\u001b[11G\u001b[22mmed_a, med_v = np.median(Ha, \u001b[38;5;141m0\u001b[38;5;231m), np.median(Hv, \u001b[38;5;141m0\u001b[38;5;231m)\r\u001b[7C\u001b[1B\u001b[2m8\u001b[11G\u001b[22m\u001b[38;5;148mprint\u001b[38;5;231m(\u001b[38;5;186m\"\\nmedian |H| around each unmatched mode (A then V, normalised to the mode's own value)\"\u001b[38;5;231m)\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Allowed by auto mode\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mDecisive\u001b[12Gon\u001b[15Gthe\u001b[19Gbiggest\u001b[27Gdisagreement.\u001b[41GNow\u001b[45Gthe\u001b[49Greference-channel\u001b[67Gtest\u001b[72Gfor\u001b[76Gthe\u001b[80G5.5\u001b[84GHz\u001b[87Gjump:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[4C\u001b[1B\u001b[38;5;246m $ cat >\u001b[14Greconcile/r4_reference.py <<'EOF'\r\u001b[5C\u001b[1B#!/usr/bin/env python3\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;246m\"\"\"R4: is the 5.4->5.5 Hz jump in |H| instrumental (in ch1111) or physical?\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;246mThe critic showed the jump cannot be cancelled by a ratio to ch1111 because it IS in ch1111. A ratio\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;246mto an INDEPENDENT drive monitor can cancel it: ch1112 is \u2026\r\u001b[12C\u001b[2BChecking filesystem traversal scope\u2026 \u00b7 2m 3s \u00b7 \u2193\u001b[62G7.5k tokens)\u001b[39m\u001b[33;1H\u001b[31;3H\u001b[?25h"]
