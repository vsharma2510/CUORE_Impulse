[410.329458, "o", "\u001b[?25l\u001b[H\u001b[38;5;246m  \u23bf \u00a0\u001b[39mU\u001b[8Gdated\u001b[14G\u001b[1mreconcile/r6c_instfreq.py\u001b[22m \u001b[38;5;246m(+2 -2)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 32 \u001b[22m     fi = np.gradient(ph) * FS / (\u001b[38;5;141m2\u001b[38;5;231m * np.pi)\r\u001b[5C\u001b[1B\u001b[2m 33 \u001b[22m     n = \u001b[38;5;148mint\u001b[38;5;231m(\u001b[38;5;141m1.0\u001b[38;5;231m * FS)                                       \u001b[38;5;242m# 1 s moving average\r\u001b[1B\u001b[39m     \u001b[38;5;231m\u001b[2m 34 \u001b[22m     c = np.cumsum(np.r_[\u001b[38;5;141m0\u001b[38;5;231m, fi]); fi = (c[n:] - c[:-n]) / n\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 35 -\u001b[38;5;231m    tt = np.arange(i0, i1 - n) / FS + OFF + n / (2 * FS)                                               \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 35 +\u001b[38;5;231m    tt = \u001b[48;5;28m(\u001b[48;5;22mnp.arange(\u001b[38;5;148m\u001b[48;5;28mlen\u001b[38;5;231m(fi))\u001b[48;5;22m \u001b[48;5;28m+\u001b[48;5;22m \u001b[48;5;28mi0\u001b[48;5;22m) / FS + OFF + n / (\u001b[38;5;141m2\u001b[38;5;231m * FS)                                           \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m6\u001b[15G\u001b[22mm\u001b[19G(tt > ts[k] - HALF) & (tt <\u001b[47Gts[k] + HALF)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 37 \u001b[22m     tt, fi = tt[m], fi[m]\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 38 \u001b[22m     mid = \u001b[38;5;141m0.5\u001b[38;5;231m * (f[k - \u001b[38;5;141m1\u001b[38;5;231m] + f[k])\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;246m...\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m59\u001b[11G\u001b[22mph\u001b[14G= np.unwrap(np.angle(hilbert(sosfiltfilt(sos, seg))))\r\u001b[6C\u001b[1B\u001b[2m60\u001b[11G\u001b[22mfi\u001b[14G= np.gradient\u001b[28Gph)\u001b[32G*\u001b[34GFS\u001b[37G/\u001b[39G(\u001b[38;5;141m2\u001b[38;5;231m * np.pi)\r\u001b[5C\u001b[1B\u001b[2m 61 \u001b[22m n = \u001b[38;5;148mint\u001b[38;5;231m(FS); c = np.cumsum(np.r_[\u001b[38;5;141m0\u001b[38;5;231m, fi]); fi = (c[n:] - c[:-n]) / n\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 62 -\u001b[38;5;231mtt = np.arange(i0, i1 - n) / FS + OFF + n / (2 * FS)                                                   \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 62 +\u001b[38;5;231mtt = \u001b[48;5;28m(\u001b[48;5;22mnp.arange(\u001b[38;5;148m\u001b[48;5;28mlen\u001b[38;5;231m(fi))\u001b[48;5;22m \u001b[48;5;28m+\u001b[48;5;22m \u001b[48;5;28mi0\u001b[48;5;22m) / FS + OFF + n / (\u001b[38;5;141m2\u001b[38;5;231m * FS)                                               \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m3\u001b[11G\u001b[22m\u001b[38;5;148mprint\u001b[38;5;231m(\u001b[38;5;186mf\"\\ninstantaneous drive frequency across the boundary steps.csv says is at \u001b[38;5;231m{ts[k]:\u001b[38;5;141m.1\u001b[38;5;231mf}\u001b[38;5;186m s\"\u001b[38;5;231m)\r\u001b[5C\u001b[1B\u001b[2m 64 \u001b[22m \u001b[38;5;148mprint\u001b[38;5;231m(\u001b[38;5;186mf\"  analyst \u001b[38;5;231m{ta[k]-ts[k]:+\u001b[38;5;141m.2\u001b[38;5;231mf}\u001b[38;5;186m s, verifier \u001b[38;5;231m{tv[k]-ts[k]:+\u001b[38;5;141m.2\u001b[38;5;231mf}\u001b[38;5;186m s, measured \u001b[38;5;231m{meas[k]-ts[k]:+\u001b[38;5;141m.3\u001b[38;5;231mf}\u001b[38;5;186m s\"\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m    \u001b[22m )\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;231m\u001b[2m5\u001b[11G\u001b[22m\u001b[38;5;197mfor\u001b[38;5;231m off \u001b[38;5;197min\u001b[38;5;231m (-\u001b[38;5;141m10\u001b[38;5;231m, -\u001b[38;5;141m8\u001b[38;5;231m, -\u001b[38;5;141m6.3\u001b[38;5;231m, -\u001b[38;5;141m4\u001b[38;5;231m, -\u001b[38;5;141m2\u001b[38;5;231m, -\u001b[38;5;141m0.5\u001b[38;5;231m, \u001b[38;5;141m0\u001b[38;5;231m, +\u001b[38;5;141m0.5\u001b[38;5;231m, +\u001b[38;5;141m2\u001b[38;5;231m, +\u001b[38;5;141m4\u001b[38;5;231m, +\u001b[38;5;141m8\u001b[38;5;231m):\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Allowed by auto mode\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mBoth my earlier boundary attempts were void. This one is internally consistent\u001b[82G(250.0003\u001b[92Gs\u001b[94Gspacing,\u001b[103G\u03c3\u001b[105G37\u001b[108Gms)\u001b[112Gand\r\u001b[1B  reverses the answer. Now\u001b[28Gbuilding\u001b[37Gthe\u001b[41Gcomparison\u001b[52Gtable:\r\u001b[2B\u001b[38;5;246m \u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[22m shell\u001b[19Gc\u001b[21Gmmand\u2026\u001b[28G\u001b[K\u001b[33;1H\u001b[31;3H\u001b[?25h"]
