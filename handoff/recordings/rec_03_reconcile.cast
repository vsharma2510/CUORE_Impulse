[390.428181, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39m70 of 70 boundaries located\u001b[K\r\u001b[5C\u001b[1Bspacing of consecutive measured boundaries: median 250.0003 s, robust sigma 0.0371 s, fraction within 0.1 s of\r\u001b[5C\u001b[1B 250 s 0.96\u001b[K\r\u001b[5C\u001b[1B\u001b[2m\u2026 +17 lines\u001b[22m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mUpdated \u001b[1mreconcile/r6c_instfreq.py\u001b[22m \u001b[38;5;246m(+2 -2)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 32 \u001b[22m     fi = np.gradient(ph) * FS / (\u001b[38;5;141m2\u001b[38;5;231m * np.pi)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 33 \u001b[22m     n = \u001b[38;5;148mint\u001b[38;5;231m(\u001b[38;5;141m1.0\u001b[38;5;231m * FS)                                       \u001b[38;5;242m# 1 s moving average\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 34 \u001b[22m     c = np.cumsum(np.r_[\u001b[38;5;141m0\u001b[38;5;231m, fi]); fi = (c[n:] - c[:-n]) / n\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 35 -\u001b[38;5;231m    tt = np.arange(i0, i1 - n) / FS + OFF + n / (2 * FS)                                               \r\u001b[7C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m5\u001b[15G\u001b[38;5;231mtt = \u001b[48;5;28m(\u001b[22G\u001b[48;5;22mp.arange(\u001b[38;5;148m\u001b[48;5;28mlen\u001b[38;5;231m(fi))\u001b[40G+\u001b[42Gi0\u001b[48;5;22m)\u001b[46G/\u001b[48GFS\u001b[51G+\u001b[53GOFF\u001b[57G+\u001b[59Gn\u001b[61G/\u001b[63G(\u001b[38;5;141m2\u001b[38;5;231m * FS)                                           \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 36 \u001b[22m     m = (tt > ts[k] - HALF) & (tt < ts[k] + HALF)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 37 \u001b[22m     tt, fi = tt[m], fi[m]\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 38 \u001b[22m     mid = \u001b[38;5;141m0.5\u001b[38;5;231m * (f[k - \u001b[38;5;141m1\u001b[38;5;231m] + f[k])\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;246m...\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;231m\u001b[2m 59 \u001b[22m ph = np.unwrap(np.angle(hilbert(sosfiltfilt(sos, seg))))\r\u001b[5C\u001b[1B\u001b[2m 60 \u001b[22m fi = np.gradient(ph) * FS / (\u001b[38;5;141m2\u001b[38;5;231m * np.pi)\r\u001b[1B\u001b[39m \u001b[3G  \u001b[6G\u001b[38;5;231m\u001b[2m 61 \u001b[22m n = \u001b[38;5;148mint\u001b[38;5;231m(FS); c = np.cumsum(np.r_[\u001b[38;5;141m0\u001b[38;5;231m, fi]); fi = (c[n:] - c[:-n]) / n\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 62 -\u001b[38;5;231mtt = np.arange(i0, i1 - n) / FS + OFF + n / (2 * FS)                                                   \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;77m\u001b[48;5;22m 62 +\u001b[38;5;231mtt = \u001b[48;5;28m(\u001b[48;5;22mnp.arange(\u001b[38;5;148m\u001b[48;5;28mlen\u001b[38;5;231m(fi))\u001b[48;5;22m \u001b[48;5;28m+\u001b[48;5;22m \u001b[48;5;28mi0\u001b[48;5;22m) / FS + OFF + n / (\u001b[38;5;141m2\u001b[38;5;231m * FS)                                               \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;5;231m\u001b[2m 63 \u001b[22m \u001b[38;5;148mprint\u001b[38;5;231m(\u001b[38;5;186mf\"\\ninstantaneous drive frequency across the boundary steps.csv says is at \u001b[38;5;231m{ts[k]:\u001b[38;5;141m.1\u001b[38;5;231mf}\u001b[38;5;186m s\"\u001b[38;5;231m)\r\u001b[5C\u001b[1B\u001b[2m 64 \u001b[22m \u001b[38;5;148mprint\u001b[38;5;231m(\u001b[38;5;186mf\"  analyst \u001b[38;5;231m{ta[k]-ts[k]:+\u001b[38;5;141m.2\u001b[38;5;231mf}\u001b[38;5;186m s, verifier \u001b[38;5;231m{tv[k]-ts[k]:+\u001b[38;5;141m.2\u001b[38;5;231mf}\u001b[38;5;186m s, measured \u001b[38;5;231m{meas[k]-ts[k]:+\u001b[38;5;141m.3\u001b[38;5;231mf}\u001b[38;5;186m s\"\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m    \u001b[22m )\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 65 \u001b[22m \u001b[38;5;197mfor\u001b[38;5;231m off \u001