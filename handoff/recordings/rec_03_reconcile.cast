[247.7587, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;77m\u001b[48;5;22m8\u001b[19G\u001b[38;5;231mst = np.zeros(n); m = \u001b[38;5;141m0\u001b[38;5;231m                            \u001b[71G              \r\u001b[7C\u001b[1B\u001b[38;5;77m9\u001b[19G\u001b[38;5;197mfor\u001b[38;5;231m t \u001b[38;5;197min\u001b[38;5;231m sel:          \r\u001b[6C\u001b[1B\u001b[38;5;77m30\u001b[19G\u001b[38;5;231m    i = \u001b[38;5;148mint\u001b[38;5;231m(\u001b[38;5;148mround\u001b[38;5;231m((t\u001b[40G-\u001b[42Ga\u001b[44G-\u001b[46GPRE)\u001b[51G*\u001b[53GFS))\r\u001b[7C\u001b[1B\u001b[38;5;77m1\u001b[23G\u001b[38;5;197mif\u001b[38;5;231m i < \u001b[38;5;141m0\u001b[38;5;231m \u001b[38;5;197mor\u001b[38;5;231m i + n > \u001b[38;5;148mlen\u001b[38;5;231m(x):\u001b[51G \u001b[53G    \r\u001b[7C\u001b[1B\u001b[38;5;77m2\u001b[23G\u001b[38;5;231m    \u001b[38;5;197mcontinue\u001b[38;5;231m \u001b[37G \u001b[39G \u001b[41G \u001b[43G       \r\u001b[7C\u001b[1B\u001b[38;5;77m3\u001b[23G\u001b[38;5;231ms\u001b[25G=\u001b[27Gnp.asarray(x[i:i + n], dtype=np.float64)                                               \r\u001b[7C\u001b[1B\u001b[38;5;77m4\u001b[25G\u001b[38;5;231m-= np.medi\u001b[36Gn\u001b[38Gs\u001b[40G:\u001b[38;5;148mint\u001b[38;5;231m(PRE * FS)])            \u001b[38;5;242m# baseline from the pre-pulse samples\u001b[38;5;231m         \r\u001b[7C\u001b[1B\u001b[38;5;77m5\u001b[24G\u001b[38;5;231mt += s; m += \u001b[38;5;141m1\u001b[38;5;231m          \u001b[49G \u001b[51G     \u001b[68G                                     \r\u001b[7C\u001b[1B\u001b[38;5;77m6\u001b[19G\u001b[38;5;197mif\u001b[38;5;231m m:              \r\u001b[7C\u001b[1B\u001b[38;5;77m7\u001b[19G\u001b[38;5;231m    acc += st / m; nch += \u001b[38;5;141m1\r\u001b[7C\u001b[1B\u001b[38;5;77m8\u001b[15G\u001b[38;5;231mstack\u001b[21G=\u001b[27G/ nch\u001b[33G \u001b[35G  \u001b[38G   \u001b[42G  \u001b[45G                                                                     \r\u001b[7C\u001b[1B\u001b[38;5;77m9\u001b[15G\u001b[38;5;231mt = np.arange(\u001b[30G) /\u001b[34GFS\u001b[37G-\u001b[39GPRE\r\u001b[6C\u001b[1B\u001b[38;5;77m40\u001b[15G\u001b[38;5;231mpre\u001b[19G= stack[t < -\u001b[38;5;141m0.2\u001b[38;5;231m]                                                                              \r\u001b[5C\u001b[1B\u001b[49m\u001b[38;5;246m\u2026 29 more lines \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Allowed by auto\u001b[22Gmode\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mMy\u001b[6Gown\u001b[10Gstack\u001b[16Gwas\u001b[20Greading\u001b[28Gbaseline\u001b[37Gdrift,\u001b[44Gnot\u001b[48Ga\u001b[50Gpulse.\u001b[57GRedoing\u001b[65Git\u001b[68Gwith\u001b[73Ga\u001b[75Gdetrend\u001b[83Gand\u001b[87Ga\u001b[89Gwrong-phase\u001b[101Gcontrol:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m\u25cf\u001b[3G\u001b[39mDetrended\u001b[13Gpulse\u001b[19Gstack\u001b[25Gwith\u001b[30Gwrong-phase\u001b[42Gcontrol\u001b[38;5;246m \u00b7 2s\r\u001b[1B  \u23bf  $ cat > reconcile/r5b_pulser.py <<'EOF'\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;246m#!/usr/bin/e\u001b[19Gv python3\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;246m\"\"\"R5b: pulse shape on quiet data, done properly.\r\u001b[5C\u001b[1Br5_pulser.py gave a\u001b[26Gmonotonic ramp\u001b[41Gwith\u001b[46Gno f\u001b[51Gature at t = 0. That was bolometer baseline DRIFT, not a\r\u001b[5C\u001b[1Bpulse: the per-s\u001b[23Ggment median\u001b[36Gb\u001b[38Gseline leaves a low-frequency w\u001b[70Gnder that the pre-pu\u2026 (3s)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;246m(ctrl+b ctrl+b (twice)\u001b[29Gto ru\u001b[36Gin background)\u001b[39m\u001b[K\u001b[33;1H\u001b[31;3H\u001b[?25h"]
