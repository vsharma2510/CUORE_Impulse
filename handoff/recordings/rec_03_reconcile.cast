[191.388601, "o", "\u001b[?25l\u001b[H\r\u001b[41C\u001b[19B\u001b[38;5;246m \u00b7 2s\u001b[39m\u001b[33;1H\u001b[31;3H\u001b[?25h"]
[191.524526, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;5;77m\u001b[48;5;22m18\u001b[11G\u001b[38;5;231mBOLO\u001b[16G=\u001b[18G[\u001b[38;5;186mf\"ch\u001b[38;5;231m{c:04d}\u001b[38;5;186m\"\u001b[38;5;231m \u001b[38;5;197mfor\u001b[36G\u001b[38;5;231mc \u001b[38;5;197min\u001b[41G\u001b[38;5;148mrange\u001b[38;5;231m(\u001b[38;5;141m937\u001b[38;5;231m,\u001b[52G\u001b[38;5;141m989\u001b[38;5;231m)]     \u001b[63G \u001b[65G    \u001b[70G \u001b[72G   \r\u001b[6C\u001b[1B\u001b[38;5;77m19\u001b[19G\u001b[38;5;231m   \u001b[23G \u001b[25G                  \u001b[44G                 \r\u001b[7C\u001b[1B\u001b[38;5;77m0\u001b[11G\u001b[38;5;197mfor\u001b[38;5;231m label \u001b[38;5;197min\u001b[38;5;231m (\u001b[38;5;186m\"quiet1\"\u001b[38;5;231m, \u001b[38;5;186m\"quiet2\"\u001b[38;5;231m, \u001b[38;5;186m\"quiet3\"\u001b[38;5;231m):     \u001b[70G                                   \r\u001b[6C\u001b[1B\u001b[38;5;77m21\u001b[15G\u001b[38;5;231mw\u001b[17G=\u001b[19Gm\u001b[21Gta[\u001b[38;5;186m\"windows\"\u001b[38;5;231m][label]                                                                         \r\u001b[6C\u001b[1B\u001b[38;5;77m22\u001b[15G\u001b[38;5;231ma,\u001b[18Gb = w[\u001b[38;5;186m\"t0_s\"\u001b[38;5;231m], w[\u001b[38;5;186m\"t1_s\"\u001b[38;5;231m] \r\u001b[6C\u001b[1B\u001b[38;5;77m23\u001b[15G\u001b[38;5;231msel\u001b[19G= tp[(tp > a + PRE) & (tp < b - POST)]                                                         \r\u001b[6C\u001b[1B\u001b[38;5;77m24\u001b[15G\u001b[38;5;231mn\u001b[17G=\u001b[19G\u001b[38;5;148mint\u001b[38;5;231m((PRE + POST) * FS)                                                   \r\u001b[6C\u001b[1B\u001b[38;5;77m25\u001b[15G\u001b[38;5;231macc\u001b[19G=\u001b[21Gnp.zeros(n); nch = \u001b[38;5;141m0\u001b[38;5;231m           \r\u001b[6C\u001b[1B\u001b[38;5;77m26\u001b[15G\u001b[38;5;197mfor\u001b[38;5;231m name \u001b[38;5;197min\u001b[38;5;231m BOLO:  \u001b[35G   \r\u001b[6C\u001b[1B\u001b[38;5;77m27\u001b[19G\u001b[38;5;231mx\u001b[21G=\u001b[23Gnp.load(\u001b[38;5;186mf\"data/arrays/\u001b[38;5;231m{label}\u001b[38;5;186m/bolo/\u001b[38;5;231m{name}\u001b[38;5;186m.npy\"\u001b[38;5;231m,\u001b[71Gmmap_mode=\u001b[38;5;186m\"r\"\u001b[38;5;231m)\r\u001b[6C\u001b[1B\u001b[38;5;77m28\u001b[19G\u001b[38;5;231mst = np.zeros(n); m = \u001b[38;5;141m0\r\u001b[6C\u001b[1B\u001b[38;5;77m29\u001b[19G\u001b[38;5;197mfor\u001b[38;5;231m t \u001b[38;5;197min\u001b[38;5;231m sel:    \u001b[37G \u001b[39G   \u001b[43G \u001b[45G      \r\u001b[7C\u001b[1B\u001b[38;5;77m0\u001b[19G\u001b[38;5;231m    i =\u001b[27G\u001b[38;5;148mint\u001b[38;5;231m(\u001b[38;5;148mround\u001b[38;5;231m((t - a - PRE) * FS))\r\u001b[6C\u001b[1B\u001b[38;5;77m31\u001b[19G\u001b[38;5;231m    \u001b[38;5;197mif\u001b[38;5;231m i < \u001b[38;5;141m0\u001b[38;5;231m \u001b[38;5;197mor\u001b[38;5;231m i + n > \u001b[38;5;148mlen\u001b[38;5;231m(x):      \r\u001b[5C\u001b[1B\u001b[38;5;77m 32 +\u001b[38;5;231m                \u001b[38;5;197mcontinue\u001b[38;5;231m                                                                               \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;5;77m\u001b[48;5;22m 33 +\u001b[38;5;231m            s = np.asarray(x[i:i + n], dtype=np.float64)                                               \r\u001b[5C\u001b[1B\u001b[38;5;77m 34 +\u001b[38;5;231m            s -= np.median(s[:\u001b[38;5;148mint\u001b[38;5;231m(PRE * FS)])            \u001b[38;5;242m# baseline from the pre-pulse samples\u001b[38;5;231m         \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;77m\u001b[48;5;22m 35 +\u001b[38;5;231m            st += s; m += \u001b[38;5;141m1\u001b[38;5;231m                                                                            \u001b[39m\u001b[49m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 36 +\u001b[38;5;231m        \u001b[38;5;197mif\u001b[38;5;231m m:                                                                                          \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;77m\u001b[48;5;22m 37 +\u001b[38;5;231m            acc += st / m; nch += \u001b[38;5;141m1\u001b[38;5;231m                                                                    \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;5;77m\u001b[48;5;22m 38 +\u001b[38;5;231m    stack = acc / nch                                                                                  \r\u001b[5C\u001b[1B\u001b[38;5;77m 39 +\u001b[38;5;231m    t = np.arange(n) / FS - PRE                                                                        \r\u001b[5C\u001b[1B\u001b[38;5;77m 40 +\u001b[38;5;231m    pre = stack[t < -\u001b[38;5;141m0.2\u001b[38;5;231m]                                                                              \r\u001b[5C\u001b[1B\u001b[49m\u001b[38;5;246m\u2026 29 more lines \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Allowed by \u001b[18Guto mode\u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;174m*\u001b[39m\u001b[33;1H\u001b[31;3H\u001b[?25h"]
[191.612405, "o", "\u001b[?25l\u001b[H\r\u001b[26B\u001b[38;5;174m\u2736\u001b[39m\u001b[33;1H\u001b[31;3H\u001b[?25h"]
[192.427305, "o", "\u001b[?25l\u001b[H\r\u001b[26B\u001b[38;5;174m\u273b\u001b[3GHerding\u001b[17G\u001b[38;5;246m9\u001b[39m\u001b[33;1H\u001b[31;3H\u001b[?25h"]
