[244.154246, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;77m\u001b[48;5;22m7\u001b[15G\u001b[38;5;231m  \u001b[18G x = np.load(\u001b[38;5;186mf\"data/arrays/\u001b[38;5;231m{label}\u001b[38;5;186m/bolo/\u001b[38;5;231m{name}\u001b[38;5;186m.npy\"\u001b[38;5;231m,\u001b[71Gmmap_mode=\u001b[38;5;186m\"r\"\u001b[38;5;231m)\r\u001b[7C\u001b[1B\u001b[38;5;77m8\u001b[15G\u001b[38;5;231m   \u001b[19Gst = np.zeros(n); m\u001b[39G=\u001b[41G\u001b[38;5;141m0\u001b[38;5;231m                                                                        \r\u001b[7C\u001b[1B\u001b[38;5;77m9\u001b[15G\u001b[38;5;231m \u001b[17G \u001b[19G\u001b[38;5;197mfor\u001b[38;5;231m t \u001b[38;5;197min\u001b[28G\u001b[38;5;231msel:   \u001b[36G \u001b[38G   \r\u001b[6C\u001b[1B\u001b[38;5;77m30\u001b[15G\u001b[38;5;231m   \u001b[19G \u001b[21G  i = \u001b[38;5;148mint\u001b[38;5;231m(\u001b[38;5;148mround\u001b[38;5;231m((t -\u001b[42Ga\u001b[44G-\u001b[46GPRE)\u001b[51G*\u001b[53GFS))\r\u001b[6C\u001b[1B\u001b[38;5;77m31\u001b[15G\u001b[38;5;231m        \u001b[38;5;197mif\u001b[38;5;231m i < \u001b[38;5;141m0\u001b[38;5;231m \u001b[38;5;197mor\u001b[35G\u001b[38;5;231mi\u001b[37G+\u001b[39Gn\u001b[41G>\u001b[43G\u001b[38;5;148mlen\u001b[38;5;231m(x):\r\u001b[6C\u001b[1B\u001b[38;5;77m32\u001b[19G\u001b[38;5;231m \u001b[21G \u001b[23G    \u001b[38;5;197mcontinue\u001b[38;5;231m                                   \u001b[71G              \r\u001b[6C\u001b[1B\u001b[38;5;77m33\u001b[19G\u001b[38;5;231m  \u001b[22G s = np.a\u001b[32Garray(x[i:i + n], dtype=np.float64)                                               \r\u001b[6C\u001b[1B\u001b[38;5;77m34\u001b[19G\u001b[38;5;231m    s -= np.median(s[:\u001b[38;5;148mint\u001b[38;5;231m(PRE\u001b[49G*\u001b[51GFS)])\u001b[68G\u001b[38;5;242m# baseline from the pre-pulse samples\r\u001b[7C\u001b[1B\u001b[38;5;77m5\u001b[23G\u001b[38;5;231mst += s; m += \u001b[38;5;141m1\u001b[38;5;231m \u001b[40G \u001b[42G \u001b[44G \u001b[46G    \u001b[51G \u001b[53G    \r\u001b[7C\u001b[1B\u001b[38;5;77m6\u001b[19G\u001b[38;5;197mif\u001b[38;5;231m m: \u001b[26G \u001b[28G \u001b[30G \u001b[32G  \u001b[35G \u001b[37G \u001b[39G \u001b[41G \u001b[43G       \r\u001b[7C\u001b[1B\u001b[38;5;77m7\u001b[23G\u001b[38;5;231macc\u001b[27G+= st / m; nch += \u001b[38;5;141m1\r\u001b[7C\u001b[1B\u001b[38;5;77m8\u001b[15G\u001b[38;5;231mstack\u001b[21G=\u001b[23Gacc\u001b[27G/ nch           \u001b[44G \u001b[46G   \u001b[50G                 \r\u001b[7C\u001b[1B\u001b[38;5;77m9\u001b[15G\u001b[38;5;231mt\u001b[17G=\u001b[19Gnp.arange(n) / FS - PRE                                                                        \r\u001b[6C\u001b[1B\u001b[38;5;77m40\u001b[15G\u001b[38;5;231mpre\u001b[19G=\u001b[21Gstack[t\u001b[29G< -\u001b[38;5;141m0.2\u001b[38;5;231m]  \r\u001b[5C\u001b[1B\u001b[49m\u001b[38;5;246m\u2026 29 more lines \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Allowed by auto mode\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mMy\u001b[6Gown stack was reading baseline drift, not a pulse. Redoing it with a detrend and a wrong-phase control:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m\u25cf\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\r\u001b[4C\u001b[1B\u001b[38;5;246m $ cat >\u001b[14Greconcile/r5b_pulser.py <<'EOF'\r\u001b[5C\u001b[1B#!/usr/bin/env python3\r\u001b[1B\u001b[39m \u001b[3G  \u001b[6G\u001b[38;5;246m\"\"\"R5b: pulse shape on quiet data, done properly.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;246mr5_pulser.py gave a monotonic ramp with no feature at t = 0. That was bolometer baseline DRIFT, not a\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;246mpulse: the per-segment median baseline leaves a low-frequency wander that the pre-pu\u2026\r\u001b[12C\u001b[2BChecking\u001b[22Gfilesystem traversal scope\u2026 \u00b7 4m 21s \u00b7 \u2193\u001b[63G17.7k tokens)\u001b[39m\u001b[33;1H\u001b[31;3H\u001b[?25h"]
