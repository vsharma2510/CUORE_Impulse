[276.114623, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;5;77m\u001b[48;5;22m20\u001b[11G\u001b[38;5;231mn = \u001b[38;5;148mint\u001b[38;5;231m((PRE + POST) * FS)           \r\u001b[6C\u001b[1B\u001b[38;5;77m21\u001b[11G\u001b[38;5;231mt = np.arange(n) / FS - PRE                                                                            \r\u001b[7C\u001b[1B\u001b[38;5;77m2\u001b[11G\u001b[38;5;231mFIT\u001b[15G= ((t >= -\u001b[38;5;141m2.0\u001b[38;5;231m) &\u001b[32G(t <=\u001b[38G-\u001b[38;5;141m0.3\u001b[38;5;231m))\u001b[45G|\u001b[47G((t\u001b[51G>=\u001b[54G\u001b[38;5;141m6.0\u001b[38;5;231m)\u001b[59G&\u001b[61G(t\u001b[64G<=\u001b[67G\u001b[38;5;141m7.5\u001b[38;5;231m))\r\u001b[7C\u001b[1B\u001b[38;5;77m3\u001b[11G\u001b[38;5;231mV\u001b[18Gvander\u001b[25Gt,\u001b[28G\u001b[38;5;141m2\u001b[38;5;231m)                                        \u001b[38;5;242m# linear detrend basis\u001b[38;5;231m                      \r\u001b[7C\u001b[1B\u001b[38;5;77m4\u001b[11G\u001b[38;5;231m   \u001b[15G \u001b[17G   \u001b[21G  \u001b[24G                                                                                          \r\u001b[7C\u001b[1B\u001b[38;5;77m5\u001b[11G\u001b[38;5;231m \u001b[13G \u001b[15G            \u001b[28G                                                                                      \r\u001b[7C\u001b[1B\u001b[38;5;77m6\u001b[11G\u001b[38;5;81mdef\u001b[38;5;231m \u001b[38;5;148mstack\u001b[38;5;231m(\u001b[38;5;208mlabel, a, b, times\u001b[38;5;231m):                                                                         \r\u001b[7C\u001b[1B\u001b[38;5;77m7\u001b[15G\u001b[38;5;231macc\u001b[19G=\u001b[21Gnp.zeros(n);\u001b[34Gnch\u001b[38G=\u001b[40G\u001b[38;5;141m0\u001b[38;5;231m                                                                         \r\u001b[7C\u001b[1B\u001b[38;5;77m8\u001b[11G\u001b[38;5;231m    \u001b[38;5;197mfor\u001b[38;5;231m name \u001b[38;5;197min\u001b[38;5;231m BOLO:         \r\u001b[7C\u001b[1B\u001b[38;5;77m9\u001b[15G\u001b[38;5;231m   \u001b[19Gx\u001b[21G= np.l\u001b[28Gad(\u001b[38;5;186mf\"data/arrays/\u001b[38;5;231m{label}\u001b[38;5;186m/bolo/\u001b[38;5;231m{name}\u001b[38;5;186m.npy\"\u001b[38;5;231m,\u001b[71Gmmap_mode=\u001b[38;5;186m\"r\"\u001b[38;5;231m)\r\u001b[6C\u001b[1B\u001b[38;5;77m30\u001b[15G\u001b[38;5;231m    st = np.zeros(n); m = \u001b[38;5;141m0\r\u001b[6C\u001b[1B\u001b[38;5;77m31\u001b[19G\u001b[38;5;197mfor\u001b[38;5;231m tt \u001b[38;5;197min\u001b[38;5;231m times:                                   \u001b[71G              \r\u001b[7C\u001b[1B\u001b[38;5;77m2\u001b[19G\u001b[38;5;231m  \u001b[22G i = \u001b[38;5;148mint\u001b[38;5;231m(\u001b[38;5;148mround\u001b[38;5;231m((tt -\u001b[43Ga\u001b[45G-\u001b[47GPRE)\u001b[52G*\u001b[54GFS))\r\u001b[7C\u001b[1B\u001b[38;5;77m3\u001b[19G\u001b[38;5;231m    \u001b[38;5;197mif\u001b[26G\u001b[38;5;231mi < \u001b[38;5;141m0\u001b[38;5;231m \u001b[38;5;197mor\u001b[38;5;231m i\u001b[37G+\u001b[39Gn\u001b[41G>\u001b[43G\u001b[38;5;148mlen\u001b[38;5;231m(x):\r\u001b[7C\u001b[1B\u001b[38;5;77m4\u001b[23G\u001b[38;5;231m \u001b[25G \u001b[27G\u001b[38;5;197mcontinue\u001b[38;5;231m     \u001b[41G \u001b[43G \u001b[45G \u001b[47G    \u001b[52G \u001b[54G    \r\u001b[7C\u001b[1B\u001b[38;5;77m5\u001b[23G\u001b[38;5;231ms = np.asarray(x[i:i + n], dtype=np.float64)                                               \r\u001b[7C\u001b[1B\u001b[38;5;77m6\u001b[23G\u001b[38;5;231mc,\u001b[26G*_ = np.linalg.lstsq(V[FIT], s[FIT], rcond=\u001b[38;5;141mNone\u001b[38;5;231m)\r\u001b[7C\u001b[1B\u001b[38;5;77m7\u001b[24G\u001b[38;5;231mt += s - V @ c     \u001b[44G \u001b[46G   \u001b[50G                 \r\u001b[7C\u001b[1B\u001b[38;5;77m8\u001b[23G\u001b[38;5;231mm += \u001b[38;5;141m1\u001b[38;5;231m                                             \r\u001b[7C\u001b[1B\u001b[38;5;77m9\u001b[19G\u001b[38;5;197mif\u001b[38;5;231m m:                                                                                          \r\u001b[6C\u001b[1B\u001b[38;5;77m40\u001b[23G\u001b[38;5;231macc += st / m; nch += \u001b[38;5;141m1\r\u001b[5C\u001b[1B\u001b[49m\u001b[38;5;246m\u2026 24 more lines \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Allowed by auto mode\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Running \u001b[1m1\u001b[22m shell command\u2026\r\u001b[2B\u001b[38;5;174m\u273d\u001b[3GHerding\u2026 \u001b[24G\u001b[38;5;246m20\u001b[27G4\u001b[39G\u001b[38;5;248mthinking\u001b[38;5;246m)\u001b[39m\u001b[K\u001b[33;1H\u001b[31;3H\u001b[?25h"]
