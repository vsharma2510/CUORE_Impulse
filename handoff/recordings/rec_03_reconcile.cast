[409.54156, "o", "\u001b[?25l\u001b[H\u001b[6Gspacing\u001b[14Gof\u001b[17Gconsecutive\u001b[29Gmeasured\u001b[38Gboundaries:\u001b[50Gmedian\u001b[57G250.0003\u001b[66Gs,\u001b[69Grobust\u001b[76Gsigma\u001b[82G0.0371\u001b[89Gs,\u001b[92Gfraction\u001b[101Gwithin\u001b[108G0.1\u001b[112Gs\u001b[114Gof\r\u001b[1B      250 s \u001b[14G.96\u001b[K\r\u001b[5C\u001b[1B\u001b[2m\u2026 +17 lines\u001b[22m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mUpdated \u001b[1mreconcile/r6c_instfreq.py\u001b[40G\u001b[22m\u001b[38;5;246m(+2 -2)\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 32 \u001b[22m     fi = np.gradient(ph) * FS / (\u001b[38;5;141m2\u001b[38;5;231m * np.pi)\r\u001b[1B\u001b[39m     \u001b[38;5;231m\u001b[2m 33 \u001b[22m     n = \u001b[38;5;148mint\u001b[38;5;231m(\u001b[38;5;141m1.0\u001b[38;5;231m * FS)                                       \u001b[38;5;242m# 1 s moving average\r\u001b[7C\u001b[1B\u001b[38;5;231m\u001b[2m4\u001b[15G\u001b[22mc = np.cumsum(\u001b[30Gp.r_[\u001b[38;5;141m0\u001b[38;5;231m,\u001b[38Gfi]); fi = (c[n:] - c[:-n]) / n\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 35 -\u001b[38;5;231m    tt = np.arange(i0, i1 - n) / FS + OFF + n / (2 * FS)                                               \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 35 +\u001b[38;5;231m    tt = \u001b[48;5;28m(\u001b[48;5;22mnp.arange(\u001b[38;5;148m\u001b[48;5;28mlen\u001b[38;5;231m(fi))\u001b[48;5;22m \u001b[48;5;28m+\u001b[48;5;22m \u001b[48;5;28mi0\u001b[48;5;22m) / FS + OFF + n / (\u001b[38;5;141m2\u001b[38;5;231m * FS)                                           \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 36 \u001b[22m     m = (tt > ts[k] - HALF) & (tt < ts[k] + HALF)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 37 \u001b[22m     tt, fi = tt[m], fi[m]\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;231m\u001b[2m8\u001b[16G\u001b[22mid\u001b[19G= \u001b[38;5;141m0.5\u001b[25G\u001b[38;5;231m* (f[k - \u001b[38;5;141m1\u001b[38;5;231m] +\u001b[39Gf[k])\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;246m...\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m59\u001b[11G\u001b[22mph\u001b[14G= np.unwrap(np.angle(hilbert(sosfiltfilt(sos, seg))))\r\u001b[5C\u001b[1B\u001b[2m 60 \u001b[22m fi = np.gradient(ph) * FS / (\u001b[38;5;141m2\u001b[38;5;231m * np.pi)\r\u001b[6C\u001b[1B\u001b[2m61\u001b[11G\u001b[22mn = \u001b[38;5;148mint\u001b[38;5;231m(FS); c = np.cumsum(np.r_[\u001b[38;5;141m0\u001b[38;5;231m, fi]); fi = (c[n:] - c[:-n]) / n\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 62 -\u001b[38;5;231mtt = np.arange(i0, i1 - n) / FS + OFF + n / (2 * FS)                                                   \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 62 +\u001b[38;5;231mtt = \u001b[48;5;28m(\u001b[48;5;22mnp.arange(\u001b[38;5;148m\u001b[48;5;28mlen\u001b[38;5;231m(fi))\u001b[48;5;22m \u001b[48;5;28m+\u001b[48;5;22m \u001b[48;5;28mi0\u001b[48;5;22m) / FS + OFF + n / (\u001b[38;5;141m2\u001b[38;5;231m * FS)                                               \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 63 \u001b[22m \u001b[38;5;148mprint\u001b[38;5;231m(\u001b[38;5;186mf\"\\ninstantaneous drive frequency across the boundary steps.csv says is at \u001b[38;5;231m{ts[k]:\u001b[38;5;141m.1\u001b[38;5;231mf}\u001b[38;5;186m s\"\u001b[38;5;231m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 64 \u001b[22m \u001b[38;5;148mprint\u001b[38;5;231m(\u001b[38;5;186mf\"  analyst \u001b[38;5;231m{ta[k]-ts[k]:+\u001b[38;5;141m.2\u001b[38;5;231mf}\u001b[38;5;186m s, verifier \u001b[38;5;231m{tv[k]-ts[k]:+\u001b[38;5;141m.2\u001b[38;5;231mf}\u001b[38;5;186m s, measured \u001b[38;5;231m{meas[k]-ts[k]:+\u001b[38;5;141m.3\u001b[38;5;231mf}\u001b[38;5;186m s\"\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m  \u001b[11G\u001b[22m)\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;231m\u001b[2m5\u001b[11G\u001b[22m\u001b[38;5;197mfor\u001b[38;5;231m off \u001b[38;5;197min\u001b[38;5;231m (-\u001b[38;5;141m10\u001b[38;5;231m, -\u001b[38;5;141m8\u001b[38;5;231m, -\u001b[38;5;141m6.3\u001b[38;5;231m, -\u001b[38;5;141m4\u001b[38;5;231m, -\u001b[38;5;141m2\u001b[38;5;231m, -\u001b[38;5;141m0.5\u001b[38;5;231m, \u001b[38;5;141m0\u001b[38;5;231m, +\u001b[38;5;141m0.5\u001b[38;5;231m, +\u001b[38;5;141m2\u001b[38;5;231m, +\u001b[38;5;141m4\u001b[38;5;231m, +\u001b[38;5;141m8\u001b[38;5;231m)\u001b[73G\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Allowed by auto mode\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[39m\u001b[K\u001b[33;1H\u001b[31;3H\u001b[?25h"]
