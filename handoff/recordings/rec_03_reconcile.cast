[189.468586, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[19BStack the\u001b[13Gheater pulse on\u001b[29Gquiet\u001b[35Gwindows\r\u001b[2C\u001b[7B\u001b[38;5;216mHerding\u2026\u001b[25G\u001b[38;5;246m4\u001b[27G6\u001b[39m\u001b[33;1H\u001b[31;3H\u001b[?25h"]
