[477.245634, "o", "\u001b[?25l\u001b[H     \u001b[38;5;77m\u001b[48;5;22m 35 +\u001b[38;5;231m    tt = \u001b[48;5;28m(\u001b[48;5;22mnp.arange(\u001b[38;5;148m\u001b[48;5;28mlen\u001b[38;5;231m(fi))\u001b[48;5;22m \u001b[48;5;28m+\u001b[48;5;22m \u001b[48;5;28mi0\u001b[48;5;22m) / FS + OFF + n / (\u001b[38;5;141m2\u001b[38;5;231m * FS)                                           \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m6\u001b[15G\u001b[22mm = (tt > ts[k] - HALF) &\u001b[41G(tt < ts[k] + HALF)\r\u001b[7C\u001b[1B\u001b[2m7\u001b[15G\u001b[22mtt,\u001b[19Gfi = tt[m], fi[m]\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;231m\u001b[2m8\u001b[15G\u001b[22mmid\u001b[19G= \u001b[38;5;141m0.5\u001b[38;5;231m * (f[k - \u001b[38;5;141m1\u001b[38;5;231m] + f[k])\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;246m...\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 59 \u001b[22m ph = np.unwrap(np.angle(hilbert(sosfiltfilt(sos, seg))))\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m60\u001b[11G\u001b[22mfi\u001b[14G= np.gradient(ph) * FS /\u001b[39G(\u001b[38;5;141m2\u001b[38;5;231m * np.pi)\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m61\u001b[11G\u001b[22mn\u001b[13G=\u001b[15G\u001b[38;5;148mint\u001b[38;5;231m(FS);\u001b[24Gc = np.cumsum(np.r_[\u001b[38;5;141m0\u001b[38;5;231m, fi]); fi = (c[n:] - c[:-n]) / n\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 62 -\u001b[38;5;231mtt = np.arange(i0, i1 - n) / FS + OFF + n / (2 * FS)                                                   \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 62 +\u001b[38;5;231mtt = \u001b[48;5;28m(\u001b[48;5;22mnp.arange(\u001b[38;5;148m\u001b[48;5;28mlen\u001b[38;5;231m(fi))\u001b[48;5;22m \u001b[48;5;28m+\u001b[48;5;22m \u001b[48;5;28mi0\u001b[48;5;22m) / FS + OFF + n / (\u001b[38;5;141m2\u001b[38;5;231m * FS)                                               \r\u001b[6C\u001b[1B\u001b[49m\u001b[2m63\u001b[11G\u001b[22m\u001b[38;5;148mprint\u001b[38;5;231m(\u001b[38;5;186mf\"\\ninstantaneous drive frequency across the boundary steps.csv says is at \u001b[38;5;231m{ts[k]:\u001b[38;5;141m.1\u001b[38;5;231mf}\u001b[38;5;186m s\"\u001b[38;5;231m)\r\u001b[7C\u001b[1B\u001b[2m4\u001b[11G\u001b[22m\u001b[38;5;148mprint\u001b[38;5;231m(\u001b[38;5;186mf\"  analyst \u001b[38;5;231m{ta[k]-ts[k]:+\u001b[38;5;141m.2\u001b[38;5;231mf}\u001b[38;5;186m s, verifier \u001b[38;5;231m{tv[k]-ts[k]:+\u001b[38;5;141m.2\u001b[38;5;231mf}\u001b[38;5;186m s, measured \u001b[38;5;231m{meas[k]-ts[k]:+\u001b[38;5;141m.3\u001b[38;5;231mf}\u001b[38;5;186m s\"\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m  \u001b[11G\u001b[22m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 65 \u001b[22m \u001b[38;5;197mfor\u001b[38;5;231m off \u001b[38;5;197min\u001b[38;5;231m (-\u001b[38;5;141m10\u001b[38;5;231m, -\u001b[38;5;141m8\u001b[38;5;231m, -\u001b[38;5;141m6.3\u001b[38;5;231m, -\u001b[38;5;141m4\u001b[38;5;231m, -\u001b[38;5;141m2\u001b[38;5;231m, -\u001b[38;5;141m0.5\u001b[38;5;231m, \u001b[38;5;141m0\u001b[38;5;231m, +\u001b[38;5;141m0.5\u001b[38;5;231m, +\u001b[38;5;141m2\u001b[38;5;231m, +\u001b[38;5;141m4\u001b[38;5;231m, +\u001b[38;5;141m8\u001b[38;5;231m):\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Allowed by auto mode\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mBoth my earlier boundary attempts were void. This one is internally consistent (250.0003 s spacing, \u03c3 37 ms) and\r\u001b[2C\u001b[1Breverses the\u001b[16Ganswer.\u001b[24GNow\u001b[28Gbuilding\u001b[37Gthe\u001b[41Gcomparison\u001b[52Gtable:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m\u25cf\u001b[39m Reading \u001b[1m1\u001b[22m file\u2026\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf  $ cat > reconcile/mk_comparison.py <<'EOF'\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;246m#!/usr/bin/env python3\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;246m\"\"\"Build results/comparison.csv: analyst against verifier, one row per quantity.\r\u001b[5C\u001b[1BNumbers are read from the two nodes' own files rather than transcribed, so the table cannot drift\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;246mfrom what the nodes actually produced. The resolution \u2026\r\u001b[12C\u001b[2BChecking\u001b[22Gfilesystem traversal scope\u2026 \u00b7 8m 14s \u00b7 \u2193\u001b[63G33.2k tokens)\u001b[39m\u001b[33;1H\u001b[31;3H\u001b[?25h"]
