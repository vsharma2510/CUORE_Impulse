[370.864852, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;77m\u001b[48;5;22m7\u001b[15G\u001b[38;5;197mreturn\u001b[38;5;231m tt[nw // \u001b[38;5;141m2\u001b[38;5;231m: nw // \u001b[38;5;141m2\u001b[38;5;231m + \u001b[38;5;148mlen\u001b[38;5;231m(c) - nw - \u001b[38;5;141m1\u001b[38;5;231m], np.\u001b[38;5;148mabs\u001b[38;5;231m(c[nw:-\u001b[38;5;141m1\u001b[38;5;231m] - c[:-nw - \u001b[38;5;141m1\u001b[38;5;231m]) / nw                 \r\u001b[7C\u001b[1B\u001b[38;5;77m8\u001b[15G\u001b[38;5;231m  \u001b[18G \u001b[20G             \u001b[34G   \u001b[38G \u001b[40G  \u001b[43G \u001b[45G   \r\u001b[7C\u001b[1B\u001b[38;5;77m9\u001b[15G\u001b[38;5;231m \u001b[17G \u001b[19G   \u001b[23G \u001b[25G                                                                                         \r\u001b[6C\u001b[1B\u001b[38;5;77m30\u001b[11G\u001b[38;5;231mmeas =\u001b[18G[]                                                                                              \r\u001b[6C\u001b[1B\u001b[38;5;77m31\u001b[11G\u001b[38;5;197mfor\u001b[38;5;231m k \u001b[38;5;197min\u001b[38;5;231m \u001b[38;5;148mrange\u001b[38;5;231m(\u001b[38;5;141m1\u001b[38;5;231m, \u001b[38;5;148mlen\u001b[38;5;231m(f)):\u001b[38G   \r\u001b[6C\u001b[1B\u001b[38;5;77m32\u001b[15G\u001b[38;5;231mi0, i1 = \u001b[38;5;148mint\u001b[38;5;231m((ts[k] -\u001b[37G\u001b[38;5;141m20\u001b[40G\u001b[38;5;231m-\u001b[42GOFF) * FS), \u001b[38;5;148mint\u001b[38;5;231m((ts[k] + \u001b[38;5;141m20\u001b[38;5;231m - OFF) * FS)    \u001b[87G \u001b[89G   \u001b[93G \u001b[95G  \r\u001b[6C\u001b[1B\u001b[38;5;77m33\u001b[15G\u001b[38;5;197mif\u001b[38;5;231m i0 < \u001b[38;5;141m0\u001b[38;5;231m \u001b[38;5;197mor\u001b[38;5;231m i1 > \u001b[38;5;148mlen\u001b[38;5;231m(x):                                                                          \r\u001b[6C\u001b[1B\u001b[38;5;77m34\u001b[19G\u001b[38;5;231mmeas.append(np.nan);\u001b[40G\u001b[38;5;197mcontinue\u001b[38;5;231m                                                                  \r\u001b[7C\u001b[1B\u001b[38;5;77m5\u001b[11G\u001b[38;5;231m    tc, e_old\u001b[25G=\u001b[27Genv(f[k\u001b[35G-\u001b[37G\u001b[38;5;141m1\u001b[38;5;231m], i0, i1)                                                                  \r\u001b[7C\u001b[1B\u001b[38;5;77m6\u001b[11G\u001b[38;5;231m    _, e_new = env(f[k], i0, i1)                                                                       \r\u001b[7C\u001b[1B\u001b[38;5;77m7\u001b[15G\u001b[38;5;231md =\u001b[19Ge_new - e_old                                                                                  \r\u001b[7C\u001b[1B\u001b[38;5;77m8\u001b[15G\u001b[38;5;231ms = np.where(np.diff(np.sign(d)) > \u001b[38;5;141m0\u001b[38;5;231m)[\u001b[38;5;141m0\u001b[38;5;231m]\r\u001b[7C\u001b[1B\u001b[38;5;77m9\u001b[15G\u001b[38;5;231mmeas.append(tc[s[np.\u001b[36Grgmin(np.\u001b[38;5;148mabs\u001b[38;5;231m(tc[s]\u001b[55G-\u001b[57Gts[k]))]]\u001b[67G\u001b[38;5;197mif\u001b[70G\u001b[38;5;148mlen\u001b[38;5;231m(s)\u001b[77G\u001b[38;5;197melse\u001b[82G\u001b[38;5;231mnp.nan)\r\u001b[6C\u001b[1B\u001b[38;5;77m40\u001b[11G\u001b[38;5;231mmeas = np.array(meas)  \u001b[35G \u001b[37G                                                                             \r\u001b[5C\u001b[1B\u001b[49m\u001b[38;5;246m\u2026 20 more lines \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Allowed by auto mode\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mMy\u001b[6Genvelope test couldn't resolve 0.1 Hz in 0.5 s \u2014 wrong tool. Using instantaneous phase instead:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\r\u001b[4C\u001b[1B\u001b[38;5;246m $ cat >\u001b[14Greconcile/r6c_instfreq.py <<'EOF'\r\u001b[5C\u001b[1B#!/usr/bin/env python3\r\u001b[1B\u001b[39m \u001b[3G  \u001b[6G\u001b[38;5;246m\"\"\"R6c: locate the step boundaries from the INSTANTANEOUS FREQUENCY of the force channel.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;246mr6/r6b used a 0.5 s boxcar lock-in, which cannot separate 4.4 from 4.5 Hz: its frequency resolution\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;246mis ~2 Hz, so both envelopes were equal and t\u2026\r\u001b[12C\u001b[2BChecking\u001b[22Gfilesystem traversal scope\u2026 \u00b7 6m 28s \u00b7 \u2193\u001b[63G26.8k tokens)\u001b[39m\u001b[33;1H\u001b[31;3H\u001b[?25h"]
[370.928461, "o", "\u001b[?25l\u001b[H\r\u001b[26B\u001b[38;5;174m\u00b7\u001b[39m\u001b[33;1H\u001b[31;3H\u001b[?25h"]
