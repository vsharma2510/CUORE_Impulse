[249.04852, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;5;77m\u001b[48;5;22m1\u001b[11G\u001b[38;5;231mtp\u001b[14G=\u001b[16Gnp.load(\u001b[38;5;186m\"data/pulser_times.npy\"\u001b[38;5;231m)\r\u001b[6C\u001b[1B\u001b[38;5;77m1\u001b[11G\u001b[38;5;231mBOLO\u001b[16G=\u001b[18G[\u001b[38;5;186mf\"ch\u001b[38;5;231m{c:04d}\u001b[38;5;186m\"\u001b[38;5;231m \u001b[38;5;197mfor\u001b[36G\u001b[38;5;231mc\u001b[38G\u001b[38;5;197min\u001b[41G\u001b[38;5;148mrange\u001b[38;5;231m(\u001b[38;5;141m937\u001b[38;5;231m,\u001b[52G\u001b[38;5;141m989\u001b[38;5;231m)]\r\u001b[6C\u001b[1B\u001b[38;5;77m2\u001b[11G\u001b[38;5;231mn\u001b[13G=\u001b[15G\u001b[38;5;148mint\u001b[38;5;231m((PRE + POST) * FS)  \u001b[40G \u001b[42G \u001b[44G \u001b[46G    \u001b[51G \u001b[53G    \r\u001b[6C\u001b[1B\u001b[38;5;77m2\u001b[11G\u001b[38;5;231mt\u001b[13G=\u001b[15Gnp.arange(n) / FS - PRE                                                                            \r\u001b[6C\u001b[1B\u001b[38;5;77m2\u001b[11G\u001b[38;5;231mFIT\u001b[15G=\u001b[17G((t\u001b[21G>=\u001b[24G-\u001b[38;5;141m2.0\u001b[38;5;231m) & (t <=\u001b[38G-\u001b[38;5;141m0.3\u001b[38;5;231m))\u001b[45G|\u001b[47G((t\u001b[51G>=\u001b[54G\u001b[38;5;141m6.0\u001b[38;5;231m)\u001b[59G&\u001b[61G(t\u001b[64G<=\u001b[67G\u001b[38;5;141m7.5\u001b[38;5;231m))\r\u001b[6C\u001b[1B\u001b[38;5;77m2\u001b[11G\u001b[38;5;231mV\u001b[13G=\u001b[15Gnp.vander(t, \u001b[38;5;141m2\u001b[38;5;231m)                                        \u001b[38;5;242m# linear detrend basis\u001b[38;5;231m                      \r\u001b[6C\u001b[1B\u001b[38;5;77m2\u001b[23G\u001b[38;5;231m \u001b[25G  \u001b[28G                                                                                      \r\u001b[6C\u001b[1B\u001b[38;5;77m2\u001b[23G\u001b[38;5;231m  \u001b[26G  \u001b[29G  \u001b[32G \u001b[34G  \u001b[37G                                                                             \r\u001b[6C\u001b[1B\u001b[38;5;77m2\u001b[11G\u001b[38;5;81mdef\u001b[38;5;231m \u001b[38;5;148mstack\u001b[38;5;231m(\u001b[38;5;208mlabel, a, b, times\u001b[38;5;231m):\r\u001b[6C\u001b[1B\u001b[38;5;77m2\u001b[15G\u001b[38;5;231macc\u001b[19G=\u001b[21Gnp.zeros(n); nch\u001b[38G= \u001b[38;5;141m0\u001b[38;5;231m     \r\u001b[6C\u001b[1B\u001b[38;5;77m2\u001b[15G\u001b[38;5;197mfor\u001b[38;5;231m name \u001b[38;5;197min\u001b[38;5;231m BOLO:                                                                                  \r\u001b[6C\u001b[1B\u001b[38;5;77m2\u001b[15G\u001b[38;5;231m \u001b[17G \u001b[19Gx = np.load(\u001b[38;5;186mf\"data/arrays/\u001b[38;5;231m{label}\u001b[38;5;186m/bolo/\u001b[38;5;231m{name}\u001b[38;5;186m.npy\"\u001b[38;5;231m, mmap_mode=\u001b[38;5;186m\"r\"\u001b[38;5;231m)                             \r\u001b[6C\u001b[1B\u001b[38;5;77m3\u001b[15G\u001b[38;5;231m   \u001b[19Gst = np.zeros(n); m = \u001b[38;5;141m0\r\u001b[5C\u001b[1B\u001b[38;5;77m 31 +\u001b[38;5;231m        \u001b[38;5;197mfor\u001b[38;5;231m tt \u001b[38;5;197min\u001b[38;5;231m times:                                                                               \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;5;77m\u001b[48;5;22m 32 +\u001b[38;5;231m            i = \u001b[38;5;148mint\u001b[38;5;231m(\u001b[38;5;148mround\u001b[38;5;231m((tt - a - PRE) * FS))                                                        \r\u001b[5C\u001b[1B\u001b[38;5;77m 33 +\u001b[38;5;231m            \u001b[38;5;197mif\u001b[38;5;231m i < \u001b[38;5;141m0\u001b[38;5;231m \u001b[38;5;197mor\u001b[38;5;231m i + n > \u001b[38;5;148mlen\u001b[38;5;231m(x):                                                                \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G  \u001b[6G\u001b[38;5;77m\u001b[48;5;22m 34 +\u001b[38;5;231m                \u001b[38;5;197mcontinue\u001b[38;5;231m                                                                               \r\u001b[5C\u001b[1B\u001b[38;5;77m 35 +\u001b[38;5;231m            s = np.asarray(x[i:i + n], dtype=np.float64)                                               \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;77m\u001b[48;5;22m 36 +\u001b[38;5;231m            c, *_ = np.linalg.lstsq(V[FIT], s[FIT], rcond=\u001b[38;5;141mNone\u001b[38;5;231m)                                        \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;5;77m\u001b[48;5;22m 37 +\u001b[38;5;231m            st += s - V @ c                                                                            \r\u001b[5C\u001b[1B\u001b[38;5;77m 38 +\u001b[38;5;231m            m += \u001b[38;5;141m1\u001b[38;5;231m                                                                                     \r\u001b[5C\u001b[1B\u001b[38;5;77m 39 +\u001b[38;5;231m        \u001b[38;5;197mif\u001b[38;5;231m m:                                                                                          \r\u001b[5C\u001b[1B\u001b[38;5;77m 40 +\u001b[38;5;231m            acc += st / m; nch += \u001b[38;5;141m1\u001b[38;5;231m                                                                    \r\u001b[5C\u001b[1B\u001b[49m\u001b[38;5;246m\u2026 24 more lines \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Allowed\u001b[14Gby auto mode\u001b[39m\u001b[K\u001b[33;1H\u001b[31;3H\u001b[?25h"]
