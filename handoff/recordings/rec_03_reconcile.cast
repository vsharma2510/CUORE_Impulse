[106.848898, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;5;77m\u001b[48;5;22m18\u001b[11G\u001b[38;5;231mbolo\u001b[16G=\u001b[18Gamp[k\u001b[24Gnd\u001b[28G= \u001b[38;5;186m\"bolo\"\u001b[38;5;231m]                                 \r\u001b[6C\u001b[1B\u001b[38;5;77m19\u001b[11G\u001b[38;5;231mi1112 = \u001b[38;5;148mint\u001b[38;5;231m(np.where(ch == \u001b[38;5;141m1112\u001b[38;5;231m)[\u001b[38;5;141m0\u001b[38;5;231m][\u001b[38;5;141m0\u001b[38;5;231m])     \r\u001b[6C\u001b[1B\u001b[38;5;77m20\u001b[11G\u001b[38;5;231ma1112 = amp[i1112]                                                                                     \r\u001b[6C\u001b[1B\u001b[38;5;77m21\u001b[15G\u001b[38;5;231m                                                                                                   \r\u001b[5C\u001b[1B\u001b[38;5;77m 22 +\u001b[38;5;231mmed = np.median(bolo, \u001b[38;5;141m0\u001b[38;5;231m)                                                                               \r\u001b[5C\u001b[1B\u001b[38;5;77m 23 +\u001b[38;5;231mH_1111 = med / force                                                                                   \r\u001b[5C\u001b[1B\u001b[38;5;77m 24 +\u001b[38;5;231mH_1112 = med / a1112                                                                                   \r\u001b[5C\u001b[1B\u001b[38;5;77m 25 +\u001b[38;5;231m                                                                                                       \r\u001b[5C\u001b[1B\u001b[38;5;77m 26 +\u001b[38;5;231m                                                                                                       \r\u001b[5C\u001b[1B\u001b[38;5;77m 27 +\u001b[38;5;81mdef\u001b[38;5;231m \u001b[38;5;148mjump\u001b[38;5;231m(\u001b[38;5;208mx, i\u001b[38;5;231m):                                                                                        \r\u001b[5C\u001b[1B\u001b[38;5;77m 28 +\u001b[38;5;231m    \u001b[38;5;197mreturn\u001b[38;5;231m x[i + \u001b[38;5;141m1\u001b[38;5;231m] / x[i]                                                                             \r\u001b[6C\u001b[1B\u001b[38;5;77m29\u001b[15G\u001b[38;5;231m                                                                                        \r\u001b[5C\u001b[1B\u001b[38;5;77m 30 +\u001b[38;5;231m                                                                                                       \r\u001b[5C\u001b[1B\u001b[38;5;77m 31 +\u001b[38;5;197mfor\u001b[38;5;231m fb \u001b[38;5;197min\u001b[38;5;231m (\u001b[38;5;141m5.4\u001b[38;5;231m, \u001b[38;5;141m7.4\u001b[38;5;231m):                                                                                  \r\u001b[5C\u001b[1B\u001b[38;5;77m 32 +\u001b[38;5;231m    i = \u001b[38;5;148mint\u001b[38;5;231m(np.argmin(np.\u001b[38;5;148mabs\u001b[38;5;231m(f - fb)))                                                                 \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;5;77m\u001b[48;5;22m 33 +\u001b[38;5;231m    \u001b[38;5;148mprint\u001b[38;5;231m(\u001b[38;5;186mf\"\\n=== boundary \u001b[38;5;231m{f[i]:\u001b[38;5;141m.2\u001b[38;5;231mf}\u001b[38;5;186m -> \u001b[38;5;231m{f[i+\u001b[38;5;141m1\u001b[38;5;231m]:\u001b[38;5;141m.2\u001b[38;5;231mf}\u001b[38;5;186m Hz  (steps \u001b[38;5;231m{i}\u001b[38;5;186m -> \u001b[38;5;231m{i+\u001b[38;5;141m1\u001b[38;5;231m}\u001b[38;5;186m)\"\u001b[38;5;231m)                       \r\u001b[5C\u001b[1B\u001b[38;5;77m 34 +\u001b[38;5;231m    \u001b[38;5;148mprint\u001b[38;5;231m(\u001b[38;5;186mf\"  ch1111 force tone        \u001b[38;5;231m{force[i]:\u001b[38;5;141m9.2\u001b[38;5;231mf}\u001b[38;5;186m -> \u001b[38;5;231m{force[i+\u001b[38;5;141m1\u001b[38;5;231m]:\u001b[38;5;141m9.2\u001b[38;5;231mf}\u001b[38;5;186m mV   x\u001b[38;5;231m{jump(force,i):\u001b[38;5;141m.3\u001b[38;5;231mf}\u001b[38;5;186m\"\u001b[38;5;231m)\r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;77m\u001b[48;5;22m 35 +\u001b[38;5;231m    \u001b[38;5;148mprint\u001b[38;5;231m(\u001b[38;5;186mf\"  ch1112 shaker accel      \u001b[38;5;231m{a1112[i]:\u001b[38;5;141m9.2\u001b[38;5;231mf}\u001b[38;5;186m -> \u001b[38;5;231m{a1112[i+\u001b[38;5;141m1\u001b[38;5;231m]:\u001b[38;5;141m9.2\u001b[38;5;231mf}\u001b[38;5;186m mV   x\u001b[38;5;231m{jump(a1112,i):\u001b[38;5;141m.3\u001b[38;5;231mf}\u001b[38;5;186m\"\u001b[38;5;231m)\r\u001b[5C\u001b[1B\u001b[38;5;77m 36 +\u001b[38;5;231m    \u001b[38;5;148mprint\u001b[38;5;231m(\u001b[38;5;186mf\"  bolometer median tone    \u001b[38;5;231m{med[i]:\u001b[38;5;141m9.4\u001b[38;5;231mf}\u001b[38;5;186m -> \u001b[38;5;231m{med[i+\u001b[38;5;141m1\u001b[38;5;231m]:\u001b[38;5;141m9.4\u001b[38;5;231mf}\u001b[38;5;186m mV   x\u001b[38;5;231m{jump(med,i):\u001b[38;5;141m.3\u001b[38;5;231mf}\u001b[38;5;186m\"\u001b[38;5;231m)      \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;77m\u001b[48;5;22m 37 +\u001b[38;5;231m    \u001b[38;5;148mprint\u001b[38;5;231m(\u001b[38;5;186mf\"  |H| ref ch1111                                            x\u001b[38;5;231m{jump(H_1111,i):\u001b[38;5;141m.3\u001b[38;5;231mf}\u001b[38;5;186m\"\u001b[38;5;231m)        \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;5;77m\u001b[48;5;22m 38 +\u001b[38;5;231m    \u001b[38;5;148mprint\u001b[38;5;231m(\u001b[38;5;1"]
[106.849062, "o", "86mf\"  |H| ref ch1112  (independent)                             x\u001b[38;5;231m{jump(H_1112,i):\u001b[38;5;141m.3\u001b[38;5;231mf}\u001b[38;5;186m\"\u001b[38;5;231m)        \r\u001b[5C\u001b[1B\u001b[38;5;77m 39 +\u001b[38;5;231m                                                                                                       \r\u001b[5C\u001b[1B\u001b[38;5;77m 40 +\u001b[38;5;242m# how unusual is each jump against the ordinary step-to-step scatter of the same quantity?\u001b[38;5;231m             \r\u001b[5C\u001b[1B\u001b[49m\u001b[38;5;246m\u2026 13 more lines \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Allowed by auto mo\u001b[25Ge\u001b[39m\u001b[K\u001b[33;1H\u001b[31;3H\u001b[?25h"]
