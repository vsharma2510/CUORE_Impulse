1b[38;5;231m\u001b[1mindependently and matched at 0.037 Hz, but it sits on the 7.45 Hz boundary where the two drive monitors disagree by a \r\u001b[1B\u001b[22m\u001b[39m\u001b[2m\u2502\u001b[3G\u001b[22m\u001b[38;5;231m\u001b[1mfactor 5, and it has the weakest per-channel support of any agreed mode (4 of 52). How should the headline list treat \r\u001b[1B\u001b[22m\u001b[39m\u001b[2m\u2502\u001b[3G\u001b[22m\u001b[38;5;231m\u001b[1mit?\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;153m\u276f\u001b[38;5;246m 1.\u001b[38;5;153m\u001b[1m Demote it \u2014 11 modes \u001b[22m\u001b[39m        \u001b[38;5;246m\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[39m\u001b[K\r\u001b[4C\u001b[1B\u001b[38;5;153m\u001b[1m(Recommended)\u001b[22m\u001b[39m    \u001b[35G\u001b[38;5;246m\u2502 \u001b[39mHEADLINE\u001b[46G(11)\u001b[38;5;246m                            \u2502\r\u001b[1B\u001b[39m \u001b[3G\u001b[38;5;246m2.\u001b[39m Keep it, flagged \u2014 12\u001b[35G\u001b[38;5;246m\u2502 \u001b[39G\u001b[39m3.02\u001b[45G3.42\u001b[51G3.96\u001b[57G4.89\u001b[63G5.35\u001b[38;5;246m           \u2502\r\u001b[4C\u001b[1B\u001b[39mmodes\u001b[35G\u001b[38;5;246m\u2502 \u001b[39G\u001b[39m6.22*\u001b[45G7.92*\u001b[51G8.13\u001b[57G8.17\u001b[63G8.53*\u001b[69G8.79\u001b[38;5;246m     \u2502\r\u001b[1C\u001b[1B 3.\u001b[39m Two-tier, no single\u001b[35G\u001b[38;5;246m\u2502 \u001b[45G\u001b[39m*\u001b[47Gverifier-only,\u001b[62GERA\u001b[66Gmissed\u001b[38;5;246m      \u2502\r\u001b[4C\u001b[1B\u001b[39mnumber\u001b[35G\u001b[38;5;246m\u2502                                          \u2502\r\u001b[1B\u001b[39m \u001b[3G   \u001b[7G              \u001b[22G  \u001b[25G    \u001b[30G   \u001b[34G \u001b[38;5;246m\u2502 \u001b[39mTENTATIVE (2)   7.46\u001b[58G 8.29\u001b[38;5;246m               \u2502\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[7G      \u001b[14G       \u001b[22G  \u001b[25G    \u001b[30G     \u001b[38;5;246m\u2502 \u001b[39mWITHDRAWN\u001b[47G(2)\u001b[53G2.53\u001b[59G5.49\u001b[38;5;246m               \u2502\r\u001b[34C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B                                  \u001b[38;5;153mNotes:\u001b[39m \u001b[38;5;246mpress\u001b[48Gn to a\u001b[55Gd notes\u001b[39m\u001b[K\r\u001b[80C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1B\u001b[39m  Chat\u001b[8Gabout\u001b[14Gthis\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246mEnter to select \u00b7\u001b[19G\u2191/\u2193 to n\u001b[28Gvigate \u00b7 n to\u001b[42Gadd\u001b[46Gn\u001b[48Gtes \u00b7 Tab to switch questions \u00b7 Esc to cancel\u001b[39m\u001b[33;1H"]
