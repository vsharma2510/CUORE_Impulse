[801.932889, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;231m\u001b[2m 81 \u001b[22m     \u001b[38;5;197mif\u001b[38;5;231m \u001b[38;5;148mlen\u001b[38;5;231m(fs):\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 82 -\u001b[38;5;231m        bx.plot(fs, np.full(len(fs), 2.0e-3), clip_on=False, ls=\"none\", **kw)                          \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;5;77m\u001b[48;5;22m 82 +\u001b[38;5;231m        bx.plot(fs, np.full(\u001b[38;5;148mlen\u001b[38;5;231m(fs), \u001b[38;5;141m\u001b[48;5;28m3\u001b[48;5;22m.0e-\u001b[48;5;28m5\u001b[38;5;231m\u001b[48;5;22m), clip_on=\u001b[38;5;141mFalse\u001b[38;5;231m, ls=\u001b[38;5;186m\"none\"\u001b[38;5;231m, **kw)                          \r\u001b[6C\u001b[1B\u001b[49m\u001b[2m83\r\u001b[7C\u001b[1B4\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;231m\u001b[2m5\u001b[11G\u001b[22mmark([x \u001b[38;5;197mfor\u001b[38;5;231m x \u001b[38;5;197min\u001b[38;5;231m head \u001b[38;5;197mif\u001b[38;5;231m x \u001b[38;5;197mnot\u001b[38;5;231m \u001b[38;5;197min\u001b[38;5;231m vonly], marker=\u001b[38;5;186m\"v\"\u001b[38;5;231m, ms=ps.ctx()[\u001b[38;5;186m\"ms\"\u001b[38;5;231m] * \u001b[38;5;141m0.85\u001b[38;5;231m,\r\u001b[5C\u001b[1B\u001b[38;5;246m...\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 92 \u001b[22m      label=\u001b[38;5;186mf\"withdrawn (\u001b[38;5;231m{\u001b[38;5;148mlen\u001b[38;5;231m(draw)}\u001b[38;5;186m)\"\u001b[38;5;231m)\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m9\r\u001b[6C\u001b[1B9\u001b[11G\u001b[22mbx.set_xlim(\u001b[38;5;141m2.5\u001b[38;5;231m, \u001b[38;5;141m9.5\u001b[38;5;231m)\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 95 -\u001b[38;5;231mbx.set_ylim(2e-3, 2e-1)                                                                                \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 95 +\u001b[38;5;231mbx.set_ylim(\u001b[38;5;141m\u001b[48;5;28m3e\u001b[48;5;22m-\u001b[48;5;28m5\u001b[38;5;231m\u001b[48;5;22m, \u001b[38;5;141m\u001b[48;5;28m3e\u001b[48;5;22m-\u001b[48;5;28m2\u001b[38;5;231m\u001b[48;5;22m)                                                                                \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m6\u001b[11G\u001b[22mps.style_axes(bx, \u001b[38;5;186m\"Bolometer response to the shaker\"\u001b[38;5;231m,\r\u001b[7C\u001b[1B\u001b[2m7\u001b[11G\u001b[22m              \u001b[38;5;186m\"drive frequency (Hz)\"\u001b[38;5;231m, \u001b[38;5;186m\"|H| = bolometer / force (mV/mV)\"\u001b[38;5;231m)\r\u001b[7C\u001b[1B\u001b[2m8\u001b[14G\u001b[22ml\u001b[16Ggend(prop={\u001b[38;5;186m\"family\"\u001b[38;5;231m: ps.MONO_FONTS, \u001b[38;5;186m\"size\"\u001b[38;5;231m: ps.ctx()[\u001b[38;5;186m\"note\"\u001b[38;5;231m] - \u001b[38;5;141m0.7\u001b[38;5;231m}, handlelength=\u001b[38;5;141m1.1\u001b[38;5;231m,\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u2026 2 more files changed\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Allowed by auto mode\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m\u25cf\u001b[3G\u001b[39mReading results/fig_pilot.png\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf  $ python3 - <<'EOF'\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;246mp=\"reconcile/mk_figure.py\"; s=open(p).read()\r\u001b[1B\u001b[39m     \u001b[38;5;246ms=s.r\u001b[12Gplace(\"ax.set_ylim(-0.6, len(cats) - 0.4)\",\"ax.set_ylim(-0.6, len(cats) + 0.05)\")\r\u001b[5C\u001b[1Bs=s.replace('np.full(len(fs), 3.0e-5)','np.full(len(fs), 2.4e-5)')\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;246ms=s.replace('bx.set_ylim(3e-5, 3e-2)','bx.set_ylim(1.1e-5, 3e-2)')\r\u001b[1B\u001b[39m     \u001b[38;5;246ms=\u001b[9G.replace(\u2026\u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;174m\u00b7\u001b[39m\u001b[33;1H\u001b[31;3H\u001b[?25h"]
