requency\u001b[53G\u001b[38;5;153mf_new\u001b[59G\u001b[39mmay\u001b[63Gexist\u001b[69Gbefore\u001b[76G\u001b[38;5;153mf_new\u001b[82G\u001b[39mis\u001b[85Gswitched\u001b[94Gon.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BAnd\u001b[7Git\u001b[10Gnames\u001b[16Gthree\u001b[22Gadversaries\u001b[34Gthe\u001b[38Gnode\u001b[43Gmust\u001b[48Gaddress,\u001b[57Gnot\u001b[61Gjust\u001b[66Gthe\u001b[70Gratio:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mMeasured boundaries, not assumed ones\u001b[44G\u001b[22m\u2014\u001b[46Ga\u001b[48Gpre-response\u001b[61Gsmaller\u001b[69Gthan\u001b[74Gthe\u001b[78Gboundary\u001b[87Guncertainty\u001b[99Gis\u001b[102Ga\u001b[104Gtiming\u001b[111Gerror,\u001b[118Gnot\r\u001b[2C\u001b[1B  \u001b[6Gacausality. I handed it the r6c measurement: spacing 250.0003 s at \u03c3 37\u001b[78Gms, \u001b[38;5;153msteps.csv\u001b[39m l\u001b[94Gte by 5.986 s, and its own\u001b[K\r\u001b[5C\u001b[1Bfirst-run bound\u001b[22Gri\u001b[25Gs\u001b[27Gearly by 0.434 s.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mSpectral leakage mimics acausality\u001b[22m \u2014 a\u001b[45Gfinite\u001b[52Gwindow\u001b[59Gat\u001b[62G\u001b[38;5;153mf_old\u001b[68G\u001b[39mleaks\u001b[74Ginto\u001b[79G\u001b[38;5;153mf_new\u001b[85G\u001b[39monly\u001b[90G0.1\u001b[94GHz\u001b[97Gaway.\u001b[103GUnquantified,\u001b[117Gthe\r\u001b[2C\u001b[1B  \u001b[6Gratio is uninterpretable. I flagged this \u001b[76G's\u001b[79Gthe most likely re\u001b[98Gson the tes\u001b[110G comes\u001b[117Gback\u001b[33;1H\u001b[28;3H\u001b[?25h"]
[505.488914, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mRecording,\u001b[14Gspec\u001b[19Gamended,\u001b[28Ganalyst\u001b[36Gdispatched.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSPEC \u00a74.5 added \u2014 and the naive test would have been meaningless\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gflaw\u001b[12Gin\u001b[15GE035\u001b[20Gwas\u001b[24Gthat\u001b[29Gthe\u001b[33Gspec\u001b[38Gasked\u001b[44Gfor\u001b[48Ga\u001b[50Gcausality\u001b[60Gtest\u001b[65Gbut\u001b[69Gnever\u001b[75Grequired\u001b[84Ganyone\u001b[91Gto\u001b[94G\u001b[1mstore\u001b[100G\u001b[22mpre-boundary\u001b[113Gsamples.\r\u001b[2C\u001b[1BSo the ame\u001b[14Gdment\u001b[20Gis firs\u001b[29Ga storage requirement: ring-downs must begin \u22655 s before the boundary,\u001b[100Gwith \u001b[38;5;153mt = 0\u001b[39m at the\u001b[K\r\u001b[2C\u001b[1Bb\u001b[5Gundary.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BBut\u001b[7Gwriting\u001b[15Git\u001b[18Gforced\u001b[25Ga\u001b[27Gsecond\u001b[34Gproblem\u001b[42Ginto\u001b[47Gthe\u001b[51Gopen.\u001b[57GThe\u001b[61Gobvious\u001b[69Gtest\u001b[74G\u2014\u001b[76G\"is\u001b[80Gthere\u001b[86Gsignal\u001b[93Gbefore\u001b[100Gt=0?\"\u001b[106G\u2014\u001b[108Gis\u001b[111G\u001b[1mvacuous \r\u001b[2C\u001b[1Bhere\u001b[22m, because the d\u001b[23Gtector isn't qui\u001b[40Gt\u001b[42Gbef\u001b[46Gre a\u001b[51Gbou\u001b[55Gdary:\u001b[61Gthe previous\u001b[74Gtone is d\u001b[84Givin\u001b[89G it\u001b[93Gat full amplitude. The\u001b[K\r\u001b[2C\u001b[1Banswer is always yes.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSo\u001b[6Gthe\u001b[10Gclause\u001b[17Gdefines\u001b[25Gthe\u001b[29Gtest\u001b[34Gthat\u001b[39Gdoes\u001b[44Ghave\u001b[49Gcontent:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22mNo\u001b[8Gcoherent\u001b[17Gresponse\u001b[26Gat\u001b[29Gthe\u001b[33G\u001b[1mnew\u001b[37G\u001b[22mdrive\u001b[43Gfrequency\u001b[53G\u001b[38;5;153mf_new\u001b[59G\u001b[39mmay\u001b[63Gexist\u001b[69Gbefore\u001b[76G\u001b[38;5;153mf_new\u001b[82G\u001b[39mis\u001b[85Gswitched\u001b[94Gon.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BAnd\u001b[7Git\u001b[10Gnames\u001b[16Gthree\u001b[22Gadversaries\u001b[34Gthe\u001b[38Gnode\u001b[43Gmust\u001b[48Gaddress,\u001b[57Gnot\u001b[61Gjust\u001b[66Gthe\u001b[70Gratio:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mMeasured boundaries, not assumed ones\u001b[44G\u001b[22m\u2014\u001b[46Ga\u001b[48Gpre-response\u001b[61Gsmaller\u001b[69Gthan\u001b[74Gthe\u001b[78Gboundary\u001b[87Guncertainty\u001b[99Gis\u001b[102Ga\u001b[104Gtiming\u001b[111Gerror,\u001b[118Gnot\r\u001b[2C\u001b[1B  \u001b[6Gacausality. I handed it the r6c measurement: spacing 250.0003 s at \u03c3 37\u001b[78Gms, \u001b[38;5;153msteps.csv\u001b[39m l\u001b[94Gte by 5.986 s, and its own\u001b[K\r\u001b[5C\u001b[1Bfirst-run bound\u001b[22Gri\u001b[25Gs\u001b[27Gearly by 0.434 s.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mSpectral leakage mimics acausality\u001b[22m \u2014 a\u001b[45Gfinite\u001b[52Gwindow\u001b[59Gat\u001b[62G\u001b[38;5;153mf_old\u001b[68G\u001b[39mleaks\u001b[74Ginto\u001b[79G\u001b[38;5;153mf_new\u001b[85G\u001b[39monly\u001b[90G0.1\u001b[94GHz\u001b[97Gaway.\u001b[103GUnquantified,\u001b[117Gthe\r\u001b[2C\u001b[1B  \u001b[6Gratio is uninterpretable. I flagged this as the main\u001b[60Gdversary, \u001b[71Gnd\u001b[75Gt's\u001b[79Gthe most likely re\u001b[98Gson the tes\u001b[110G comes\u001b[117Gback\r\u001b[5C\u001b[1Binconclusive.            \u001b[32G \u001b[34G       \u001b[42G    \u001b[76G\u001b[K\u001b[33;1H\u001b[28;3H\u001b[?25h"]
