C\u001b[1Binconclusive.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mGive the statistic a null\u001b[32G\u001b[22m\u2014\u001b[34Gthe\u001b[38Gsame\u001b[43Gmeasurement\u001b[55Gat\u001b[58Gan\u001b[61Gundriven\u001b[70Gfrequency,\u001b[81Gso\u001b[84Gthe\u001b[88Greader\u001b[95Gknows\u001b[101Gthe\u001b[105Gestimator's\r\u001b[2C\u001b[1B  \u001b[6Gfloor instead of assuming\u001b[32Gzero.\u001b[38GThat\u001b[43Gone is borrowed directly from what the verifier invented unpromp\u001b[108Ged on the\r\u001b[5C\u001b[1Bdamping run.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BBoth\u001b[8Gspec\u001b[13Gcopies\u001b[20Gre-synced\u001b[30Gand\u001b[34Gchecksummed\u001b[46Gbefore\u001b[53Gdispatch\u001b[62G\u2014\u001b[64Gthe\u001b[68Gstanding\u001b[77Grule\u001b[82Gfrom\u001b[87GE045,\u001b[93Gnow\u001b[97Gapplied\u001b[105Gfor\u001b[109Gthe\u001b[113Gfirst\r\u001b[2C\u001b[1Btime.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNothing\u001b[11Ggets\u001b[16Goverwritten:\u001b[29Git\u001b[32Gwrites\u001b[39G\u001b[38;5;153manalysis/causality.csv\u001b[39m,\u001b[63G\u001b[38;5;153mcausality_note.md\u001b[81G\u001b[39mand\u001b[85Ga\u001b[87Gnew\u001b[91G\u001b[38;5;153mringdown_precausal.npz\u001b[39m,\r\u001b[2C\u001b[1Bleav\u001b[11Gits original \u001b[38;5;153mresponses.npz\u001b[39m intact so the E035 record survives.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BOne\u001b[7Ghonest\u001b[14Gasymmetry\u001b[24Gworth\u001b[30Gnoting\u001b[37Gfor\u001b[41Gthe\u001b[45Gre\u001b[76G\u001b[1my construction\u001b[91G\u001b[22m\u2014\u001b[93G\u001b[38;5;153manalysis/\u001b[103G\u001b[39misn't\u001b[109Gin\u001b[112Gits\u001b[33;1H\u001b[28;3H\u001b[?25h"]
