[761.407774, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;77m\u001b[48;5;22m2\u001b[15G\u001b[38;5;186m\"\"\"Exactly the r6c method: unwrap the analytic phase, differentiate, 1 s moving average,\u001b[38;5;231m           \r\u001b[7C\u001b[1B\u001b[38;5;77m3\u001b[11G\u001b[38;5;231m    take the crossing of the midpoint frequency.\u001b[38;5;186m\"\"\"\u001b[38;5;231m       \r\u001b[7C\u001b[1B\u001b[38;5;77m4\u001b[15G\u001b[38;5;231mph = np.unwrap(np.angle(hilbert(sosfiltfilt(sos, seg))))                                           \r\u001b[7C\u001b[1B\u001b[38;5;77m5\u001b[15G\u001b[38;5;231mfi =\u001b[20Gnp.gradient(ph)\u001b[36G* FS / (\u001b[38;5;141m2\u001b[38;5;231m * np.pi)        \r\u001b[7C\u001b[1B\u001b[38;5;77m6\u001b[15G\u001b[38;5;231mn = \u001b[38;5;148mint\u001b[38;5;231m(\u001b[38;5;141m1.0\u001b[38;5;231m * FS)                                                                                  \r\u001b[7C\u001b[1B\u001b[38;5;77m7\u001b[15G\u001b[38;5;231mc = np.cumsum(\u001b[30Gp.r_[\u001b[38;5;141m0\u001b[38;5;231m, fi]); fi = (c[n:]\u001b[56G-\u001b[58Gc[:-n])\u001b[66G/\u001b[68Gn\r\u001b[7C\u001b[1B\u001b[38;5;77m8\u001b[15G\u001b[38;5;231mtt = t[:\u001b[38;5;148mlen\u001b[38;5;231m(fi)] +\u001b[34Gn\u001b[36G/\u001b[38G(\u001b[38;5;141m2\u001b[41G\u001b[38;5;231m*\u001b[43GFS)\r\u001b[7C\u001b[1B\u001b[38;5;77m9\u001b[15G\u001b[38;5;231mmid\u001b[19G= \u001b[38;5;141m0.5\u001b[38;5;231m * (f_old + f_new\u001b[42G \u001b[44G  \u001b[47G \u001b[49G      \u001b[56G \u001b[58G       \u001b[66G \u001b[68G \r\u001b[6C\u001b[1B\u001b[38;5;77m30\u001b[15G\u001b[38;5;231ms = np.where(np.diff(np.sign(fi - mid)))[\u001b[38;5;141m0\u001b[38;5;231m]\r\u001b[6C\u001b[1B\u001b[38;5;77m31\u001b[15G\u001b[38;5;197mif\u001b[38;5;231m \u001b[38;5;197mnot\u001b[38;5;231m \u001b[38;5;148mlen\u001b[38;5;231m(s):    \u001b[34G \u001b[36G      \r\u001b[7C\u001b[1B\u001b[38;5;77m2\u001b[15G\u001b[38;5;231m \u001b[17G \u001b[19G\u001b[38;5;197mreturn\u001b[38;5;231m np.nan                          \r\u001b[7C\u001b[1B\u001b[38;5;77m3\u001b[15G\u001b[38;5;231mj = s[np.argmin(np.\u001b[38;5;148mabs\u001b[38;5;231m(tt[s]\u001b[44G-\u001b[46Gt_guess))]\r\u001b[7C\u001b[1B\u001b[38;5;77m4\u001b[15G\u001b[38;5;197mretu\u001b[20Gn\u001b[38;5;231m tt[j] + (mid\u001b[35G-\u001b[37Gfi[j])\u001b[44G/\u001b[46G(fi[j\u001b[52G+\u001b[54G\u001b[38;5;141m1\u001b[38;5;231m]\u001b[57G-\u001b[59Gfi[j])\u001b[66G/\u001b[68GFS\r\u001b[7C\u001b[1B\u001b[38;5;77m5\u001b[15G\u001b[38;5;231m \u001b[17G \u001b[19G                                                                                               \r\u001b[7C\u001b[1B\u001b[38;5;77m6\u001b[15G\u001b[38;5;231m                                                                                                   \r\u001b[7C\u001b[1B\u001b[38;5;77m7\u001b[11G\u001b[38;5;148mprint\u001b[38;5;231m(\u001b[38;5;186mf\"\u001b[38;5;231m{\u001b[38;5;186m'f_old'\u001b[38;5;231m:>6s}\u001b[38;5;186m \u001b[38;5;231m{\u001b[38;5;186m'f_new'\u001b[38;5;231m:>6s}\u001b[38;5;186m \u001b[38;5;231m{\u001b[38;5;186m'SNR'\u001b[38;5;231m:>6s}\u001b[38;5;186m \u001b[38;5;231m{\u001b[38;5;186m'bias [s]'\u001b[38;5;231m:>10s}\u001b[38;5;186m \u001b[38;5;231m{\u001b[38;5;186m'scatter [s]'\u001b[38;5;231m:>12s}\u001b[38;5;186m\"\u001b[38;5;231m)               \r\u001b[7C\u001b[1B\u001b[38;5;77m8\u001b[11G\u001b[38;5;231mallb\u001b[16G=\u001b[18G[]\r\u001b[7C\u001b[1B\u001b[38;5;77m9\u001b[11G\u001b[38;5;197mfor\u001b[38;5;231m f_old, f_new \u001b[38;5;197min\u001b[38;5;231m ((\u001b[38;5;141m3.4\u001b[38;5;231m, \u001b[38;5;141m3.5\u001b[38;5;231m), (\u001b[38;5;141m4.4\u001b[38;5;231m, \u001b[38;5;141m4.5\u001b[38;5;231m), (\u001b[38;5;141m6.2\u001b[38;5;231m, \u001b[38;5;141m6.3\u001b[38;5;231m), (\u001b[38;5;141m8.1\u001b[38;5;231m, \u001b[38;5;141m8.2\u001b[38;5;231m)):                   \r\u001b[6C\u001b[1B\u001b[38;5;77m40\u001b[11G\u001b[38;5;231m    \u001b[38;5;197mfor\u001b[38;5;231m snr \u001b[38;5;197min\u001b[38;5;231m (\u001b[38;5;141m50.0\u001b[38;5;231m, \u001b[38;5;141m10.0\u001b[38;5;231m):                                                                           \r\u001b[5C\u001b[1B\u001b[49m\u001b[38;5;246m\u2026 20 more lines \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Allowed by auto mode\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[39m Agent \"Causality test on\u001b[28Gstored\u001b[35Gpre-boundary\u001b[48Gsamples\"\u001b[57Gfinished\u001b[38;5;246m \u00b7 11m 2s\r\u001b[2B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39m\u001b[K\u001b[33;1H\u001b[31;3H\u001b[?25h"]
