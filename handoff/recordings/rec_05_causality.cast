[799.810853, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;5;77m\u001b[48;5;22m20\u001b[11G\u001b[38;5;231msos\u001b[15G=\u001b[17Gbutter(\u001b[38;5;141m4\u001b[38;5;231m, [\u001b[38;5;141m2.0\u001b[38;5;231m, \u001b[38;5;141m10.0\u001b[38;5;231m], btype=\u001b[38;5;186m\"band\"\u001b[38;5;231m, fs=FS, output=\u001b[38;5;186m\"sos\"\u001b[38;5;231m)                                        \r\u001b[6C\u001b[1B\u001b[38;5;77m21\u001b[11G\u001b[38;5;231mA =\u001b[15Gnp.load(\u001b[38;5;186m\"analysis/responses.npz\"\u001b[38;5;231m,\u001b[49Gallow_pickle=\u001b[38;5;141mTrue\u001b[38;5;231m)\r\u001b[7C\u001b[1B\u001b[38;5;77m2\u001b[11G\u001b[38;5;231mf =\u001b[15GA[\u001b[38;5;186m\"f_drive_hz\"\u001b[38;5;231m]  \u001b[33G      \u001b[40G             \u001b[54G      \u001b[61G             \r\u001b[7C\u001b[1B\u001b[38;5;77m3\u001b[11G\u001b[38;5;231mrows = [l.split(\u001b[38;5;186m\",\"\u001b[38;5;231m) \u001b[38;5;197mfor\u001b[38;5;231m l \u001b[38;5;197min\u001b[38;5;231m \u001b[38;5;148mopen\u001b[38;5;231m(\u001b[47G\u001b[38;5;186mdata/steps.csv\"\u001b[38;5;231m).read().splitlines()\u001b[84G\u001b[38;5;197mif\u001b[87G\u001b[38;5;231ml\u001b[89G\u001b[38;5;197mand\u001b[93G\u001b[38;5;231ml[\u001b[38;5;141m0\u001b[38;5;231m]\u001b[98G!=\u001b[101G\u001b[38;5;186m\"#\"\u001b[38;5;231m]\r\u001b[7C\u001b[1B\u001b[38;5;77m4\u001b[11G\u001b[38;5;231mh\u001b[15Grows[\u001b[38;5;141m0\u001b[38;5;231m]; ts = np.array([\u001b[38;5;148mfloat\u001b[38;5;231m(r[h.index(\u001b[38;5;186m\"t_start_s_run\"\u001b[38;5;231m)])\u001b[74G\u001b[38;5;197mfor\u001b[78G\u001b[38;5;231mr\u001b[80G\u001b[38;5;197min\u001b[83G\u001b[38;5;231mrows[\u001b[38;5;141m1\u001b[38;5;231m:]])\r\u001b[7C\u001b[1B\u001b[38;5;77m5\u001b[11G\u001b[38;5;231mx = np.load(\u001b[38;5;186m\"data/arrays/excitation/aux/ch1111\u001b[58Gnpy\u001b[62G\u001b[38;5;231m, mm\u001b[67Gp_mode=\u001b[38;5;186m\"r\"\u001b[38;5;231m)     \u001b[84G  \u001b[87G \u001b[89G   \u001b[93G    \u001b[98G  \u001b[101G    \r\u001b[7C\u001b[1B\u001b[38;5;77m6\u001b[11G\u001b[38;5;231m \u001b[13G \u001b[15G                                                                                                   \r\u001b[7C\u001b[1B\u001b[38;5;77m7\u001b[11G\u001b[38;5;231mwidths, mi\u001b[22Gs, onsets = [], [], []                                                                      \r\u001b[7C\u001b[1B\u001b[38;5;77m8\u001b[11G\u001b[38;5;197mfor\u001b[38;5;231m k \u001b[38;5;197min\u001b[38;5;231m \u001b[38;5;148mrange\u001b[38;5;231m(\u001b[38;5;141m1\u001b[38;5;231m, \u001b[38;5;148mlen\u001b[38;5;231m(f), \u001b[38;5;141m7\u001b[38;5;231m):                       \u001b[38;5;242m# every 7th boundary, 10 of them\u001b[38;5;231m                   \r\u001b[7C\u001b[1B\u001b[38;5;77m9\u001b[11G\u001b[38;5;231m    i0 = \u001b[38;5;148mint\u001b[38;5;231m((ts[k] - \u001b[38;5;141m20\u001b[38;5;231m - OFF) * FS); i1 = \u001b[38;5;148mint\u001b[38;5;231m((ts[k] + \u001b[38;5;141m20\u001b[38;5;231m - OFF) * FS)                               \r\u001b[6C\u001b[1B\u001b[38;5;77m30\u001b[11G\u001b[38;5;231m    \u001b[38;5;197mif\u001b[38;5;231m i0 < \u001b[38;5;141m0\u001b[38;5;231m \u001b[38;5;197mor\u001b[38;5;231m i1 > \u001b[38;5;148mlen\u001b[38;5;231m(x\u001b[63G                                \r\u001b[6C\u001b[1B\u001b[38;5;77m31\u001b[15G\u001b[38;5;231m  \u001b[18G \u001b[38;5;197mcontinue\u001b[38;5;231m   \u001b[31G \u001b[33G  \u001b[36G \u001b[38G    \u001b[43G \u001b[45G    \u001b[50G  \u001b[53G \u001b[55G          \u001b[66G \u001b[68G  \u001b[71G \u001b[73G    \u001b[78G \u001b[80G   \r\u001b[7C\u001b[1B\u001b[38;5;77m2\u001b[15G\u001b[38;5;231mseg = np.asarray(x[i0:i1], dtype=np.float64); seg -= seg.mean()                                    \r\u001b[7C\u001b[1B\u001b[38;5;77m3\u001b[15G\u001b[38;5;231mph\u001b[18G= np.unwrap(np.angle(hilbert(sosfiltfilt(sos, seg))))                                           \r\u001b[7C\u001b[1B\u001b[38;5;77m4\u001b[15G\u001b[38;5;231mfi = np.gradient\u001b[32Gph) * FS / (\u001b[38;5;141m2\u001b[38;5;231m * np.pi)                                                            \r\u001b[7C\u001b[1B\u001b[38;5;77m5\u001b[15G\u001b[38;5;231mn = \u001b[38;5;148mint\u001b[38;5;231m(\u001b[38;5;141m0.15\u001b[38;5;231m * FS)                              \u001b[38;5;242m# light 0.15 s smoothing, not 1.0 s\u001b[38;5;231m                \r\u001b[7C\u001b[1B\u001b[38;5;77m6\u001b[15G\u001b[38;5;231mc = np.cumsum(\u001b[30Gp.r_[\u001b[38;5;141m0\u001b[38;5;231m, fi]); fi = (c[n:]\u001b[56G-\u001b[58Gc[:-n])\u001b[66G/\u001b[68Gn\r\u001b[7C\u001b[1B\u001b[38;5;77m7\u001b[15G\u001b[38;5;231mtt = (np.arange(\u001b[38;5;148mlen\u001b[38;5;231m(fi))\u001b[40G+\u001b[42Gi0)\u001b[46G/\u001b[48GFS\u001b[51G+\u001b[53GOFF\u001b[57G+\u001b[59Gn\u001b[61G/\u001b[63G(\u001b[38;5;141m2\u001b[38;5;231m * FS)                           \r\u001b[7C\u001b[1B\u001b[38;5;77m8\u001b[15G\u001b[38;5;231mlo,\u001b[19Ghi = f[k - \u001b[38;5;141m1\u001b[38;5;231m], f[k]     \u001b[44G  \u001b[47G \u001b[49G      \u001b[56G \u001b[58G       \u001b[66G \u001b[68G \r\u001b[7C\u001b[1B\u001b[38;5;77m9\u001b[15G\u001b[38;5;231mm = (tt > ts[k] - \u001b[38;5;141m15\u001b[38;5;231m) & (tt < ts[k]\u001b[53G\u001b[38;5;141m10\u001b[38;5;231m)\u001b[57G \u001b[59G \u001b[61G \u001b[63G  \u001b[66G \u001b[68G   \r\u001b[6C\u001b[1B\u001b[38;5;77m40\u001b[15G\u001b[38;5;231mtt\u001b[19Gf\u001b[24Gtt[m], fi[m]                                                                              \r\u001b[5C\u001b[1B\u001b[49m\u001b[38;5;246m\u2026 25 more lines \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Allowed by auto mode\u001b[39m\u001b[K\r\u001b"]
