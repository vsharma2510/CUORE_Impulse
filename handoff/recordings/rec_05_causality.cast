0\u001b[38;5;231m - OFF) * FS); i1 = \u001b[38;5;148mint\u001b[38;5;231m((ts[k] + \u001b[38;5;141m20\u001b[38;5;231m - OFF) * FS)                               \r\u001b[6C\u001b[1B\u001b[38;5;77m30\u001b[11G\u001b[38;5;231m    \u001b[38;5;197mif\u001b[38;5;231m i0 < \u001b[38;5;141m0\u001b[38;5;231m \u001b[38;5;197mor\u001b[38;5;231m i1 > \u001b[38;5;148mlen\u001b[38;5;231m(x):                                                                          \r\u001b[6C\u001b[1B\u001b[38;5;77m31\u001b[11G\u001b[38;5;231m        \u001b[38;5;197mcontinue\u001b[38;5;231m \u001b[29G       \u001b[37G   \u001b[63G                                \r\u001b[6C\u001b[1B\u001b[38;5;77m32\u001b[15G\u001b[38;5;231mseg = np.asarray(x[i0:i1], dtype=np.float64); seg -= seg.mean()                                    \r\u001b[7C\u001b[1B\u001b[38;5;77m3\u001b[15G\u001b[38;5;231mph = np.unwrap(np.angle(hilbert(sosfiltfilt(sos, seg))))                                           \r\u001b[7C\u001b[1B\u001b[38;5;77m4\u001b[15G\u001b[38;5;231mfi\u001b[18G= np.gradient(ph) * FS / (\u001b[38;5;141m2\u001b[46G\u001b[38;5;231m*\u001b[48Gnp.pi)\r\u001b[7C\u001b[1B\u001b[38;5;77m5\u001b[15G\u001b[38;5;231mn =\u001b[19G\u001b[38;5;148mint\u001b[38;5;231m(\u001b[38;5;141m0.15\u001b[38;5;231m * FS)                              \u001b[38;5;242m# light 0.15 s smoothing, not 1.0 s\u001b[38;5;231m                \r\u001b[7C\u001b[1B\u001b[38;5;77m6\u001b[15G\u001b[38;5;231mc = np.c\u001b[24Gmsum(np.r_[\u001b[38;5;141m0\u001b[38;5;231m, fi]); fi = (c[n:] - c[:-n]) / n                                             \r\u001b[7C\u001b[1B\u001b[38;5;77m7\u001b[15G\u001b[38;5;231mtt\u001b[20G(np.arange(\u001b[38;5;148mlen\u001b[38;5;231m(fi)) + i0)\u001b[46G/\u001b[48GFS + OFF\u001b[57G+\u001b[59Gn\u001b[61G/\u001b[63G(\u001b[38;5;141m2\u001b[66G\u001b[38;5;231m*\u001b[68GFS)\r\u001b[7C\u001b[1B\u001b[38;5;77m8\u001b[15G\u001b[38;5;231mlo,\u001b[19Ghi = f[k - \u001b[38;5;141m1\u001b[38;5;231m],\u001b[34Gf[k]\u001b[63G     