st\u001b[69Gbefore\u001b[76G\u001b[38;5;153mf_new\u001b[82G\u001b[39mis\u001b[85Gswitched\u001b[94Gon.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BAnd\u001b[7Git\u001b[10Gnames\u001b[16Gthree\u001b[22Gadversaries\u001b[34Gthe\u001b[38Gnode\u001b[43Gmust\u001b[48Gaddress,\u001b[57Gnot\u001b[61Gjust\u001b[66Gthe\u001b[70Gratio:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mMeasured boundaries, not assumed ones\u001b[22m \u2014 a pre-response smaller than the\u001b[78Gboundary uncert\u001b[94Ginty is a timing error, not\r\u001b[5C\u001b[1Bacausality. I h\u001b[22Gnd\u001b[25Gd\u001b[27Git the r6c measurement:\u001b[51Gspacing\u001b[59G250.0003\u001b[68Gs\u001b[70Gat\u001b[73G\u03c3\u001b[75G37\u001b[78Gms,\u001b[82G\u001b[38;5;153msteps.csv\u001b[92G\u001b[39mlate\u001b[97Gby\u001b[100G5.986\u001b[106Gs,\u001b[109Gand\u001b[113Gits\u001b[117Gown\r\u001b[2C\u001b[1B  \u001b[6Gfirst-run boundaries early by 0.434 s.\u001b[45G\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mSpectral leakage mimics acausality\u001b[22m \u2014 a finite window\u001b[60Gt \u001b[38;5;153mf_old\u001b[39m le\u001b[71Gks\u001b[75Gnto\u001b[79G\u001b[38;5;153mf_new\u001b[39m only 0.1 Hz \u001b[98Gway. Unquan\u001b[110Gified,\u001b[117Gthe\u001b[K\r\u001b[5C\u001b[1Bratio is uninterpretable.\u001b[32GI\u001b[34Gflagged\u001b[42Gthis\u001b[76G's\u001b[79Gthe\u001b[83Gmost\u001b[88Glikely\u001b[95Greason\u001b[102Gthe\u001b[106Gtest\u001b[111Gcomes\u001b[117Gback\u001b[33;1H\u001b[28;3H\u001b[?25h"]
