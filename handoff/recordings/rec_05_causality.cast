2m\u258e\u001b[5G\u001b[22mNo\u001b[8Gcoherent\u001b[17Gresponse\u001b[26Gat\u001b[29Gthe\u001b[33G\u001b[1mnew\u001b[37G\u001b[22mdrive\u001b[43Gfrequency\u001b[53G\u001b[38;5;153mf_new\u001b[59G\u001b[39mmay\u001b[63Gexist\u001b[69Gbefore\u001b[76G\u001b[38;5;153mf_new\u001b[82G\u001b[39mis\u001b[85Gswitched\u001b[94Gon.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BAnd\u001b[7Git\u001b[10Gnames\u001b[16Gthree\u001b[22Gadversaries\u001b[34Gthe\u001b[38Gnode\u001b[43Gmust\u001b[48Gaddress,\u001b[57Gnot\u001b[61Gjust\u001b[66Gthe\u001b[70Gratio:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mMeasured boundaries, not assumed ones\u001b[44G\u001b[22m\u2014\u001b[46Ga\u001b[48Gpre-response\u001b[61Gsmaller\u001b[69Gthan\u001b[74Gthe\u001b[78Gboundary\u001b[87Guncertainty\u001b[99Gis\u001b[102Ga\u001b[104Gtiming\u001b[111Gerror,\u001b[118Gnot\r\u001b[2C\u001b[1B  \u001b[6Gacausality. I handed it the r6c measurement: spacing 250.0003 s at \u03c3 37\u001b[78Gms, \u001b[38;5;153msteps.csv\u001b[39m l\u001b[94Gte by 5.986 s, and its own\u001b[K\r\u001b[5C\u001b[1Bfirst-run bound\u001b[22Gri\u001b[25Gs\u001b[27Gearly by 0.434 s.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mSpectral leakage mimics acausality\u001b[22m \u2014 a\u001b[45Gfi\u001b[76Gto\u001b[79G\u001b[38;5;153mf_new\u001b[85G\u001b[39monly\u001b[90G0.1\u001b[94GHz\u001b[97Gaway.\u001b[103GUnquantified,\u001b[117Gthe\u001b[33;1H\u001b[28;3H\u001b[?25h"]
