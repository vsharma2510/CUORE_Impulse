[749.348974, "o", "\u001b[?25l\u001b[H\r\u001b[26B\u001b[38;5;174m\u2736\u001b[22G\u001b[38;5;246m7\u001b[39m\u001b[33;1H\u001b[31;3H\u001b[?25h"]
[749.461039, "o", "\u001b[?25l\u001b[H\r\u001b[26B\u001b[38;5;174m*\u001b[39m\u001b[33;1H\u001b[31;3H\u001b[?25h"]
[749.606251, "o", "\u001b[?25l\u001b[H\u001b[3G   \u001b[38;5;77m\u001b[48;5;22m 20 +\u001b[38;5;231m                                                                                                       \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;5;77m\u001b[48;5;22m 21 +\u001b[38;5;81mdef\u001b[38;5;231m \u001b[38;5;148morchestrator_estimator\u001b[38;5;231m(\u001b[38;5;208mseg, t, f_old, f_new, t_guess\u001b[38;5;231m):                                             \r\u001b[5C\u001b[1B\u001b[38;5;77m 22 +\u001b[38;5;231m    \u001b[38;5;186m\"\"\"Exactly the r6c method: unwrap the analytic phase, differentiate, 1 s moving average,\u001b[38;5;231m           \r\u001b[2C\u001b[1B\u001b[39m\u001b[49m   \u001b[38;5;77m\u001b[48;5;22m 23 +\u001b[38;5;231m    take the crossing of the midpoint frequency.\u001b[38;5;186m\"\"\"\u001b[38;5;231m                                                    \u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;77m\u001b[48;5;22m 24 +\u001b[38;5;231m    ph = np.unwrap(np.angle(hilbert(sosfiltfilt(sos, seg))))                                           \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;5;77m\u001b[48;5;22m 25 +\u001b[38;5;231m    fi = np.gradient(ph) * FS / (\u001b[38;5;141m2\u001b[38;5;231m * np.pi)                                                            \u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;77m\u001b[48;5;22m 26 +\u001b[38;5;231m    n = \u001b[38;5;148mint\u001b[38;5;231m(\u001b[38;5;141m1.0\u001b[38;5;231m * FS)                                                                                  \r\u001b[5C\u001b[1B\u001b[38;5;77m 27 +\u001b[38;5;231m    c = np.cumsum(np.r_[\u001b[38;5;141m0\u001b[38;5;231m, fi]); fi = (c[n:] - c[:-n]) / n                                             \r\u001b[2C\u001b[1B\u001b[39m\u001b[49m   \u001b[38;5;77m\u001b[48;5;22m 28 +\u001b[38;5;231m    tt = t[:\u001b[38;5;148mlen\u001b[38;5;231m(fi)] + n / (\u001b[38;5;141m2\u001b[38;5;231m * FS)                                                                    \u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;77m\u001b[48;5;22m 29 +\u001b[38;5;231m    mid = \u001b[38;5;141m0.5\u001b[38;5;231m * (f_old + f_new)                                                                        \r\u001b[5C\u001b[1B\u001b[38;5;77m 30 +\u001b[38;5;231m    s = np.where(np.diff(np.sign(fi - mid)))[\u001b[38;5;141m0\u001b[38;5;231m]                                                        \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;77m\u001b[48;5;22m 31 +\u001b[38;5;231m    \u001b[38;5;197mif\u001b[38;5;231m \u001b[38;5;197mnot\u001b[38;5;231m \u001b[38;5;148mlen\u001b[38;5;231m(s):                                                                                     \r\u001b[5C\u001b[1B\u001b[38;5;77m 32 +\u001b[38;5;231m        \u001b[38;5;197mreturn\u001b[38;5;231m np.nan                                                                                  \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;5;77m\u001b[48;5;22m 33 +\u001b[38;5;231m    j = s[np.argmin(np.\u001b[38;5;148mabs\u001b[38;5;231m(tt[s] - t_guess))]                                                          \r\u001b[5C\u001b[1B\u001b[38;5;77m 34 +\u001b[38;5;231m    \u001b[38;5;197mreturn\u001b[38;5;231m tt[j] + (mid - fi[j]) / (fi[j + \u001b[38;5;141m1\u001b[38;5;231m] - fi[j]) / FS                                            \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;77m\u001b[48;5;22m 35 +\u001b[38;5;231m                                                                                                       \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;77m\u001b[48;5;22m 36 +\u001b[38;5;231m                                                                                                       \r\u001b[5C\u001b[1B\u001b[38;5;77m 37 +\u001b[38;5;148mprint\u001b[38;5;231m(\u001b[38;5;186mf\"\u001b[38;5;231m{\u001b[38;5;186m'f_old'\u001b[38;5;231m:>6s}\u001b[38;5;186m \u001b[38;5;231m{\u001b[38;5;186m'f_new'\u001b[38;5;231m:>6s}\u001b[38;5;186m \u001b[38;5;231m{\u001b[38;5;186m'SNR'\u001b[38;5;231m:>6s}\u001b[38;5;186m \u001b[38;5;231m{\u001b[38;5;186m'bias [s]'\u001b[38;5;231m:>10s}\u001b[38;5;186m \u001b[38;5;231m{\u001b[38;5;186m'scatter [s]'\u001b[38;5;231m:>12s}\u001b[38;5;186m\"\u001b[38;5;231m)               \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;77m\u001b[48;5;22m 38 +\u001b[38;5;231mallb = []                                                                                              \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;5;77m\u001b[48;5;22m 39 +\u001b[38;5;197mfor\u001b[38;5;231m f_old, f_new \u001b[38;5;197min\u001b[38;5;231m ((\u001b[38;5;141m3.4\u001b[38;5;231m, \u001b[38;5;141m3.5\u001b[38;5;231m), (\u001b[38;5;141m4.4\u001b[38;5;231m, \u001b[38;5;141m4.5\u001b[38;5;231m), (\u001b[38;5;141m6.2\u001b[38;5;231m, \u001b[38;5;141m6.3\u001b[38;5;231m), (\u001b[38;5;141m8.1\u001b[38;5;231m, \u001b[38;5;141m8.2\u001b[38;5;231m)):                                  \r\u001b[5C\u001b[1B\u001b[38;5;77m 40 +\u001b[38;5;231m    \u001b[38;5;197mfor\u001b[38;5;231m snr \u001b[38;5;197min\u001b[38;5;231m (\u001b[38;5;141m50.0\u001b["]
[749.606461, "o", "38;5;231m, \u001b[38;5;141m10.0\u001b[38;5;231m):                                                                           \r\u001b[5C\u001b[1B\u001b[49m\u001b[38;5;246m\u2026 20 mor\u001b[16Glines \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Allowed by auto\u001b[22Gm\u001b[24Gde\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[3G\u001b[39mAgent \"Causality test on stored pre-boundary samples\"\u001b[57Gfinished\u001b[38;5;246m \u00b7 11m 2s\u001b[39m\u001b[33;1H\u001b[31;3H\u001b[?25h"]
