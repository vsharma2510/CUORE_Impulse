[356.200117, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mMeasured boundaries, not assumed ones\u001b[22m \u2014 a pre-response smaller than the\u001b[78Gboundary uncert\u001b[94Ginty is a timing error, not\r\u001b[5C\u001b[1Bacausality. I h\u001b[22Gnd\u001b[25Gd\u001b[27Git the r6c measurement:\u001b[51Gspacing\u001b[59G250.0003\u001b[68Gs\u001b[70Gat\u001b[73G\u03c3\u001b[75G37\u001b[78Gms,\u001b[82G\u001b[38;5;153msteps.csv\u001b[92G\u001b[39mlate\u001b[97Gby\u001b[100G5.986\u001b[106Gs,\u001b[109Gand\u001b[113Gits\u001b[117Gown\r\u001b[2C\u001b[1B  \u001b[6Gfirst-run boundaries early by 0.434 s.\u001b[45G\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mSpectral leakage mimics acausality\u001b[22m \u2014 a finite window\u001b[60Gt \u001b[38;5;153mf_old\u001b[39m le\u001b[71Gks\u001b[75Gnto\u001b[79G\u001b[38;5;153mf_new\u001b[39m only 0.1 Hz \u001b[98Gway. Unquan\u001b[110Gified,\u001b[117Gthe\u001b[K\r\u001b[5C\u001b[1Bratio is uninterpretable.\u001b[32GI\u001b[34Gflagged\u001b[42Gthis\u001b[47Gas\u001b[50Gthe\u001b[54Gmain\u001b[59Gadversary,\u001b[70Gand\u001b[74Git's\u001b[79Gthe\u001b[83Gmost\u001b[88Glikely\u001b[95Greason\u001b[102Gthe\u001b[106Gtest\u001b[111Gcomes\u001b[117Gback\r\u001b[2C\u001b[1B  \u001b[6Ginconclusive.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mGive the statistic a null\u001b[32G\u001b[22m\u2014 the\u001b[38Gsame\u001b[43Gmeasurement at an undriven frequency, so the reader knows the es\u001b[108Gimator's\u001b[K\r\u001b[5C\u001b[1Bfloor instead\u001b[20Gof\u001b[23Gassuming\u001b[32Gzero.\u001b[38GThat\u001b[43Gone\u001b[47Gis\u001b[50Gborrowed\u001b[59Gdirectly\u001b[68Gfrom\u001b[73Gwhat\u001b[78Gthe\u001b[82Gverifier\u001b[91Ginvented\u001b[100Gunprompted\u001b[111Gon\u001b[114Gthe\r\u001b[5C\u001b[1Bdamping\u001b[14Grun.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BBoth spec\u001b[13Gcopies\u001b[20Gre-synced\u001b[30Gand\u001b[34Gchecksummed\u001b[46Gbefore\u001b[53Gdispatch\u001b[62G\u2014\u001b[64Gthe\u001b[68Gstanding\u001b[77Grule\u001b[82Gfrom\u001b[87GE045,\u001b[93Gnow\u001b[97Gapplied\u001b[105Gfor\u001b[109Gthe\u001b[113Gfirst\r\u001b[2C\u001b[1Btime.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNoth\u001b[11Ggets overwritten: it writes \u001b[38;5;153manalysis/causality.csv\u001b[39m, \u001b[38;5;153mcausality_note.md\u001b[81G\u001b[39mand\u001b[85Ga\u001b[87Gnew\u001b[91G\u001b[38;5;153mringdown_precausal.npz\u001b[39m,\r\u001b[2C\u001b[1Bleaving\u001b[11Gits\u001b[15Goriginal\u001b[24G\u001b[38;5;153mresponses.npz\u001b[38G\u001b[39mintact\u001b[45Gso\u001b[48Gthe\u001b[52GE035\u001b[57Grecord\u001b[64Gsurvives.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BOne honest asymmetry\u001b[24Gworth noting for the report:\u001b[53Gthe v\u001b[59Grifier is b\u001b[71Gind \u001b[1mby construction\u001b[91G\u001b[22m\u2014 \u001b[38;5;153manalysis/\u001b[39m isn't in its\u001b[K\r\u001b[2C\u001b[1Ballowed directories. The analys\u001b[36Gis\u001b[39Gan in-process subagent with full\u001b[72Gproject acc\u001b[84Gss, so\u001b[91Gits\u001b[95Gseparation f\u001b[108Gom \u001b[38;5;153mverify/\u001b[119G\u001b[39mis\r\u001b[2C\u001b[1Bon it\u001b[9G honour,\u001b[18Gand\u001b[22GI've\u001b[27Gasked\u001b[33Git\u001b[36Gto\u001b[39Gdeclare\u001b[47Ga\u001b[49Gbreach\u001b[56Gif\u001b[59Gone\u001b[63Ghappens.\u001b[72GThat's\u001b[79Gweaker,\u001b[87Gand\u001b[91Gthe\u001b[95Gprocess\u001b[103Greport\u001b[110Galready\r\u001b[2C\u001b[1Bsays\u001b[8Gso.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;153mrec_05_causality\u001b[39m is ro\u001b[26Gling wi\u001b[35G \u001b[37Ghe marker captured. It's\u001b[62G~15:20 UTC, so\u001b[77Gthis run will land close\u001b[102Gto\u001b[105Gor\u001b[108Gjust\u001b[113Gpast\u001b[118Gthe\r\u001b[2C\u001b[1Bmidday\u001b[10GET\u001b[13Gdeadline\u001b[22G\u2014\u001b[24Gflagging\u001b[33Gthat\u001b[38Grather\u001b[45Gthan\u001b[50Gdiscovering\u001b[62Git\u001b[65Glater.\u001b[72GI'll\u001b[77Greport\u001b[84Gwhat\u001b[89Gcomes\u001b[95Gback.\r\u001b[1B\u001b[K\u001b[33;1H\u001b[28;3H\u001b[?25h"]
