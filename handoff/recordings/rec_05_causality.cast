[31.902498, "o", "\u001b[?25l\u001b[H\u001b[9G\u001b[38;5;77m\u001b[48;5;22m5\u001b[12G\u001b[38;5;231mquiet\u001b[18Gbefore\u001b[25Ga\u001b[27Gboundary:\u001b[37Gthe\u001b[41Gprevious\u001b[50Gtone\u001b[55Gis\u001b[58Gdriving\u001b[66Git\u001b[69Gat\u001b[72Gfull\u001b[77Gamplitude.\u001b[88G\"Is\u001b[92Gthere\u001b[98Gsignal\u001b[105Gbefore\r\u001b[8C\u001b[1B\u001b[38;5;77m6\u001b[12G\u001b[38;5;231mt = 0\"\u001b[19Gis th\u001b[25Grefore \u001b[34Gways yes and tests\u001b[54Gothing. The causal statement that has content is\u001b[103Gabout \u001b[110Ghe\r\u001b[8C\u001b[1B\u001b[38;5;77m7\u001b[12G\u001b[38;5;231m**\u001b[15Gncoming**\u001b[25Gtone:      \u001b[37G   \u001b[41G        \u001b[50G    \u001b[55G  \u001b[58G       \u001b[66G  \u001b[69G  \u001b[72G    \u001b[77G          \u001b[88G   \u001b[92G     \u001b[98G      \u001b[105G      \r\u001b[8C\u001b[1B\u001b[38;5;77m8\u001b[12G\u001b[38;5;231m \u001b[14G \u001b[16G  \u001b[19G  \u001b[22G         \u001b[32G      \u001b[39G   \u001b[43G   \u001b[47G     \u001b[53G        \u001b[62G   \u001b[66G      \u001b[73G         \u001b[83G    \u001b[88G   \u001b[92G       \u001b[100G  \u001b[103G     \u001b[109G   \r\u001b[8C\u001b[1B\u001b[38;5;77m9\u001b[12G\u001b[38;5;231m> No coherent response\u001b[35Gat\u001b[38Gthe\u001b[42GNEW\u001b[46Gdrive\u001b[52Gfrequency\u001b[62G`f_new`\u001b[70Gmay\u001b[74Gexist\u001b[80Gbefore\u001b[87G`f_new`\u001b[95Gis\u001b[98Gswitched\u001b[107Gon.\r\u001b[7C\u001b[1B\u001b[38;5;77m10\r\u001b[7C\u001b[1B11\u001b[12G\u001b[38;5;231mSo measure, pe\u001b[27G bou\u001b[32Gdary and per chann\u001b[51Gl, the amplitud\u001b[67G at `f_new` in a window \u001b[92Gnding\u001b[98Gat \u001b[102Ghe  \u001b[107G   \r\u001b[8C\u001b[1B\u001b[38;5;77m2\u001b[12G\u001b[38;5;231mboundary,\u001b[22Gand\u001b[26Gcompare\u001b[34Git\u001b[37Gagainst\u001b[45Gthe\u001b[49Gsame\u001b[54Gquantity\u001b[63Gmeasured\u001b[72Gafter.\u001b[79GReport\u001b[86Gthe\u001b[90Gpre/post\u001b[99Gamplitude\r\u001b[8C\u001b[1B\u001b[38;5;77m3\u001b[12G\u001b[38;5;231mratio. **Fail if it exceeds 0.2.**       \u001b[54G   \u001b[58G         \u001b[68G  \u001b[71G       \u001b[79G  \u001b[82G \u001b[84G      \u001b[91G      \u001b[98G  \u001b[101G   \r\u001b[8C\u001b[1B\u001b[38;5;77m4\u001b[12G\u001b[38;5;231m         \u001b[22G   \u001b[26G       \u001b[34G  \u001b[37G       \u001b[45G   \u001b[49G    \u001b[54G        \u001b[63G        \u001b[72G      \u001b[79G      \u001b[86G   \u001b[90G        \u001b[99G         \r\u001b[8C\u001b[1B\u001b[38;5;77m5\u001b[12G\u001b[38;5;231mThree things make \u001b[31Ghis a real test\u001b[47Grather\u001b[54Gthan\u001b[59Ga\u001b[61Gformality,\u001b[72Gand\u001b[76Gyou\u001b[80Gmust\u001b[85Gaddress\u001b[93Geach:\r\u001b[8C\u001b[1B\u001b[38;5;77m6\r\u001b[8C\u001b[1B7\u001b[12G\u001b[38;5;231m1. **Use a measured boundary,\u001b[42Gnot an assumed one.** A response that\u001b[80Gappears to pr\u001b[94Gcede\u001b[99Gthe\u001b[103Gboundary\r\u001b[5C\u001b[1B\u001b[49m\u001b[38;5;246m\u2026 17 more lines \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Allowed by auto mode\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;5;246mRan \u001b[1m2\u001b[22m sh\u001b[12Gll commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;114m\u25cf\u001b[3G\u001b[39m\u001b[1mimpulse-analyst\u001b[22m(Causality\u001b[29Gtest\u001b[34Gon\u001b[37Gstored\u001b[44Gpre-boundary\u001b[57Gsamples)\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mBackgrounded\u001b[19Gagent\u001b[38;5;246m (\u2193 to manage \u00b7 ctrl+o to expand)\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[39m\u001b[K\u001b[33;1H\u001b[28;3H\u001b[?25h"]
