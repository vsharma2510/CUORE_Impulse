[34.690121, "o", "\u001b[?25l\u001b[H\u001b[9G\u001b[38;5;77m\u001b[48;5;22m1\u001b[12G\u001b[38;5;231mSo\u001b[15Gmeasure,\u001b[24Gper\u001b[28Gboundary\u001b[37Gand\u001b[41Gper\u001b[45Gchannel,\u001b[54Gthe\u001b[58Gamplitude\u001b[68Gat\u001b[71G`f_new`\u001b[79Gin\u001b[82Ga\u001b[84Gwindow\u001b[91Gending\u001b[98Gat\u001b[101Gthe\r\u001b[8C\u001b[1B\u001b[38;5;77m2\u001b[12G\u001b[38;5;231mb\u001b[14Gund\u001b[18Gry, and compare it\u001b[38Ggainst\u001b[45Gt\u001b[47Ge same\u001b[54Gquantity measured aft\u001b[76Gr.\u001b[79GReport the pre/post amplitude\r\u001b[8C\u001b[1B\u001b[38;5;77m3\u001b[12G\u001b[38;5;231mratio. **F\u001b[23Gil\u001b[26Gif it \u001b[33Gxceeds 0.2.**  \u001b[49G    \u001b[54G        \u001b[63G        \u001b[72G      \u001b[79G      \u001b[86G   \u001b[90G        \u001b[99G         \r\u001b[8C\u001b[1B\u001b[38;5;77m4\u001b[12G\u001b[38;5;231m      \u001b[19G      \u001b[26G  \u001b[29G  \u001b[32G       \u001b[40G      \r\u001b[8C\u001b[1B\u001b[38;5;77m5\u001b[12G\u001b[38;5;231mThree\u001b[18Gthings\u001b[25Gmake\u001b[30Gthis\u001b[35Ga\u001b[37Greal\u001b[42Gtest\u001b[47Grather\u001b[54Gthan\u001b[59Ga\u001b[61Gformality,\u001b[72Gand\u001b[76Gyou\u001b[80Gmust\u001b[85Gaddress\u001b[93Geach:\r\u001b[8C\u001b[1B\u001b[38;5;77m6\u001b[12G\u001b[38;5;231m     \u001b[18G      \u001b[25G    \u001b[30G    \u001b[35G \u001b[37G    \u001b[42G    \u001b[47G      \u001b[54G    \u001b[59G \u001b[61G          \u001b[72G   \u001b[76G   \u001b[80G    \u001b[85G       \u001b[93G     \r\u001b[8C\u001b[1B\u001b[38;5;77m7\u001b[12G\u001b[38;5;231m1.\u001b[15G**Use\u001b[21Ga\u001b[23Gmeasured\u001b[32Gboundary,\u001b[42Gnot\u001b[46Gan\u001b[49Gassumed\u001b[57Gone.**\u001b[64GA\u001b[66Gresponse\u001b[75Gthat\u001b[80Gappears\u001b[88Gto\u001b[91Gprecede\u001b[99Gthe\u001b[103Gboundary\r\u001b[5C\u001b[1B\u001b[49m\u001b[38;5;246m\u2026 17 more lines \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Allowed by auto\u001b[22Gmode\r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[3G\u001b[39m\u001b[1mimpulse-analyst\u001b[22m(Causality\u001b[29Gtest\u001b[34Gon\u001b[37Gstored\u001b[44Gpre-boundary\u001b[57Gsamples)\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mBackgrounded agent\u001b[38;5;246m (\u2193 to manage \u00b7 ctrl+o to expand)\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mRecording,\u001b[14Gspec\u001b[19Gamended,\u001b[28Ganalyst\u001b[36Gdispatched.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSPEC \u00a74.5 added \u2014 and the naive test would have been meaningless\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gflaw\u001b[12Gin\u001b[15GE035\u001b[20Gwas\u001b[24Gthat\u001b[29Gthe\u001b[33Gspec\u001b[38Gasked\u001b[44Gfor\u001b[48Ga\u001b[50Gcausality\u001b[60Gtest\u001b[65Gbut\u001b[69Gnever\u001b[75Grequired\u001b[84Ganyone\u001b[91Gto\u001b[94G\u001b[1mstore\u001b[100G\u001b[22mpre-boundary\u001b[113Gsamples.\r\u001b[2C\u001b[1BSo the ame\u001b[14Gdment\u001b[20Gis firs\u001b[29Ga storage requirement: ring-downs must begin \u22655 s before the boundary,\u001b[100Gwith \u001b[38;5;153mt = 0\u001b[39m at the\u001b[K\r\u001b[2C\u001b[1Bb\u001b[5Gundary.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BBut\u001b[7Gwriting\u001b[15Git\u001b[18Gforced\u001b[25Ga\u001b[27Gsecond\u001b[34Gproblem\u001b[42Ginto\u001b[47Gthe\u001b[51Gopen.\u001b[57GThe\u001b[61Gobvious\u001b[69Gtest\u001b[74G\u2014\u001b[76G\"is\u001b[80Gthere\u001b[86Gsignal\u001b[93Gbefore\u001b[100Gt=0?\"\u001b[106G\u2014\u001b[108Gis\u001b[111G\u001b[1mvacuous \r\u001b[2C\u001b[1Bhere\u001b[22m, because the d\u001b[23Gtector isn't qui\u001b[40Gt\u001b[42Gbef\u001b[46Gre a\u001b[51Gbou\u001b[55Gdary:\u001b[61Gthe previous\u001b[74Gtone is d\u001b[84Givin\u001b[89G it\u001b[93Gat full amplitude. The\u001b[K\u001b[33;1H\u001b[28;3H\u001b[?25h"]
[34.824358, "o", "\u001b[?25l\u001b[H\u001b[9G\u001b[38;5;77m\u001b[48;5;22m3\u001b[12G\u001b[38;5;231mratio. **Fail if it exceeds 0.2.**       \u001b[54G   \u001b[58G         \u001b[68G  \u001b[71G       \u001b[79G  \u001b[82G \u001b[84G      \u001b[91G      \u001b[98G  \u001b[101G   \r\u001b[8C\u001b[1B\u001b[38;5;77m4\u001b[12G\u001b[38;5;231m         \u001b[22G   \u001b[26G       \u001b[34G  \u001b[37G       \u001b[45G   \u001b[49G    \u001b[54G        \u001b[63G        \u001b[72G      \u001b[79G      \u001b[86G   \u001b[90G        \u001b[99G         \r\u001b[8C\u001b[1B\u001b[38;5;77m5\u001b[12G\u001b[38;5;231mThree things make \u001b[31Ghis a real test\u001b[47Grather\u001b[54Gthan\u001b[59Ga\u001b[61Gformality,\u001b[72Gand\u001b[76Gyou\u001b[80Gmust\u001b[85Gaddress\u001b[93Geach:\r\u001b[8C\u001b[1B\u001b[38;5;77m6\r\u001b[8C\u001b[1B7\u001b[12G\u001b[38;5;231m1. **Use a measured boundary,\u001b[42Gnot an assumed one.** A response that\u001b[80Gappears to pr\u001b[94Gcede\u001b[99Gthe\u001b[103Gboundary\r\u001b[5C\u001b[1B\u001b[49m\u001b[38;5;246m\u2026 17 more lines \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Allowed by auto mode\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;5;246mRan \u001b[1m2\u001b[22m sh\u001b[12Gll commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;114m\u25cf\u001b[3G\u001b[39m\u001b[1mimpulse-analyst\u001b[22m(Causality\u001b[29Gtest\u001b[34Gon\u001b[37Gstored\u001b[44Gpre-boundary\u001b[57Gsamples)\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mBackgrounded\u001b[19Gagent\u001b[38;5;246m (\u2193 to manage \u00b7 ctrl+o to expand)\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[39m Recording, sp\u001b[17Gc\u001b[20Gm\u001b[23Gded, analyst dispatched.\u001b[K\r\u001b[2B \u001b[3G\u001b[1mSPEC \u00a74.5 added \u2014 and the naive test would have been meaningless\r\u001b[2C\u001b[2B\u001b[22mThe flaw in E035 was that the spec asked for a causality test but\u001b[69Gnever\u001b[75Grequired\u001b[84Ganyone\u001b[91Gto\u001b[94G\u001b[1mstore\u001b[100G\u001b[22mpre-boundary\u001b[113Gsamples.\r\u001b[2C\u001b[1BSo\u001b[6Gthe\u001b[10Gamendment\u001b[20Gis\u001b[23Gfirst\u001b[29Ga\u001b[31Gstorage\u001b[39Grequirement:\u001b[52Gring-downs\u001b[63Gmust\u001b[68Gbegin\u001b[74G\u22655\u001b[77Gs\u001b[79Gbefore\u001b[86Gthe\u001b[90Gboundary,\u001b[100Gwith\u001b[105G\u001b[38;5;153mt = 0\u001b[111G\u001b[39mat\u001b[114Gthe\r\u001b[2C\u001b[1Bboundary.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BBut writing\u001b[15Git\u001b[18Gforced\u001b[25Ga\u001b[27Gsecond\u001b[34Gproblem\u001b[42Ginto\u001b[47Gthe\u001b[51Gopen.\u001b[57GThe\u001b[61Gobvious\u001b[69Gtest\u001b[74G\u2014\u001b[76G\"is\u001b[80Gthere\u001b[86Gsignal\u001b[93Gbefore\u001b[100Gt=0?\"\u001b[106G\u2014\u001b[108Gis\u001b[111G\u001b[1mvacuous \r\u001b[2C\u001b[1Bhere\u001b[22m,\u001b[9Gbecause\u001b[17Gthe\u001b[21Gdetector\u001b[30Gisn't\u001b[36Gquiet\u001b[42Gbefore\u001b[49Ga\u001b[51Gboundary:\u001b[61Gthe\u001b[65Gprevious\u001b[74Gtone\u001b[79Gis\u001b[82Gdriving\u001b[90Git\u001b[93Gat\u001b[96Gfull\u001b[101Gamplitude.\u001b[112GThe\r\u001b[2C\u001b[1Banswe\u001b[9G is always yes.\u001b[25G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\u001b[33;1H\u001b[28;3H\u001b[?25h"]
[34.923741, "o", "\u001b[?25l\u001b[H\r\u001b[102C\u001b[32B\u001b[38;5;246m4s \u00b7 \u2191 22\u001b[39m\u001b[33;1H\u001b[28;3H\u001b[?25h"]
[34.940395, "o", "\u001b[?25l\u001b[H\r\u001b[100C\u001b[32B\u001b[38;5;246m4s \u00b7\u001b[106G\u2193\u001b[108G6.6k\u001b[39m\u001b[33;1H\u001b[28;3H\u001b[?25h"]
[34.957839, "o", "\u001b[?25l\u001b[H\u001b[9G\u001b[38;5;77m\u001b[48;5;22m6\u001b[12G\u001b[38;5;231m      \u001b[19G      \u001b[26G  \u001b[29G  \u001b[32G       \u001b[40G      \r\u001b[8C\u001b[1B\u001b[38;5;77m7\u001b[12G\u001b[38;5;231m1.\u001b[15G**Use\u001b[21Ga\u001b[23Gmeasured\u001b[32Gboundary,\u001b[42Gnot\u001b[46Gan\u001b[49Gassumed\u001b[57Gone.**\u001b[64GA\u001b[66Gresponse\u001b[75Gthat\u001b[80Gappears\u001b[88Gto\u001b[91Gprecede\u001b[99Gthe\u001b[103Gboundary\r\u001b[5C\u001b[1B\u001b[49m\u001b[38;5;246m\u2026 17 more lines \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Allowed by auto mode\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[3G\u001b[39m\u001b[1mimpulse-analyst\u001b[22m(Causality\u001b[29Gtest\u001b[34Gon\u001b[37Gstored\u001b[44Gpre-boundary\u001b[57Gsamples)\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mBackgrounded agent\u001b[38;5;246m (\u2193 to manage \u00b7 ctrl+o to expand)\r\u001b[2B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mRecording, spec amended, analyst dispatched.\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSPEC \u00a74.5 added \u2014 and the naive test would have been meaningless\r\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gflaw\u001b[12Gin\u001b[15GE035\u001b[20Gwas\u001b[24Gthat\u001b[29Gthe\u001b[33Gspec\u001b[38Gasked\u001b[44Gfor\u001b[48Ga\u001b[50Gcausality\u001b[60Gtest\u001b[65Gbut\u001b[69Gnever\u001b[75Grequired\u001b[84Ganyone\u001b[91Gto\u001b[94G\u001b[1mstore\u001b[100G\u001b[22mpre-boundary\u001b[113Gsamples.\r\u001b[2C\u001b[1BSo the amendment is first a storage requirement: ring-downs must\u001b[68Gbegin\u001b[74G\u22655\u001b[77Gs\u001b[79Gbefore\u001b[86Gthe\u001b[90Gboundary,\u001b[100Gwith\u001b[105G\u001b[38;5;153mt = 0\u001b[111G\u001b[39mat\u001b[114Gthe\r\u001b[2C\u001b[1Bboundary.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BBut writing it forced a second problem into the ope\u001b[55G. The obvious test\u001b[74G\u2014 \"is the\u001b[86Gsignal before\u001b[100Gt=0?\" \u2014 is\u001b[111G\u001b[1mvacuous \r\u001b[2C\u001b[1Bhere\u001b[22m, because\u001b[17Gthe\u001b[21Gdetector\u001b[30Gisn't\u001b[36Gquiet\u001b[42Gbefore\u001b[49Ga\u001b[51Gboundary:\u001b[61Gthe\u001b[65Gprevious\u001b[74Gtone\u001b[79Gis\u001b[82Gdriving\u001b[90Git\u001b[93Gat\u001b[96Gfull\u001b[101Gamplitude.\u001b[112GThe\r\u001b[2C\u001b[1Banswer\u001b[10Gis\u001b[13Galways\u001b[20Gyes.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSo the cl\u001b[17Gdefin\u001b[23Gs the te\u001b[32Gt \u001b[35Ghat does hav\u001b[49Gconte\u001b[55Gt:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22mNo\u001b[8Gcoher\u001b[33;1H\u001b[28;3H\u001b[?25h"]
[35.091249, "o", "\u001b[?25l\u001b[H\r\u001b[12C\u001b[24Bent\u001b[17Gresponse\u001b[26Gat\u001b[29Gthe\u001b[33G\u001b[1mnew\u001b[37G\u001b[22mdrive\u001b[43Gfrequency\u001b[53G`f_new\u001b[33;1H\u001b[28;3H\u001b[?25h"]
[35.225424, "o", "\u001b[?25l\u001b[H\r\u001b[52C\u001b[24B\u001b[38;5;153mf_new\u001b[39m may\u001b[63Gexist\u001b[69Gbefore\u001b[76G\u001b[38;5;153mf_new\u001b[82G\u001b[39mis\u001b[85Gswitched\u001b[94Gon.\u001b[33;1H\u001b[28;3H\u001b[?25h"]
[35.360096, "o", "\u001b[?25l\u001b[H\u001b[9G\u001b[38;5;77m\u001b[48;5;22m7\u001b[12G\u001b[38;5;231m1.\u001b[15G**Use\u001b[21Ga\u001b[23Gmeasured\u001b[32Gboundary,\u001b[42Gnot\u001b[46Gan\u001b[49Gassumed\u001b[57Gone.**\u001b[64GA\u001b[66Gresponse\u001b[75Gthat\u001b[80Gappears\u001b[88Gto\u001b[91Gprecede\u001b[99Gthe\u001b[103Gboundary\r\u001b[5C\u001b[1B\u001b[49m\u001b[38;5;246m\u2026 17 more lines \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Allowed by auto\u001b[22Gmode\r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[3G\u001b[39m\u001b[1mimpulse-analyst\u001b[22m(Causality\u001b[29Gtest\u001b[34Gon\u001b[37Gstored\u001b[44Gpre-boundary\u001b[57Gsamples)\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mBackgrounded agent\u001b[38;5;246m (\u2193 to manage \u00b7 ctrl+o to expand)\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mRecording,\u001b[14Gspec\u001b[19Gamended,\u001b[28Ganalyst\u001b[36Gdispatched.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSPEC \u00a74.5 added \u2014 and the naive test would have been meaningless\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gflaw\u001b[12Gin\u001b[15GE035\u001b[20Gwas\u001b[24Gthat\u001b[29Gthe\u001b[33Gspec\u001b[38Gasked\u001b[44Gfor\u001b[48Ga\u001b[50Gcausality\u001b[60Gtest\u001b[65Gbut\u001b[69Gnever\u001b[75Grequired\u001b[84Ganyone\u001b[91Gto\u001b[94G\u001b[1mstore\u001b[100G\u001b[22mpre-boundary\u001b[113Gsamples.\r\u001b[2C\u001b[1BSo the ame\u001b[14Gdment\u001b[20Gis firs\u001b[29Ga storage requirement: ring-downs must begin \u22655 s before the boundary,\u001b[100Gwith \u001b[38;5;153mt = 0\u001b[39m at the\u001b[K\r\u001b[2C\u001b[1Bb\u001b[5Gundary.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BBut\u001b[7Gwriting\u001b[15Git\u001b[18Gforced\u001b[25Ga\u001b[27Gsecond\u001b[34Gproblem\u001b[42Ginto\u001b[47Gthe\u001b[51Gopen.\u001b[57GThe\u001b[61Gobvious\u001b[69Gtest\u001b[74G\u2014\u001b[76G\"is\u001b[80Gthere\u001b[86Gsignal\u001b[93Gbefore\u001b[100Gt=0?\"\u001b[106G\u2014\u001b[108Gis\u001b[111G\u001b[1mvacuous \r\u001b[2C\u001b[1Bhere\u001b[22m, because the d\u001b[23Gtector isn't qui\u001b[40Gt\u001b[42Gbef\u001b[46Gre a\u001b[51Gbou\u001b[55Gdary:\u001b[61Gthe previous\u001b[74Gtone is d\u001b[84Givin\u001b[89G it\u001b[93Gat full amplitude. The\u001b[K\r\u001b[2C\u001b[1Banswer is always yes.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSo\u001b[6Gthe\u001b[10Gclause\u001b[17Gdefines\u001b[25Gthe\u001b[29Gtest\u001b[34Gthat\u001b[39Gdoes\u001b[44Ghave\u001b[49Gcontent:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22mNo\u001b[8Gcoherent\u001b[17Gresponse\u001b[26Gat\u001b[29Gthe\u001b[33G\u001b[1mnew\u001b[37G\u001b[22mdrive\u001b[43Gfrequency\u001b[53G\u001b[38;5;153mf_new\u001b[59G\u001b[39mmay\u001b[63Gexist\u001b[69Gbefore\u001b[76G\u001b[38;5;153mf_new\u001b[82G\u001b[39mis\u001b[85Gswitched\u001b[94Gon.\r\u001b[2C\u001b[1B\u001b[K\u001b[33;1H\u001b[28;3H\u001b[?25h"]
[35.629535, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[3G\u001b[39m\u001b[1mimpulse-analyst\u001b[22m(Causality\u001b[29Gtest\u001b[34Gon\u001b[37Gstored\u001b[44Gpre-boundary\u001b[57Gsamples)\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mBackgrounded agent\u001b[38;5;246m (\u2193 to manage \u00b7 ctrl+o to expand)\r\u001b[2B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mRecording, spec amended, analyst dispatched.\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSPEC \u00a74.5 added \u2014 and the naive test would have been meaningless\r\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gflaw\u001b[12Gin\u001b[15GE035\u001b[20Gwas\u001b[24Gthat\u001b[29Gthe\u001b[33Gspec\u001b[38Gasked\u001b[44Gfor\u001b[48Ga\u001b[50Gcausality\u001b[60Gtest\u001b[65Gbut\u001b[69Gnever\u001b[75Grequired\u001b[84Ganyone\u001b[91Gto\u001b[94G\u001b[1mstore\u001b[100G\u001b[22mpre-boundary\u001b[113Gsamples.\r\u001b[2C\u001b[1BSo the amendment is first a storage requirement: ring-downs must\u001b[68Gbegin\u001b[74G\u22655\u001b[77Gs\u001b[79Gbefore\u001b[86Gthe\u001b[90Gboundary,\u001b[100Gwith\u001b[105G\u001b[38;5;153mt = 0\u001b[111G\u001b[39mat\u001b[114Gthe\r\u001b[2C\u001b[1Bboundary.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BBut writing it forced a second problem into the ope\u001b[55G. The obvious test\u001b[74G\u2014 \"is the\u001b[86Gsignal before\u001b[100Gt=0?\" \u2014 is\u001b[111G\u001b[1mvacuous \r\u001b[2C\u001b[1Bhere\u001b[22m, because\u001b[17Gthe\u001b[21Gdetector\u001b[30Gisn't\u001b[36Gquiet\u001b[42Gbefore\u001b[49Ga\u001b[51Gboundary:\u001b[61Gthe\u001b[65Gprevious\u001b[74Gtone\u001b[79Gis\u001b[82Gdriving\u001b[90Git\u001b[93Gat\u001b[96Gfull\u001b[101Gamplitude.\u001b[112GThe\r\u001b[2C\u001b[1Banswer\u001b[10Gis\u001b[13Galways\u001b[20Gyes.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSo the cl\u001b[17Gdefin\u001b[23Gs the te\u001b[32Gt \u001b[35Ghat does hav\u001b[49Gconte\u001b[55Gt:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22mNo\u001b[8Gcoherent\u001b[17Gresponse\u001b[26Gat\u001b[29Gthe\u001b[33G\u001b[1mnew\u001b[37G\u001b[22mdrive\u001b[43Gfrequency\u001b[53G\u001b[38;5;153mf_new\u001b[59G\u001b[39mmay\u001b[63Gexist\u001b[69Gbefore\u001b[76G\u001b[38;5;153mf_new\u001b[82G\u001b[39mis\u001b[85Gswitched\u001b[94Gon.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BAnd\u001b[7Git\u001b[10Gnames\u001b[16Gthree\u001b[22Gadversaries\u001b[34Gthe\u001b[38Gnode\u001b[43Gmust\u001b[48Gaddress,\u001b[57Gnot\u001b[61Gjust\u001b[66Gthe\u001b[70Gratio:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[33;1H\u001b[28;3H\u001b[?25h"]
