at\u001b[29Gthe\u001b[33G\u001b[1mnew\u001b[37G\u001b[22mdrive\u001b[43Gfrequency\u001b[53G\u001b[38;5;153mf_new\u001b[59G\u001b[39mmay\u001b[63Gexist\u001b[69Gbefore\u001b[76G\u001b[38;5;153mf_new\u001b[82G\u001b[39mis\u001b[85Gswitched\u001b[94Gon.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BAnd\u001b[7Git\u001b[10Gnames\u001b[16Gthree\u001b[22Gadversaries\u001b[34Gthe\u001b[38Gnode\u001b[43Gmust\u001b[48Gaddress,\u001b[57Gnot\u001b[61Gjust\u001b[66Gthe\u001b[70Gratio:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mMeasured boundaries, not assumed ones\u001b[22m \u2014 a pre-response smaller than the\u001b[78Gboundary uncert\u001b[94Ginty is a timing error, not\r\u001b[5C\u001b[1Bacausality. I h\u001b[22Gnd\u001b[25Gd\u001b[27Git the r6c measurement:\u001b[51Gspacing\u001b[59G250.0003\u001b[68Gs\u001b[70Gat\u001b[73G\u03c3\u001b[75G37\u001b[78Gms,\u001b[82G\u001b[38;5;153msteps.csv\u001b[92G\u001b[39mlate\u001b[97Gby\u001b[100G5.986\u001b[106Gs,\u001b[109Gand\u001b[113Gits\u001b[117Gown\r\u001b[2C\u001b[1B  \u001b[6Gfirst-run boundaries early by 0.434 s.\u001b[45G\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mSpectral leakage mimics acausality\u001b[22m \u2014 a fi\u001b[76Gto\u001b[79G\u001b[38;5;153mf_new\u001b[39m only 0.1 Hz \u001b[98Gway. Unquan\u001b[110Gified,\u001b[117Gthe\u001b[K\u001b[33;1H\u001b[28;3H\u001b[?25h"]
[357.137967, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[39m \u001b[1mimpulse-analyst\u001b[22m(Causality test on stored pre-boundary samples)\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mBackgrounded\u001b[19Gagent\u001b[38;5;246m (\u2193 to manage \u00b7 ctrl+o to expand)\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mRecording,\u001b[14Gspec\u001b[19Gamended,\u001b[28Ganalyst\u001b[36Gdispatched.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSPEC \u00a74.5 added \u2014 and the naive test would have been meaningless\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BThe flaw i\u001b[14G E035\u001b[20Gwas tha\u001b[29Gthe spec asked for a causality test but never required anyone to \u001b[1mstore\u001b[100G\u001b[22mpre-boundary samples.\r\u001b[2C\u001b[1BS\u001b[5G the amendment\u001b[20Gis\u001b[23Gfirst\u001b[29Ga\u001b[31Gstorage\u001b[39Grequirement:\u001b[52Gring-downs\u001b[63Gmust\u001b[68Gbegin\u001b[74G\u22655\u001b[77Gs\u001b[79Gbefore\u001b[86Gthe\u001b[90Gboundary,\u001b[100Gwith\u001b[105G\u001b[38;5;153mt = 0\u001b[111G\u001b[39mat\u001b[114Gthe\r\u001b[2C\u001b[1Bboundary.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BBut writing it forc\u001b[23Gd a second probl\u001b[40Gm\u001b[42Gint\u001b[46G the\u001b[51Gope\u001b[55G. The\u001b[61Gobvious test\u001b[74G\u2014 \"is the\u001b[84Ge si\u001b[89Gnal\u001b[93Gbefore t=0?\" \u2014 is \u001b[1mvacuous \r\u001b[2C\u001b[1Bhere\u001b[22m, because the detector\u001b[30Gisn't\u001b[36Gquiet\u001b[42Gbefore\u001b[49Ga\u001b[51Gboundary:\u001b[61Gthe\u001b[65Gprevious\u001b[74Gtone\u001b[79Gis\u001b[82Gdriving\u001b[90Git\u001b[93Gat\u001b[96Gfull\u001b[101Gamplitude.\u001b[112GThe\r\u001b[2C\u001b[1Banswer\u001b[10Gis\u001b[13Galways\u001b[20Gyes.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSo\u001b[6Gthe\u001b[10Gclause\u001b[17Gdefines\u001b[25Gthe\u001b[29Gtest\u001b[34Gthat\u001b[39Gdoes\u001b[44Ghave\u001b[49Gcontent:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22mNo\u001b[8Gcoherent\u001b[17Gresponse\u001b[26Gat\u001b[29Gthe\u001b[33G\u001b[1mnew\u001b[37G\u001b[22mdrive\u001b[43Gfrequency\u001b[53G\u001b[38;5;153mf_new\u001b[59G\u001b[39mmay\u001b[63Gexist\u001b[69Gbefore\u001b[76G\u001b[38;5;153mf_new\u001b[82G\u001b[39mis\u001b[85Gswitched\u001b[94Gon.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BAnd\u001b[7Git\u001b[10Gnames\u001b[16Gthree\u001b[22Gadversaries\u001b[34Gthe\u001b[38Gnode\u001b[43Gmust\u001b[48Gaddress,\u001b[57Gnot\u001b[61Gjust\u001b[66Gthe\u001b[70Gratio:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mMeasured boundaries, not assumed ones\u001b[22m \u2014 a pre-response smaller than the\u001b[78Gboundary uncert\u001b[94Ginty is a timing error, not\r\u001b[5C\u001b[1Bacausality. I h\u001b[22Gnd\u001b[25Gd\u001b[27Git the r6c measurement:\u001b[51Gspacing\u001b[59G250.0003\u001b[68Gs\u001b[70Gat\u001b[73G\u03c3\u001b[75G37\u001b[78Gms,\u001b[82G\u001b[38;5;153msteps.csv\u001b[92G\u001b[39mlate\u001b[97Gby\u001b[100G5.986\u001b[106Gs,\u001b[109Gand\u001b[113Gits\u001b[117Gown\r\u001b[2C\u001b[1B  \u001b[6Gfirst-run boundaries early by 0.434 s.\u001b[45G  \u001b[76G\u001b[K\u001b[33;1H\u001b[28;3H\u001b[?25h"]
[357.177777, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[39m \u001b[1mimpulse-analyst\u001b[22m(Causality test on stored pre-boundary samples)\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mBackgrounded\u001b[19Gagent\u001b[38;5;246m (\u2193 to manage \u00b7 ctrl+o to expand)\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mRecording,\u001b[14Gspec\u001b[19Gamended,\u001b[28Ganalyst\u001b[36Gdispatched.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSPEC \u00a74.5 added \u2014 and the naive test would have been meaningless\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BThe flaw i\u001b[14G E035\u001b[20Gwas tha\u001b[29Gthe spec asked for a causality test but never required anyone to \u001b[1mstore\u001b[100G\u001b[22mpre-boundary samples.\r\u001b[2C\u001b[1BS\u001b[5G the amendment\u001b[20Gis\u001b[23Gfirst\u001b[29Ga\u001b[31Gstorage\u001b[39Grequirement:\u001b[52Gring-downs\u001b[63Gmust\u001b[68Gbegin\u001b[74G\u22655\u001b[77Gs\u001b[79Gbefore\u001b[86Gthe\u001b[90Gboundary,\u001b[100Gwith\u001b[105G\u001b[38;5;153mt = 0\u001b[111G\u001b[39mat\u001b[114Gthe\r\u001b[2C\u001b[1Bboundary.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BBut writing it forc\u001b[23Gd a second probl\u001b[40Gm\u001b[42Gint\u001b[46G the\u001b[51Gope\u001b[55G. The\u001b[61Gobvious test\u001b[74G\u2014 \"is the\u001b[84Ge si\u001b[89Gnal\u001b[93Gbefore t=0?\" \u2014 is \u001b[1mvacuous \r\u001b[2C\u001b[1Bhere\u001b[22m, because the detector\u001b[30Gisn't\u001b[36Gquiet\u001b[42Gbefore\u001b[49Ga\u001b[51Gboundary:\u001b[61Gthe\u001b[65Gprevious\u001b[74Gtone\u001b[79Gis\u001b[82Gdriving\u001b[90Git\u001b[93Gat\u001b[96Gfull\u001b[101Gamplitude.\u001b[112GThe\r\u001b[2C\u001b[1Banswer\u001b[10Gis\u001b[13Galways\u001b[20Gyes.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSo\u001b[6Gthe\u001b[10Gclause\u001b[17Gdefines\u001b[25Gthe\u001b[29Gtest\u001b[34Gthat\u001b[39Gdoes\u001b[44Ghave\u001b[49Gcontent:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22mNo\u001b[8Gcoherent\u001b[17Gresponse\u001b[26Gat\u001b[29Gthe\u001b[33G\u001b[1mnew\u001b[37G\u001b[22mdrive\u001b[43Gfrequency\u001b[53G\u001b[38;5;153mf_new\u001b[59G\u001b[39mmay\u001b[63Gexist\u001b[69Gbefore\u001b[76G\u001b[38;5;153mf_new\u001b[82G\u001b[39mis\u001b[85Gswitched\u001b[94Gon.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BAnd\u001b[7Git\u001b[10Gnames\u001b[16Gthree\u001b[22Gadversaries\u001b[34Gthe\u001b[38Gnode\u001b[43Gmust\u001b[48Gaddress,\u001b[57Gnot\u001b[61Gjust\u001b[66Gthe\u001b[70Gratio:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mMeasured boundaries, not assumed ones\u001b[22m \u2014 a pre-response smaller than the\u001b[78Gboundary uncert\u001b[94Ginty is a timing error, not\r\u001b[5C\u001b[1Bacausality. I h\u001b[22Gnd\u001b[25Gd\u001b[27Git the r6c measureme\u001b[76G7\u001b[78Gms,\u001b[82G\u001b[38;5;153msteps.csv\u001b[92G\u001b[39mlate\u001b[97Gby\u001b[100G5.986\u001b[106Gs,\u001b[109Gand\u001b[113Gits\u001b[117Gown\u001b[33;1H\u001b[28;3H\u001b[?25h"]
[357.238834, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[38;5;246mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[39m \u001b[1mimpulse-analyst\u001b[22m(Causality test on stored pre-boundary samples)\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mBackgrounded\u001b[19Gagent\u001b[38;5;246m (\u2193 to manage \u00b7 ctrl+o to expand)\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mRecording,\u001b[14Gspec\u001b[19Gamended,\u001b[28Ganalyst\u001b[36Gdispatched.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSPEC \u00a74.5 added \u2014 and the naive test would have been meaningless\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BThe flaw i\u001b[14G E035\u001b[20Gwas tha\u001b[29Gthe spec asked for a causality test but never required anyone to \u001b[1mstore\u001b[100G\u001b[22mpre-boundary samples.\r\u001b[2C\u001b[1BS\u001b[5G the amendment\u001b[20Gis\u001b[23Gfirst\u001b[29Ga\u001b[31Gstorage\u001b[39Grequirement:\u001b[52Gring-downs\u001b[63Gmust\u001b[68Gbegin\u001b[74G\u22655\u001b[77Gs\u001b[79Gbefore\u001b[86Gthe\u001b[90Gboundary,\u001b[100Gwith\u001b[105G\u001b[38;5;153mt = 0\u001b[111G\u001b[39mat\u001b[114Gthe\r\u001b[2C\u001b[1Bboundary.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BBut writing it forc\u001b[23Gd a second probl\u001b[40Gm\u001b[42Gint\u001b[46G the\u001b[51Gope\u001b[55G. The\u001b[61Gobvious test\u001b[74G\u2014 \"is the\u001b[84Ge si\u001b[89Gnal\u001b[93Gbefore t=0?\" \u2014 is \u001b[1mvacuous \r\u001b[2C\u001b[1Bhere\u001b[22m, because the detector\u001b[30Gisn't\u001b[36Gquiet\u001b[42Gbefore\u001b[49Ga\u001b[51Gboundary:\u001b[61Gthe\u001b[65Gprevious\u001b[74Gtone\u001b[79Gis\u001b[82Gdriving\u001b[90Git\u001b[93Gat\u001b[96Gfull\u001b[101Gamplitude.\u001b[112GThe\r\u001b[2C\u001b[1Banswer\u001b[10Gis\u001b[13Galways\u001b[20Gyes.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSo\u001b[6Gthe\u001b[10Gclause\u001b[17Gdefines\u001b[25Gthe\u001b[29Gtest\u001b[34Gthat\u001b[39Gdoes\u001b[44Ghave\u001b[49Gcontent:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22mNo\u001b[8Gcoherent\u001b[17Gresponse\u001b[26Gat\u001b[29Gthe\u001b[33G\u001b[1mnew\u001b[37G\u001b[22mdrive\u001b[43Gfrequency\u001b[53G\u001b[38;5;153mf_new\u001b[59G\u001b[39mmay\u001b[63Gexist\u001b[69Gbefore\u001b[76G\u001b[38;5;153mf_new\u001b[82G\u001b[39mis\u001b[85Gswitched\u001b[94Gon.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BAnd\u001b[7Git\u001b[10Gnames\u001b[16Gthree\u001b[22Gadversaries\u001b[34Gthe\u001b[38Gnode\u001b[43Gmust\u001b[48Gaddress,\u001b[57Gnot\u001b[61Gjust\u001b[66Gthe\u001b[70Gratio:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mMeasured boundaries, not assumed ones\u001b[22m \u2014 a\u001b[76Ge\u001b[78Gboundary uncert\u001b[94Ginty is a timing error, not\u001b[33;1H\u001b[28;3H\u001b[?25h"]
[357.756505, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[3G\u001b[39m\u001b[1mimpulse-analyst\u001b[22m(Causality\u001b[29Gtest\u001b[34Gon\u001b[37Gstored\u001b[44Gpre-boundary\u001b[57Gsamples)\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mBackgrounded agent\u001b[38;5;246m (\u2193 to manage \u00b7 ctrl+o to expand)\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mRecording,\u001b[14Gspec\u001b[19Gamended,\u001b[28Ganalyst\u001b[36Gdispatched.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSPEC \u00a74.5 added \u2014 and the naive test would have been meaningless\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gflaw\u001b[12Gin\u001b[15GE035\u001b[20Gwas\u001b[24Gthat\u001b[29Gthe\u001b[33Gspec\u001b[38Gasked\u001b[44Gfor\u001b[48Ga\u001b[50Gcausality\u001b[60Gtest\u001b[65Gbut\u001b[69Gnever\u001b[75Grequired\u001b[84Ganyone\u001b[91Gto\u001b[94G\u001b[1mstore\u001b[100G\u001b[22mpre-boundary\u001b[113Gsamples.\r\u001b[2C\u001b[1BSo the ame\u001b[14Gdment\u001b[20Gis firs\u001b[29Ga storage requirement: ring-downs must begin \u22655 s before the boundary,\u001b[100Gwith \u001b[38;5;153mt = 0\u001b[39m at the\u001b[K\r\u001b[2C\u001b[1Bb\u001b[5Gundary.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BBut\u001b[7Gwriting\u001b[15Git\u001b[18Gforced\u001b[25Ga\u001b[27Gsecond\u001b[34Gproblem\u001b[42Ginto\u001b[47Gthe\u001b[51Gopen.\u001b[57GThe\u001b[61Gobvious\u001b[69Gtest\u001b[74G\u2014\u001b[76G\"is\u001b[80Gthere\u001b[86Gsignal\u001b[93Gbefore\u001b[100Gt=0?\"\u001b[106G\u2014\u001b[108Gis\u001b[111G\u001b[1mvacuous \r\u001b[2C\u001b[1Bhere\u001b[22m, because the d\u001b[23Gtector isn't qui\u001b[40Gt\u001b[42Gbef\u001b[46Gre a\u001b[51Gbou\u001b[55Gdary:\u001b[61Gthe previous\u001b[74Gtone is d\u001b[84Givin\u001b[89G it\u001b[93Gat full amplitude. The\u001b[K\r\u001b[2C\u001b[1Banswer is always yes.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSo\u001b[6Gthe\u001b[10Gclause\u001b[17Gdefines\u001b[25Gthe\u001b[29Gtest\u001b[34Gthat\u001b[39Gdoes\u001b[44Ghave\u001b[49Gcontent:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22mNo\u001b[8Gcoherent\u001b[17Gresponse\u001b[26Gat\u001b[29Gthe\u001b[33G\u001b[1mnew\u001b[37G\u001b[22mdrive\u001b[43Gfrequency\u001b[53G\u001b[38;5;153mf_new\u001b[59G\u001b[39mmay\u001b[63Gexist\u001b[69Gbefore\u001b[76G\u001b[38;5;153mf_new\u001b[82G\u001b[39mis\u001b[85Gswitched\u001b[94Gon.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BAnd\u001b[7Git\u001b[10Gnames\u001b[16Gthree\u001b[22Gadversaries\u001b[34Gthe\u001b[38Gnode\u001b[43Gmust\u001b[48Gaddress,\u001b[57Gnot\u001b[61Gjust\u001b[66Gthe\u001b[70Gratio:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mMeasured boundaries, not assumed ones\u001b[44G\u001b[22m\u2014\u001b[46Ga\u001b[48Gpre-response\u001b[61Gsmaller\u001b[69Gthan\u001b[74Gthe\u001b[78Gboundary\u001b[87Guncertainty\u001b[99Gis\u001b[102Ga\u001b[104Gtiming\u001b[111Gerror,\u001b[118Gnot\r\u001b[2C\u001b[1B  \u001b[6Gacausality. I handed it the r6c measureme\u001b[76G7\u001b[78Gms, \u001b[38;5;153msteps.csv\u001b[39m l\u001b[94Gte by 5.986 s, and its own\u001b[K\u001b[33;1H\u001b[28;3H\u001b[?25h"]
