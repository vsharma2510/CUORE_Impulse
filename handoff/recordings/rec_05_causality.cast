[783.861399, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;5;77m\u001b[48;5;22m18\u001b[15G\u001b[38;5;231m \u001b[17G \u001b[19G                           \u001b[47G \u001b[49G                                                                 \r\u001b[6C\u001b[1B\u001b[38;5;77m19\u001b[11G\u001b[38;5;231mFS,\u001b[15GOFF = \u001b[38;5;141m1000.0\u001b[38;5;231m, \u001b[38;5;141m3990.0\r\u001b[6C\u001b[1B\u001b[38;5;77m20\u001b[11G\u001b[38;5;231msos\u001b[15G=\u001b[17Gbutter(\u001b[38;5;141m4\u001b[38;5;231m, [\u001b[38;5;141m2.0\u001b[38;5;231m,\u001b[33G\u001b[38;5;141m10.0\u001b[38;5;231m],\u001b[40Gbtype=\u001b[38;5;186m\"band\"\u001b[38;5;231m,\u001b[54Gfs=FS,\u001b[61Goutput=\u001b[38;5;186m\"sos\"\u001b[38;5;231m)\r\u001b[6C\u001b[1B\u001b[38;5;77m21\u001b[11G\u001b[38;5;231mA\u001b[13G=\u001b[15Gnp.load(\u001b[38;5;186m\"analysis/responses.npz\"\u001b[38;5;231m, allow_pickle=\u001b[38;5;141mTrue\u001b[38;5;231m)\r\u001b[6C\u001b[1B\u001b[38;5;77m22\u001b[11G\u001b[38;5;231mf\u001b[13G=\u001b[15GA[\u001b[38;5;186m\"f_drive_hz\"\u001b[38;5;231m]    \u001b[35G \u001b[37G      \u001b[44G \u001b[46G     \u001b[52G \u001b[54G  \u001b[57G \u001b[59G      \u001b[66G \u001b[68G  \r\u001b[6C\u001b[1B\u001b[38;5;77m23\u001b[11G\u001b[38;5;231mrows\u001b[16G=\u001b[18G[l.split(\u001b[38;5;186m\",\"\u001b[38;5;231m) \u001b[38;5;197mfor\u001b[38;5;231m l \u001b[38;5;197min\u001b[38;5;231m \u001b[38;5;148mopen\u001b[38;5;231m(\u001b[38;5;186m\"data/steps.csv\"\u001b[38;5;231m).read().splitlines() \u001b[38;5;197mif\u001b[38;5;231m l \u001b[38;5;197mand\u001b[38;5;231m l[\u001b[38;5;141m0\u001b[38;5;231m] != \u001b[38;5;186m\"#\"\u001b[38;5;231m]         \r\u001b[6C\u001b[1B\u001b[38;5;77m24\u001b[11G\u001b[38;5;231mh\u001b[13G=\u001b[15Grows[\u001b[38;5;141m0\u001b[38;5;231m]; ts = np.array([\u001b[38;5;148mfloat\u001b[38;5;231m(r[h.index(\u001b[38;5;186m\"t_start_s_run\"\u001b[38;5;231m)]) \u001b[38;5;197mfor\u001b[38;5;231m r \u001b[38;5;197min\u001b[38;5;231m rows[\u001b[38;5;141m1\u001b[38;5;231m:]])                     \r\u001b[6C\u001b[1B\u001b[38;5;77m25\u001b[11G\u001b[38;5;231mx = np.load(\u001b[38;5;186m\"data/arrays/excitation/aux/ch1111.npy\"\u001b[38;5;231m, mmap_mode=\u001b[38;5;186m\"r\"\u001b[38;5;231m)                     \r\u001b[6C\u001b[1B\u001b[38;5;77m26\u001b[11G\u001b[38;5;231m    \u001b[16G \u001b[18G  \r\u001b[6C\u001b[1B\u001b[38;5;77m27\u001b[11G\u001b[38;5;231mwidths, mids, onsets = [], [], []                                                                      \r\u001b[6C\u001b[1B\u001b[38;5;77m28\u001b[11G\u001b[38;5;197mfor\u001b[38;5;231m k \u001b[38;5;197min\u001b[38;5;231m \u001b[38;5;148mrange\u001b[38;5;231m(\u001b[38;5;141m1\u001b[38;5;231m, \u001b[38;5;148mlen\u001b[38;5;231m(f), \u001b[38;5;141m7\u001b[38;5;231m):\u001b[63G\u001b[38;5;242m# every 7th boundary, 10 of them\r\u001b[5C\u001b[1B\u001b[38;5;77m 29 +\u001b[38;5;231m    i0 = \u001b[38;5;148mint\u001b[38;5;231m((ts[k] - \u001b[38;5;141m20\u001b[38;5;231m - OFF) * FS); i1 = \u001b[38;5;148mint\u001b[38;5;231m((ts[k] + \u001b[38;5;141m20\u001b[38;5;231m - OFF) * FS)                               \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;5;77m\u001b[48;5;22m 30 +\u001b[38;5;231m    \u001b[38;5;197mif\u001b[38;5;231m i0 < \u001b[38;5;141m0\u001b[38;5;231m \u001b[38;5;197mor\u001b[38;5;231m i1 > \u001b[38;5;148mlen\u001b[38;5;231m(x):                                                                          \r\u001b[5C\u001b[1B\u001b[38;5;77m 31 +\u001b[38;5;231m        \u001b[38;5;197mcontinue\u001b[38;5;231m                                                                                       \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;77m\u001b[48;5;22m 32 +\u001b[38;5;231m    seg = np.asarray(x[i0:i1], dtype=np.float64); seg -= seg.mean()                                    \r\u001b[5C\u001b[1B\u001b[38;5;77m 33 +\u001b[38;5;231m    ph = np.unwrap(np.angle(hilbert(sosfiltfilt(sos, seg))))                                           \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G  \u001b[6G\u001b[38;5;77m\u001b[48;5;22m 34 +\u001b[38;5;231m    fi = np.gradient(ph) * FS / (\u001b[38;5;141m2\u001b[38;5;231m * np.pi)                                                            \r\u001b[2C\u001b[1B\u001b[39m\u001b[49m   \u001b[38;5;77m\u001b[48;5;22m 35 +\u001b[38;5;231m    n = \u001b[38;5;148mint\u001b[38;5;231m(\u001b[38;5;141m0.15\u001b[38;5;231m * FS)                              \u001b[38;5;242m# light 0.15 s smoothing, not 1.0 s\u001b[38;5;231m                \r\u001b[5C\u001b[1B\u001b[38;5;77m 36 +\u001b[38;5;231m    c = np.cumsum(np.r_[\u001b[38;5;141m0\u001b[38;5;231m, fi]); fi = (c[n:] - c[:-n]) / n                                             \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;77m\u001b[48;5;22m 37 +\u001b[38;5;231m    tt = (np.arange(\u001b[38;5;148mlen\u001b[38;5;231m(fi)) + i0) / FS + OFF + n / (\u001b[38;5;141m2\u001b[38;5;231m * FS)                                           \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;5;77m\u001b[48;5;22m 38 +\u001b[38;5;231m    lo, hi = f[k - \u001b[38;5;141m1\u001b[38;5;231m], f[k]                                                                            \r\u001b[5C\u001b[1B\u001b[38;5;77m 39 +\u001b[38;5;231m    m = (tt > ts[k] - \u001b[38;5;141m15\u001b[38;5;231m) & (tt < ts[k] + \u001b[38;5;141m10\u001b[38;5;231m)                                                          \r\u001b[5C\u001b[1B\u001b[38;5;77m 40 +\u001b[38;5;231m    tt, fi = tt[m], fi[m]                                                                              \r\u001b[5C\u001b[1B\u001b[49m\u001b[38;5;246m\u2026 25 m\u001b[13Gr\u001b[15G lin\u001b[20Gs \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Allowed\u001b[14Gby\u001b[17Gauto mode\u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;174m\u00b7\u001b[3G\u001b[38;5;180mTransmogrifying\u2026\u001b[25G\u001b[38;5;246m2\u001b[39m\u001b[33;1H\u001b[31;3H\u001b[?25h"]
[785.017847, "o", "\u001b[?25l\u001b[H\r\u001b[26B\u001b[38;5;174m\u273d\u001b[3GTransmogrifying\u2026\u001b[25G\u001b[38;5;246m3\u001b[39m\u001b[33;1H\u001b[31;3H\u001b[?25h"]
[785.032507, "o", "\u001b[?25l\u001b[H\r\u001b[42C\u001b[26B\u001b[38;5;246m \u00b7 \u001b[38;5;248mthinking\u001b[38;5;246m)\u001b[39m\u001b[33;1H\u001b[31;3H\u001b[?25h"]
