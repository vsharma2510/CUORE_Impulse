[762.447696, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;77m\u001b[48;5;22m5\u001b[15G\u001b[38;5;231mfi = np.gradient(ph) * FS / (\u001b[38;5;141m2\u001b[38;5;231m * np.pi)                                                 \r\u001b[7C\u001b[1B\u001b[38;5;77m6\u001b[15G\u001b[38;5;231mn = \u001b[38;5;148mint\u001b[38;5;231m(\u001b[38;5;141m1.0\u001b[38;5;231m * FS)                              \r\u001b[7C\u001b[1B\u001b[38;5;77m7\u001b[15G\u001b[38;5;231mc = np.c\u001b[24Gmsum(np.r_[\u001b[38;5;141m0\u001b[38;5;231m, fi]); fi = (c[n:] - c[:-n]) / n                                             \r\u001b[7C\u001b[1B\u001b[38;5;77m8\u001b[15G\u001b[38;5;231mtt\u001b[20Gt[:\u001b[38;5;148mlen\u001b[38;5;231m(fi)] + n / (\u001b[38;5;141m2\u001b[38;5;231m * FS) \u001b[48G      \r\u001b[7C\u001b[1B\u001b[38;5;77m9\u001b[15G\u001b[38;5;231mmid\u001b[19G= \u001b[38;5;141m0.5\u001b[38;5;231m *\u001b[27G(f_old\u001b[34G+\u001b[36Gf_new)\r\u001b[6C\u001b[1B\u001b[38;5;77m30\u001b[15G\u001b[38;5;231ms\u001b[22Gwhere(np.diff(np.sign(fi - mid)))[\u001b[38;5;141m0\u001b[38;5;231m]       \u001b[66G \u001b[68G \r\u001b[6C\u001b[1B\u001b[38;5;77m31\u001b[15G\u001b[38;5;197mif\u001b[38;5;231m \u001b[38;5;197mnot\u001b[38;5;231m \u001b[38;5;148mlen\u001b[38;5;231m(s):  \u001b[32G \u001b[34G \u001b[36G \u001b[38G  \u001b[41G \u001b[43G   \r\u001b[6C\u001b[1B\u001b[38;5;77m32\u001b[15G\u001b[38;5;231m   \u001b[19G\u001b[38;5;197mreturn\u001b[38;5;231m np.nan \u001b[34G \u001b[36G      \r\u001b[7C\u001b[1B\u001b[38;5;77m3\u001b[15G\u001b[38;5;231mj\u001b[19Gs[np.a\u001b[26Ggmin(np.\u001b[38;5;148mabs\u001b[38;5;231m(tt[s] - t_guess))]  \r\u001b[7C\u001b[1B\u001b[38;5;77m4\u001b[15G\u001b[38;5;197mreturn\u001b[22G\u001b[38;5;231mtt[j] +\u001b[30G(mid\u001b[35G-\u001b[37Gfi[j])\u001b[44G/\u001b[46G(fi[j\u001b[52G+\u001b[54G\u001b[38;5;141m1\u001b[38;5;231m]\u001b[57G-\u001b[59Gfi[j])\u001b[66G/\u001b[68GFS\r\u001b[7C\u001b[1B\u001b[38;5;77m5\u001b[19G\u001b[38;5;231m                                                                                               \r\u001b[7C\u001b[1B\u001b[38;5;77m6\u001b[15G\u001b[38;5;231m \u001b[17G \u001b[19G                                                                                               \r\u001b[7C\u001b[1B\u001b[38;5;77m7\u001b[11G\u001b[38;5;148mprint\u001b[38;5;231m(\u001b[38;5;186mf\"\u001b[38;5;231m{\u001b[38;5;186m'f_old'\u001b[38;5;231m:>6s}\u001b[38;5;186m \u001b[38;5;231m{\u001b[38;5;186m'f_new'\u001b[38;5;231m:>6s}\u001b[38;5;186m \u001b[38;5;231m{\u001b[38;5;186m'SNR'\u001b[38;5;231m:>6s}\u001b[38;5;186m \u001b[38;5;231m{\u001b[38;5;186m'bias [s]'\u001b[38;5;231m:>10s}\u001b[38;5;186m \u001b[38;5;231m{\u001b[38;5;186m'scatter [s]'\u001b[38;5;231m:>12s}\u001b[38;5;186m\"\u001b[38;5;231m)\r\u001b[7C\u001b[1B\u001b[38;5;77m8\u001b[11G\u001b[38;5;231mallb\u001b[16G=\u001b[18G[]\r\u001b[7C\u001b[1B\u001b[38;5;77m9\u001b[11G\u001b[38;5;197mfor\u001b[38;5;231m f_old, f_new \u001b[38;5;197min\u001b[38;5;231m ((\u001b[38;5;141m3.4\u001b[38;5;231m, \u001b[38;5;141m3.5\u001b[38;5;231m), (\u001b[38;5;141m4.4\u001b[38;5;231m, \u001b[38;5;141m4.5\u001b[38;5;231m), (\u001b[38;5;141m6.2\u001b[38;5;231m, \u001b[38;5;141m6.3\u001b[38;5;231m), (\u001b[38;5;141m8.1\u001b[38;5;231m, \u001b[38;5;141m8.2\u001b[38;5;231m)):                                  \r\u001b[6C\u001b[1B\u001b[38;5;77m40\u001b[11G\u001b[38;5;231m    \u001b[38;5;197mfor\u001b[38;5;231m snr \u001b[38;5;197min\u001b[38;5;231m (\u001b[38;5;141m50.0\u001b[38;5;231m, \u001b[38;5;141m10.0\u001b[38;5;231m):                                                            \r\u001b[5C\u001b[1B\u001b[49m\u001b[38;5;246m\u2026 20 more lines \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Allowed by auto mode\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[3G\u001b[39mAgent \"Causality test\u001b[25Gon\u001b[28Gstored\u001b[35Gpre-boundary\u001b[48Gsamples\"\u001b[57Gfinished\u001b[38;5;246m \u00b7 11m 2s\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mMy\u001b[6Gestimator\u001b[16Gis\u001b[19Gunbiased\u001b[28Gon\u001b[31Gan\u001b[34Gideal\u001b[40Gstep\u001b[45G(+0.000\u001b[53Gs).\u001b[57GSo\u001b[60Gthe\u001b[64G0.37\u001b[69Gs\u001b[71Gisn't\u001b[77Gestimator\u001b[87Gbias\u001b[92G\u2014\u001b[94Gwhich\u001b[100Gpoints\u001b[107Gat\u001b[110Gthe\r\u001b[1B \u001b[3Gtra\u001b[7Gsition not being a step. Checking its width:\u001b[K\r\u001b[2B\u001b[38;5;246m\u25cf\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell\u001b[19Gcomm\u001b[24Gnd\u2026\u001b[28G\u001b[K\u001b[33;1H\u001b[31;3H\u001b[?25h"]
