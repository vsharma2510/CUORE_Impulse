[808.474177, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;77m\u001b[48;5;22m5\u001b[11G\u001b[38;5;231mx\u001b[15Gnp.load(\u001b[38;5;186m\"data/arrays/excitation/aux/ch1111.npy\"\u001b[38;5;231m, mmap_mode=\u001b[38;5;186m\"r\"\u001b[38;5;231m) \u001b[80G  \u001b[83G          \r\u001b[7C\u001b[1B\u001b[38;5;77m6\u001b[11G\u001b[38;5;231m \u001b[13G \u001b[15G                                                                                                   \r\u001b[7C\u001b[1B\u001b[38;5;77m7\u001b[11G\u001b[38;5;231mwidths,\u001b[19Gmids,\u001b[25Gonsets\u001b[32G=\u001b[34G[],\u001b[38G[],\u001b[42G[]\r\u001b[7C\u001b[1B\u001b[38;5;77m8\u001b[11G\u001b[38;5;197mfor\u001b[38;5;231m k \u001b[38;5;197min\u001b[38;5;231m \u001b[38;5;148mrange\u001b[38;5;231m(\u001b[38;5;141m1\u001b[38;5;231m, \u001b[38;5;148mlen\u001b[38;5;231m(f), \u001b[38;5;141m7\u001b[38;5;231m):                       \u001b[38;5;242m# every 7th boundary, 10 of them\u001b[38;5;231m                   \r\u001b[7C\u001b[1B\u001b[38;5;77m9\u001b[11G\u001b[38;5;231m    i0 = \u001b[38;5;148mint\u001b[38;5;231m((ts[k] - \u001b[38;5;141m20\u001b[38;5;231m - OFF)\u001b[43G*\u001b[45GFS);\u001b[50Gi1\u001b[53G=\u001b[55G\u001b[38;5;148mint\u001b[38;5;231m((ts[k] + \u001b[38;5;141m20\u001b[38;5;231m - OFF) * FS)            \r\u001b[6C\u001b[1B\u001b[38;5;77m30\u001b[15G\u001b[38;5;197mif\u001b[38;5;231m i0 < \u001b[38;5;141m0\u001b[38;5;231m \u001b[38;5;197mor\u001b[38;5;231m i1\u001b[31G>\u001b[33G\u001b[38;5;148mlen\u001b[38;5;231m(x):  \u001b[43G \u001b[45G    \u001b[50G  \u001b[53G \u001b[55G          \u001b[66G \u001b[68G  \u001b[71G \u001b[73G    \u001b[78G \u001b[80G   \r\u001b[7C\u001b[1B\u001b[38;5;77m1\u001b[15G\u001b[38;5;231m    \u001b[38;5;197mcontinue\u001b[28G\u001b[38;5;231m  \u001b[31G \u001b[33G       \r\u001b[7C\u001b[1B\u001b[38;5;77m2\u001b[15G\u001b[38;5;231mseg\u001b[19G= np.asarray(x[i0:i1], dtype=np.float64); seg -= seg.mean()                                    \r\u001b[7C\u001b[1B\u001b[38;5;77m3\u001b[15G\u001b[38;5;231mph = np.unwrap(np.angle(hilbert(sosfi\u001b[53Gtfilt(so\u001b[62G, seg))))       \r\u001b[7C\u001b[1B\u001b[38;5;77m4\u001b[15G\u001b[38;5;231mfi\u001b[23Ggradient(ph) * FS / (\u001b[38;5;141m2\u001b[38;5;231m * np.pi)                                                            \r\u001b[7C\u001b[1B\u001b[38;5;77m5\u001b[15G\u001b[38;5;231mn = \u001b[38;5;148mint\u001b[38;5;231m(\u001b[38;5;141m0.15\u001b[38;5;231m * FS)            \u001b[46G \u001b[48G      \u001b[63G\u001b[38;5;242m# light 0.15 s smoothing, not 1.0 s\r\u001b[7C\u001b[1B\u001b[38;5;77m6\u001b[15G\u001b[38;5;231mc\u001b[19Gnp.cumsum(np.r_[\u001b[38;5;141m0\u001b[38;5;231m,\u001b[38Gfi]);\u001b[44Gfi\u001b[47G=\u001b[49G(c[n:]\u001b[56G-\u001b[58Gc[:-n]) / n                             \r\u001b[7C\u001b[1B\u001b[38;5;77m7\u001b[15G\u001b[38;5;231mtt = (np.arange(\u001b[38;5;148mlen\u001b[38;5;231m(fi)) + i0) / FS + OFF + n / (\u001b[38;5;141m2\u001b[66G\u001b[38;5;231m*\u001b[68GFS)\r\u001b[7C\u001b[1B\u001b[38;5;77m8\u001b[15G\u001b[38;5;231mlo, hi = f[k - \u001b[38;5;141m1\u001b[38;5;231m], f[k] \u001b[40G \u001b[42G   \u001b[46G \u001b[48G  \u001b[51G \u001b[53G   \u001b[57G \u001b[59G \u001b[61G \u001b[63G  \u001b[66G \u001b[68G   \r\u001b[7C\u001b[1B\u001b[38;5;77m9\u001b[15G\u001b[38;5;231mm =\u001b[19G(tt > ts[k] - \u001b[38;5;141m15\u001b[38;5;231m) &\u001b[39G(tt\u001b[43G<\u001b[45Gts[k]\u001b[51G+\u001b[53G\u001b[38;5;141m10\u001b[38;5;231m)\r\u001b[6C\u001b[1B\u001b[38;5;77m40\u001b[15G\u001b[38;5;231mtt,\u001b[19Gfi = t\u001b[26G[m],\u001b[31Gfi[m]                                                                              \r\u001b[5C\u001b[1B\u001b[49m\u001b[38;5;246m\u2026 25 more lines \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Allowed by auto\u001b[22Gmode\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mThe\u001b[7Gramp\u001b[12Ghypothesis\u001b[23Gis\u001b[26Grefuted\u001b[34G\u2014\u001b[36Gbut\u001b[40Git\u001b[43Gexposed\u001b[51Gthat\u001b[56G\u001b[1mmy\u001b[59G\u001b[22mestimator\u001b[69Gwas\u001b[73Gover-smoothed,\u001b[88Gand\u001b[92Gthat\u001b[97Greverses\u001b[106Gan\u001b[109Gearlier\r\u001b[1B \u001b[3Gconclusion.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m \u001b[3G\u001b[39mPrinting\u001b[12Gcausality\u001b[22Gresult\u001b[29Gmarker\r\u001b[1C\u001b[1B\u001b[38;5;246m \u23bf  $ ./tools/rec.sh stop && python3 -I tools/cast_render.py recordings/rec_05_causality.cast --grep \"CAUSALITY: SPEC \r\u001b[1B\u001b[39m     \u001b[38;5;246m4.5\" --grep\u001b[18G\"CAUSALITY: no acausality\" --grep \"E050\" --grep\u001b[66G\"impulse-analyst\" 2>&1 |\u001b[91Gt\u001b[93Gi\u001b[95G -16\u001b[39m\u001b[K\u001b[33;1H\u001b[31;3H\u001b[?25h"]
