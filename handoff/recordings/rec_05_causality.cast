[692.39351, "o", "\u001b[?25l\u001b[H\u001b[3G  \u001b[6Gfirst-run boundaries early by 0.434 s.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mSpectral leakage mimics acausality\u001b[22m \u2014 a fi\u001b[48Gite window\u001b[59Gat \u001b[38;5;153mf_old\u001b[68G\u001b[39mle\u001b[71Gks into \u001b[38;5;153mf_new\u001b[39m only 0.1 Hz\u001b[97Gaway\u001b[102G Unquantified,\u001b[117Gthe\r\u001b[5C\u001b[1Bratio is uninterpr\u001b[25Gtable. I flagged\u001b[42Gthis\u001b[47Gas\u001b[50Gthe\u001b[54Gmain\u001b[59Gadversary,\u001b[70Gand\u001b[74Git's\u001b[79Gthe\u001b[83Gmost\u001b[88Glikely\u001b[95Greason\u001b[102Gthe\u001b[106Gtest\u001b[111Gcomes\u001b[117Gback\r\u001b[2C\u001b[1B  \u001b[6Ginconclusive.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mGive the statistic a null\u001b[32G\u001b[22m\u2014\u001b[34Gthe same measurement \u001b[56Gt an undriven\u001b[70Gfrequency, so the\u001b[88Greader\u001b[95Gknows the estimat\u001b[113Gr'\u001b[117G\u001b[K\r\u001b[5C\u001b[1Bflo\u001b[10Gr in\u001b[15Gtead\u001b[20Gof\u001b[23Gassuming\u001b[32Gzero.\u001b[38GThat\u001b[43Gone\u001b[47Gis\u001b[50Gborrowed\u001b[59Gdirectly\u001b[68Gfrom\u001b[73Gwhat\u001b[78Gthe\u001b[82Gverifier\u001b[91Ginvented\u001b[100Gunprompted\u001b[111Gon\u001b[114Gthe\r\u001b[2C\u001b[1B  \u001b[6Gdamping run.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BBoth s\u001b[10Gec copies\u001b[20Gre-synced\u001b[30Gand\u001b[34Gchecksummed\u001b[46Gbefore\u001b[53Gdispatch\u001b[62G\u2014\u001b[64Gthe\u001b[68Gstanding\u001b[77Grule\u001b[82Gfrom\u001b[87GE045,\u001b[93Gnow\u001b[97Gapplied\u001b[105Gfor\u001b[109Gthe\u001b[113Gfirst\r\u001b[2C\u001b[1Btime.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNothing\u001b[11Ggets\u001b[16Goverwritten:\u001b[29Git\u001b[32Gwrites\u001b[39G\u001b[38;5;153manalysis/causality.csv\u001b[39m,\u001b[63G\u001b[38;5;153mcausality_note.md\u001b[81G\u001b[39mand\u001b[85Ga\u001b[87Gnew\u001b[91G\u001b[38;5;153mringdown_precausal.npz\u001b[39m,\r\u00