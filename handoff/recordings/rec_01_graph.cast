[754.59556, "o", "\u001b[?25l\u001b[H\u001b[3GIt also declared its own gaps\u001b[33Gun\u001b[36Grompted: ERA \u03b6 syst\u001b[56Gmatics undetermined, \u03b6 below\u001b[85G~0.2%\u001b[91Gunresolved,\u001b[103Gthe\u001b[107G8.10/8.17\u001b[117Gpair\r\u001b[2C\u001b[1Band\u001b[7G4.89\u001b[12Gcluster\u001b[20Gpoorly\u001b[27Gseparated,\u001b[38Gmode\u001b[43Gshapes\u001b[50Guninterpreted.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThree more of my errors, caught by the analyst\u001b[50G\u001b[22m\u001b[K\r\u001b[2C\u001b[2B\u001b[1mE028 \u2014 th\u001b[14Gbrief's phy\u001b[26Gics is wrong.\u001b[22m PT lines are\u001b[53Gat\u001b[56G\u001b[1m1.39443 Hz\u001b[22m,\u001b[68Gnot\u001b[72G1.4.\u001b[77GIndependently\u001b[91Gconfirmed\u001b[101Gabove.\u001b[108GThe\u001b[112Gcritic's\r\u001b[2C\u001b[1BPT\u001b[6Gcheck\u001b[12Gmust\u001b[17Guse\u001b[21Gthe\u001b[25Gright\u001b[31Gfundamental\u001b[43Gor\u001b[46Git\u001b[49Gwill\u001b[54Gboth\u001b[59Gmiss\u001b[64Greal\u001b[69Gcoincidences\u001b[82Gand\u001b[86Gmanufacture\u001b[98Gfalse\u001b[104Gones.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mE029 \u2014 my \u001b[38;5;153msteps.csv\u001b[39m boundaries are 6.34 s late\u001b[22m, because\u001b[59GI took 25\u001b[69Gs block edges, so each bo\u001b[95Gndary is\u001b[104Gth\u001b[107G first\u001b[114Gblock\r\u001b[2C\u001b[1Bwhere\u001b[9Gthe\u001b[13Gfrequency\u001b[23Ghad\u001b[27Galready\u001b[35Gchanged.\u001b[44GThe\u001b[48Ganalyst\u001b[56Grecovered\u001b[66Gits\u001b[70Gown\u001b[74Gand\u001b[78Gused\u001b[83Gthose.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mE030 \u2014 SPEC said \"71 channels\"\u001b[22m,\u001b[36Garri\u001b[42G over\u001b[48Gfrom the original\u001b[66Gbrief's\u001b[74G52+19. It's 78\u001b[90GThe\u001b[94Ganalyst\u001b[102Gnamed\u001b[108Gthe\r\u001b[2C\u001b[1Bdiscrepancy\u001b[15Ginstead\u001b[23Gof\u001b[26Gsilently\u001b[35Gfollowing\u001b[45Geither\u001b[52Gnumber.\r\u001b[2C\u001b[1B\u001b[K\r\u