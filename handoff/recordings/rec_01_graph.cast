[432.342379, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;231m\u001b[2m 14 \u001b[22m     \u001b[38;5;148m\"deny\"\u001b[38;5;231m: [\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m1\u001b[11G\u001b[22m      \u001b[38;5;186m\"Read(<HOME>/CUORE_ImpulsePilot/analysis/**)\"\u001b[38;5;231m,\r\u001b[6C\u001b[1B\u001b[2m1\u001b[11G\u001b[22m      \u001b[38;5;186m\"Read(<HOME>/CUORE_ImpulsePilot/critic/**)\"\u001b[38;5;231m,\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m1\u001b[11G\u001b[22m      \u001b[38;5;186m\"Edit(<HOME>/CUORE\u001b[51GImpulsePilot/analysis/**)\"\u001b[38;5;231m,\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m18\u001b[11G\u001b[22m      \u001b[38;5;186m\"Edit(/global/\u001b[32G2/v/<USER>/CUORE_ImpulsePilot/critic/**)\"\u001b[38;5;231m,\r\u001b[1B\u001b[39m     \u001b[38;5;167m\u001b[48;5;52m  8 -\u001b[38;5;231m      \"Bash(grep:*analysis*)\",                                                                         \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;5;167m\u001b[48;5;52m  9 -\u001b[38;5;231m      \"Bash(cat:*analysis*)\",                                                                          \r\u001b[5C\u001b[1B\u001b[38;5;167m 10 -\u001b[38;5;231m      \"Bash(ls:*analysis*)\",                                                                           \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;5;167m\u001b[48;5;52m 11 -\u001b[38;5;231m      \"Bash(head:*analysis*)\",                                                                         \r\u001b[5C\u001b[1B\u001b[38;5;167m 12 -\u001b[38;5;231m      \"Bash(tail:*analysis*)\",                                                                         \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;167m\u001b[48;5;52m 13 -\u001b[38;5;231m      \"Bash(find:*analysis*)\",                                                                         \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;167m\u001b[48;5;52m 14 -\u001b[38;5;231m      \"Bash(cp:*analysis*)\",                                                                           \u001b[49m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 15 -\u001b[38;5;231m      \"Bash(python3:*analysis*)\"                                                                       \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;77m\u001b[48;5;22m 19 +\u001b[38;5;231m      \u001b[38;5;186m\"Bash(grep:*analysis*)\"\u001b[38;5;231m, \u001b[38;5;186m\"Bash(cat:*analysis*)\"\u001b[38;5;231m, \u001b[38;5;186m\"Bash(ls:*analysis*)\"\u001b[38;5;231m,                          \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;5;77m\u001b[48;5;22m 20 +\u001b[38;5;231m      \u001b[38;5;186m\"Bash(head:*analysis*)\"\u001b[38;5;231m, \u001b[38;5;186m\"Bash(tail:*analysis*)\"\u001b[38;5;231m, \u001b[38;5;186m\"Bash(find:*analysis*)\"\u001b[38;5;231m,                       \r\u001b[5C\u001b[1B\u001b[38;5;77m 21 +\u001b[38;5;231m      \u001b[38;5;186m\"Bash(\u001b[48;5;28mcp\u001b[48;5;22m:*analysis*)\"\u001b[38;5;231m,\u001b[48;5;28m \u001b[38;5;186m\"Bash(python3:*analysis*)\"\u001b[38;5;231m\u001b[48;5;22m                                                \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 22 \u001b[22m     ]\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 23 \u001b[22m   }\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 24 \u001b[22m }\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0(ano\u001b[11Gher command ran in this repository at the same time; a change made by either may show under either \r\u001b[5C\u001b[1Bresult)\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Allowed by \u001b[18Guto mode\u001b[39m\u001b[K\u001b[33;1H\u001b[28;3H\u001b[?25h"]
