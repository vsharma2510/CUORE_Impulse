37G6\u001b[39Gwas\u001b[43Gbuilt\u001b[49Gon\u001b[52Ga\u001b[54Gwrong\u001b[60Gnumber.\u001b[68GWithdrawn\u001b[78G\u2014\u001b[80Gyour\u001b[85Gcall\u001b[90Gto\u001b[93Gkeep\u001b[98Git\u001b[101Gand\u001b[105Gdecide\u001b[112Glater\u001b[118Gwas\r\u001b[2C\u001b[1Bbetter found\u001b[16Gd.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BLedger\u001b[10Gis\u001b[13Gat\u001b[16G22\u001b[19Gentries:\u001b[28G9\u001b[30Gtooling,\u001b[39G4\u001b[41Gdata\u001b[46Ghandling,\u001b[56G4\u001b[58Gcode\u001b[63Gbugs,\u001b[69G3\u001b[71Gwrong-method,\u001b[85G2\u001b[87Gunsupported\u001b[99Gclaims.\u001b[107GCaught\u001b[114Gby\u001b[117Gme\u001b[33;1H\u001b[28;3H\u001b[?25h"]
[116.32981, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mI had to correct my own record, and it's E022.\u001b[22m The di\u001b[57Gpatch\u001b[63Gbanner\u001b[70Gprinted\u001b[78Ga\u001b[80Greal\u001b[85G\u001b[38;5;153mdate -u\u001b[93G\u001b[39mof\u001b[96G\u001b[38;5;153m04:18Z\u001b[103G\u001b[39mnext\u001b[108Gto\u001b[111Ga\u001b[113Glog\r\u001b[2C\u001b[1Bentry\u001b[9GI'd\u001b[13Gheaded\u001b[20G\u001b[38;5;153m06:20Z\u001b[39m.\u001b[28G\u001b[1mEvery heading after ~02:40 was overstated, by up to 122 minutes\u001b[92G\u001b[22m\u2014\u001b[94Gafter\u001b[100Gthe\u001b[104Gfirst\u001b[110Gcouple\u001b[117Gof\r\u001b[2C\u001b[1Bentries I wrote plausible-looking times from my s\u001b[53Gnse of progress instead of\u001b[80Gcal\u001b[84Ging \u001b[38;5;153mdate\u001b[39m. Logged as \"fabric\u001b[112Gted or\r\u001b[2C\u001b[1Bu\u001b[5Gsupported claim\", since I asserted numbers I hadn't measured. Nothing edited, per the append-only rule; new\u001b[K\r\u001b[2C\u001b[1Bconvention is \u001b[38;5;153mdate -u\u001b[39m at every wri\u001b[38Ge. Ent\u001b[45Gy orderi\u001b[54Gg and\u001b[60Gthe p\u001b[66Gr-item \u001b[38;5;153mcost_min\u001b[39m estimates are unaffected.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThat correction is good news, and it withdraws my advice.\u001b[22m The t\u001b[67Gue position:\u001b[K\r\u001b[2C\u001b[2B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[K\r\u001b[2C\u001b[1B\u2502\u001b[17G\u2502\u001b[55G\u2502\r\u001b[2C\u001b[1B\u251c\u001b[17G\u253c\u001b[55G\u2524\r\u001b[4C\u001b[1Bnow\u001b[19G\u001b[1m00:18 ET\u001b[22m,\u001b[29Gnot\u001b[33Gthe\u001b[37G~01:50\u001b[44GI\u001b[46Gtold\u001b[51Gyou\r\u001b[4C\u001b[2Bbudget\u001b[12Gused\u001b[19G\u001b[1m2.18 h of 5\u001b[22m  \u001b[33G   \u001b[37G      \u001b[44G \u001b[46G    \u001b[51G   \r\u001b[4C\u001b[2Bto d\u001b[10Gadline\u001b[19G\u001b[1m~1\u001b[22G.7 h\u001b[22m    \r\u001b[2C\u001b[1B\u2514\u001b[17G\u2534\u001b[55G\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSo my recommendation to drop Step 6 was built on a wrong\u001b[60Gnumber.\u001b[68GWithdrawn\u001b[78G\u2014\u001b[80Gyour\u001b[85Gcall\u001b[90Gto\u001b[93Gkeep\u001b[98Git\u001b[101Gand\u001b[105Gdecide\u001b[112Glater\u001b[118Gwas\r\u001b[2C\u001b[1Bbetter\u001b[10Gfounded.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BL\u001b[5Gdg\u001b[10Gis at 22\u001b[19Gentries:\u001b[28G9\u001b[30Gtooling,\u001b[39G4\u001b[41Gdata\u001b[46Ghandling,\u001b[56G4\u001b[58Gcode\u001b[63Gbugs,\u001b[69G3\u001b[71Gwrong-method,\u001b[85G2\u001b[87Gunsupported\u001b[99Gclaims.\u001b[107GCaught\u001b[114Gby\u001b[117Gme\r\u001b[2C\u001b[1B19,\u001b[7Gby\u001b[10Gyou\u001b[14G3.\r\u001b[2C\u001b[1B\u001b[K\u001b[33;1H\u001b[28;3H\u001b[?25h"]
