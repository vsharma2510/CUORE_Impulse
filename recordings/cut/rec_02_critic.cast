[222.151811, "o", "\u001b[?25l\u001b[H\u001b[3Gm\u001b[5Gst for\u001b[12Gthe audit to work: \u001b[1mprint the number behind every verdict\u001b[22m, and \u001b[1mbe willing to fail a check\u001b[22m, since a critic that\r\u001b[2C\u001b[1Bpasses everything manufactures false assurance.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI also\u001b[10Gtold it three things that would trip a careless\u001b[58Gcritic:\u001b[66Guse\u001b[70G1.39443\u001b[78Gnot\u001b[82G1.4;\u001b[87Gdon't\u001b[93Gscore\u001b[99Gthe\u001b[103Gcross-method\r\u001b[2C\u001b[1Bdamping\u001b[11Gcomparison\u001b[22Gas\u001b[25Gagreement,\u001b[36Gbecause\u001b[44Gthe\u001b[48Gverifier's\u001b[59G\u03b6\u001b[61Gcolumn\u001b[68Gis\u001b[71Gpure\u001b[76Gformula;\u001b[85Gand\u001b[89Gcheck\u001b[95G7\u001b[97Gis\u001b[100Gnot-applicable,\u001b[116Gnot\u001b[120Ga\r\u001b[2C\u001b[1Bpass \u001b[9Gr a fa\u001b[16Gl.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BWhile it runs, I'll\u001b[23Gprepare\u001b[31Gthe\u001b[35Gindependent\u001b[47Garithmetic\u001b[58Gcheck\u001b[64Gso\u001b[67GI\u001b[69Gcan\u001b[73Gaudit\u001b[79Git\u001b[82Grather\u001b[89Gthan\u001b[94Gtake\u001b[99Gits\u001b[103Gword\u001b[108G\u2014\u001b[110Gthat\u001b[115Gwas\r\u001b[2C\u001b[1Bthe\u001b[7Gcondition\u001b[17Gfor\u001b[21Gputting\u001b[29Git\u001b[32Gon\u001b[35Gthe\u001b[39Gcheaper\u001b[47Gmodel.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mAudit precomputed and\u001b[25Gsealed\u001b[32G\u2014\u001b[34G59\u001b[37Glines\u001b[43Gcovering\u001b[52Gchecks\u001b[59G2\u20136\u001b[63Gon\u001b[66Gboth\u001b[71Gnodes,\u001b[78Gcomputed\u001b[87Gfrom\u001b[92Gthe\u001b[96Gtwo\u001b[100G\u001b[38;5;153mmodes.csv\u001b[110G\u001b[39mand\r\u001b[2C\u001b[1B\u001b[38;5;153mchannel_gain.csv\u001b[20G\u001b[39mfiles\u001b[26Gbefore\u001b[33GI\u001b[35Gread\u001b[40Ganything\u001b[49Gthe\u001b[53Gcritic\u001b[60Gwrites.\u001b[68GI'll\u001b[73Gcompare\u001b[81Gline\u001b[86Gby\u001b[89Gline\u001b[94Gonce\u001b[99Git\u001b[102Greports,\u001b[111Gwhich\u001b[117Gis\r\u001b[1B \u001b[3Gthe mitigation that ju\u001b[26Gtified moving it\u001b[43Gt\u001b[45G Son\u001b[50Get.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BDeliberately \u001b[17Go\u001b[19G reporting those numbers yet. If I\u001b[54Gpublish\u001b[62Gmy\u001b[65Gown\u001b[69Gfigures\u001b[77Gfirst\u001b[83GI\u001b[85Ganchor\u001b[92Gthe\u001b[96Gcomparison\u001b[107Gand\u001b[111Gthe\u001b[115Gaudit\r\u001b[2C\u001b[1Bstops\u001b[9Gbeing\u001b[15Gindependent\u001b[27Gin\u001b[30Gany\u001b[34Gmeaningful\u001b[45Gsense.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BCritic is run\u001b[17Ging in \u001b[38;5;153mrec_02_critic\u001b[39m. I'll report its\u001b[55Gverdicts\u001b[64Galongside\u001b[74Gmine,\u001b[80Gflagging\u001b[89Gany\u001b[93Gdisagreement\u001b[106Gbetween\u001b[114Gus\u001b[117G\u2014\r\u001b[2C\u001b[1Bincluding\u001b[13Gthe\u001b[17Gcase\u001b[22Gwhere\u001b[28Git's\u001b[33Gright\u001b[39Gand\u001b[43GI'm\u001b[47Gwrong.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m\u273b\u001b[3GWaiting for \u001b[1m1\u001b[22m background agent to finish\u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;246m\u203a Message\u001b[12Grom @physics-critic (c\u001b[35Grl+o to expand)\u001b[39m\u001b[33;1H\u001b[31;3H\u001b[?25h"]
